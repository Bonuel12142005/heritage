<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <title><%= title %></title>
    <%- include('partials/user-dashboard-styles.xian') %>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-logo">
            <h2>
                <img src="/uploads/logo.jpg" alt="HeritageLink">
                HeritageLink
                <span class="badge badge-info">Explorer</span>
            </h2>
        </div>
        <ul class="sidebar-menu">
            <li class="menu-item">
                <a href="/user/dashboard" class="menu-link">
                    <i class="fas fa-th-large"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/destinations" class="menu-link">
                    <i class="fas fa-map-marked-alt"></i>
                    <span>Explore Map & Sites</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/events" class="menu-link">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Events</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/artisans" class="menu-link">
                    <i class="fas fa-palette"></i>
                    <span>Artisans</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/workshops" class="menu-link">
                    <i class="fas fa-chalkboard-teacher"></i>
                    <span>Workshops</span>
                </a>
            </li>
            <div class="menu-section">My Activity</div>
            <li class="menu-item">
                <a href="/user/reviews" class="menu-link">
                    <i class="fas fa-star"></i>
                    <span>My Reviews</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/user/favorites" class="menu-link">
                    <i class="fas fa-heart"></i>
                    <span>Favorites</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/user/workshops" class="menu-link">
                    <i class="fas fa-chalkboard-teacher"></i>
                    <span>My Workshops</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/user/gallery" class="menu-link">
                    <i class="fas fa-images"></i>
                    <span>My Gallery</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/user/messages" class="menu-link">
                    <i class="fas fa-envelope"></i>
                    <span>Messages</span>
                </a>
            </li>
            <div class="menu-section">Account</div>
            <li class="menu-item">
                <a href="/user/profile" class="menu-link active">
                    <i class="fas fa-user-circle"></i>
                    <span>My Profile</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/" class="menu-link">
                    <i class="fas fa-home"></i>
                    <span>Home</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/logout" class="menu-link">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </li>
        </ul>
    </aside>

    <main class="main-content">
        <div class="topbar">
            <div class="topbar-left">
                <h1><i class="fas fa-user-circle"></i> My Profile</h1>
                <p>Update your profile information and photo</p>
            </div>
        </div>

        <div class="dashboard-content" style="max-width: 800px;">
            <% if (success) { %>
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> <%= success %>
                </div>
            <% } %>
            
            <% if (error) { %>
                <div class="alert alert-error">
                    <i class="fas fa-exclamation-circle"></i> <%= error %>
                </div>
            <% } %>

            <div class="card">
                <h2 style="margin-bottom: 2rem; display: flex; align-items: center; gap: 0.75rem;">
                    <i class="fas fa-user-edit"></i> Profile Information
                </h2>

                <form action="/user/profile" method="POST" enctype="multipart/form-data">
                    <!-- Profile Photo -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-camera"></i> Profile Photo
                        </label>
                        <% if (user.profile_photo) { %>
                            <div style="margin-bottom: 1rem;">
                                <img src="/<%= user.profile_photo %>" alt="Profile" 
                                     style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover; border: 4px solid var(--sage-green); box-shadow: 0 4px 12px rgba(45, 134, 89, 0.2);">
                            </div>
                        <% } else { %>
                            <div style="margin-bottom: 1rem;">
                                <div style="width: 150px; height: 150px; border-radius: 50%; background: linear-gradient(135deg, var(--sage-green), var(--mint-green)); display: flex; align-items: center; justify-content: center; color: white; font-size: 4rem; border: 4px solid var(--sage-green);">
                                    <i class="fas fa-user"></i>
                                </div>
                            </div>
                        <% } %>
                        <input type="file" name="profile_photo" class="form-input" accept="image/*">
                        <small style="color: var(--slate-gray); display: block; margin-top: 0.5rem;">
                            <i class="fas fa-info-circle"></i> Max file size: 5MB. Accepted formats: JPG, PNG, GIF, WEBP
                        </small>
                    </div>

                    <!-- Full Name -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-user"></i> Full Name
                        </label>
                        <input type="text" name="name" class="form-input" 
                               value="<%= user.name || '' %>" 
                               placeholder="Your full name" required>
                    </div>

                    <!-- Email -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-envelope"></i> Email
                        </label>
                        <input type="email" name="email" class="form-input" 
                               value="<%= user.email || '' %>" 
                               placeholder="your.email@example.com" required>
                    </div>

                    <!-- Phone -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-phone"></i> Phone Number
                        </label>
                        <input type="tel" name="phone" class="form-input" 
                               value="<%= user.phone || '' %>" 
                               placeholder="+63 XXX XXX XXXX">
                    </div>

                    <!-- Address -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-map-marker-alt"></i> Address
                        </label>
                        <input type="text" name="address" class="form-input" 
                               value="<%= user.address || '' %>" 
                               placeholder="Your address">
                    </div>

                    <!-- Bio -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-info-circle"></i> About Me
                        </label>
                        <textarea name="bio" class="form-textarea" 
                                  placeholder="Tell us about yourself and your interests in cultural heritage..."
                                  style="min-height: 120px;"><%= user.bio || '' %></textarea>
                    </div>

                    <!-- Submit Button -->
                    <div style="display: flex; gap: 1rem;">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Save Profile
                        </button>
                        <a href="/user/dashboard" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>

            <!-- Account Information Card -->
            <div class="card" style="margin-top: 2rem;">
                <h3 style="margin-bottom: 1rem; display: flex; align-items: center; gap: 0.75rem;">
                    <i class="fas fa-shield-alt"></i> Account Information
                </h3>
                <div style="display: grid; gap: 1rem;">
                    <div style="display: flex; justify-content: space-between; padding: 1rem; background: var(--pebble-gray); border-radius: var(--radius-md);">
                        <span style="color: var(--slate-gray); font-weight: 500;">
                            <i class="fas fa-user-tag"></i> Account Type
                        </span>
                        <span class="badge badge-info">
                            <%= user.role ? user.role.charAt(0).toUpperCase() + user.role.slice(1) : 'User' %>
                        </span>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding: 1rem; background: var(--pebble-gray); border-radius: var(--radius-md);">
                        <span style="color: var(--slate-gray); font-weight: 500;">
                            <i class="fas fa-calendar-plus"></i> Member Since
                        </span>
                        <span style="font-weight: 600; color: var(--forest-green);">
                            <%= user.created_at ? new Date(user.created_at).toLocaleDateString() : 'N/A' %>
                        </span>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding: 1rem; background: var(--pebble-gray); border-radius: var(--radius-md);">
                        <span style="color: var(--slate-gray); font-weight: 500;">
                            <i class="fas fa-check-circle"></i> Account Status
                        </span>
                        <span class="badge badge-success">
                            <%= user.status ? user.status.charAt(0).toUpperCase() + user.status.slice(1) : 'Active' %>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
