<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - HeritageLink</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/heritagelink-unified.css">
  <style>
    html,body{overflow-x:clip;max-width:100vw}
    
    /* Hero */
    .page-hero{background:var(--gradient-nature);padding:2.5rem 1.5rem 2rem;text-align:center;position:relative}
    .page-hero::after{content:'';position:absolute;bottom:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#D4AF37,#FFD700,#D4AF37)}
    .page-hero h1{color:#fff;font-size:2rem;font-weight:800;margin:0 0 0.5rem;font-family:'Poppins',sans-serif;display:flex;align-items:center;justify-content:center;gap:0.5rem}
    .page-hero p{color:var(--leaf-green);font-size:1rem;margin:0}
    
    .container{max-width:1400px;margin:0 auto;padding:1.5rem}
    
    /* Filter Bar */
    .filter-bar{background:#fff;border-radius:var(--radius-lg);padding:1rem 1.25rem;box-shadow:var(--shadow-md);margin:-1.5rem auto 1.5rem;max-width:1100px;position:relative;z-index:10;display:flex;gap:0.75rem;flex-wrap:wrap;align-items:flex-end}
    .filter-group{flex:1;min-width:150px}
    .filter-group.search{min-width:220px}
    .filter-group label{display:block;font-size:0.75rem;font-weight:600;color:var(--slate-gray);margin-bottom:0.3rem}
    .filter-input,.filter-select{width:100%;padding:0.65rem 0.85rem;border:2px solid var(--rock-gray);border-radius:var(--radius-md);font-size:0.875rem;transition:var(--transition);background:#fff}
    .filter-input:focus,.filter-select:focus{outline:none;border-color:var(--sage-green)}
    .price-row{display:flex;gap:0.5rem}
    .price-row .filter-input{width:50%}
    .filter-btns{display:flex;gap:0.5rem}
    .btn-filter{padding:0.65rem 1rem;border-radius:var(--radius-md);font-size:0.85rem;font-weight:600;cursor:pointer;border:none;transition:var(--transition);display:inline-flex;align-items:center;gap:0.35rem}
    .btn-search{background:linear-gradient(135deg,#D4AF37,#FFD700);color:#fff}
    .btn-search:hover{transform:translateY(-2px)}
    .btn-clear{background:var(--pebble-gray);color:var(--slate-gray);border:1px solid var(--rock-gray)}
    .btn-clear:hover{background:var(--rock-gray)}
    
    /* Category Pills */
    .category-pills{display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.5rem;justify-content:center}
    .cat-pill{padding:0.5rem 1rem;border-radius:var(--radius-full);background:#fff;border:2px solid var(--rock-gray);color:var(--slate-gray);font-size:0.8rem;font-weight:600;cursor:pointer;transition:var(--transition);text-decoration:none;display:inline-flex;align-items:center;gap:0.35rem}
    .cat-pill:hover,.cat-pill.active{background:var(--sage-green);color:#fff;border-color:var(--sage-green)}
    .cat-pill i{font-size:0.85rem}
    
    /* Results */
    .results-bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:0.5rem}
    .results-count{font-size:0.9rem;color:var(--slate-gray)}
    .results-count strong{color:var(--forest-green)}
    .sort-select{padding:0.5rem 0.75rem;border:1px solid var(--rock-gray);border-radius:var(--radius-md);font-size:0.85rem;background:#fff}
    
    /* Product Grid */
    .product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:1.25rem}
    
    /* Product Card */
    .product-card{background:#fff;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm);border:1px solid var(--rock-gray);transition:var(--transition);text-decoration:none;display:flex;flex-direction:column}
    .product-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg);border-color:var(--sage-green)}
    .product-img{height:200px;background:linear-gradient(135deg,var(--leaf-green),var(--pebble-gray));position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}
    .product-img img{width:100%;height:100%;object-fit:cover;transition:transform 0.4s}
    .product-card:hover .product-img img{transform:scale(1.08)}
    .product-img .placeholder{font-size:3.5rem;color:var(--sage-green);opacity:0.4}
    .product-badge{position:absolute;top:0.75rem;left:0.75rem;background:linear-gradient(135deg,#D4AF37,#FFD700);color:#fff;padding:0.3rem 0.7rem;border-radius:var(--radius-md);font-size:0.7rem;font-weight:700}
    .product-stock{position:absolute;top:0.75rem;right:0.75rem;background:var(--sage-green);color:#fff;padding:0.3rem 0.7rem;border-radius:var(--radius-md);font-size:0.65rem;font-weight:700}
    .product-body{padding:1.25rem;display:flex;flex-direction:column;flex:1}
    .product-cat{font-size:0.7rem;color:var(--textile-orange);font-weight:700;text-transform:uppercase;letter-spacing:0.03em;margin-bottom:0.35rem}
    .product-name{font-size:1.05rem;font-weight:700;color:var(--forest-green);margin-bottom:0.5rem;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .product-desc{color:var(--slate-gray);font-size:0.85rem;line-height:1.5;margin-bottom:0.75rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;flex:1}
    .product-artisan{font-size:0.8rem;color:var(--slate-gray);margin-bottom:0.75rem;display:flex;align-items:center;gap:0.4rem}
    .product-artisan i{color:var(--sage-green)}
    .product-footer{display:flex;justify-content:space-between;align-items:center;padding-top:0.75rem;border-top:1px solid var(--rock-gray)}
    .product-price{font-size:1.25rem;font-weight:800;color:var(--sage-green)}
    .product-rating{font-size:0.85rem;color:#f59e0b;display:flex;align-items:center;gap:0.25rem}
    
    /* Empty State */
    .empty-state{text-align:center;padding:4rem 2rem;background:#fff;border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);grid-column:1/-1}
    .empty-state i{font-size:4rem;color:var(--rock-gray);margin-bottom:1rem}
    .empty-state h3{color:var(--forest-green);margin:0 0 0.5rem}
    .empty-state p{color:var(--slate-gray);margin:0}
    
    /* Responsive */
    @media(max-width:900px){
      .page-hero{padding:2rem 1rem 1.5rem}
      .page-hero h1{font-size:1.65rem}
      .filter-bar{margin:-1rem 1rem 1.25rem;flex-direction:column}
      .filter-group,.filter-group.search{width:100%;min-width:auto}
      .filter-btns{width:100%}
      .btn-filter{flex:1;justify-content:center}
      .container{padding:1rem}
    }
    @media(max-width:640px){
      .page-hero h1{font-size:1.4rem}
      .product-grid{grid-template-columns:1fr}
      .product-img{height:220px}
      .category-pills{justify-content:flex-start;overflow-x:auto;flex-wrap:nowrap;padding-bottom:0.5rem;-webkit-overflow-scrolling:touch}
      .cat-pill{flex-shrink:0}
      .results-bar{flex-direction:column;align-items:flex-start}
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="logo">
        <img src="/uploads/logo.jpg" alt="HeritageLink"> HeritageLink
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
        <i class="fas fa-bars"></i>
      </button>
      <div class="nav-overlay" id="navOverlay"></div>
      <div class="nav-links" id="navLinks">
        <button class="nav-close" id="navClose" aria-label="Close menu">
          <i class="fas fa-times"></i>
        </button>
        <a href="/" class="nav-link"><i class="fas fa-home"></i> <span>Home</span></a>
        <a href="/destinations" class="nav-link"><i class="fas fa-map-marked-alt"></i> <span>Explore Map & Sites</span></a>
        <a href="/events" class="nav-link"><i class="fas fa-calendar-alt"></i> <span>Events</span></a>
        <a href="/heritage-gallery" class="nav-link"><i class="fas fa-landmark"></i> <span>Heritage Gallery</span></a>
        
        <a href="/showcase" class="nav-link" style="background:rgba(255,255,255,0.15);color:#fff"><i class="fas fa-palette"></i> <span>Artisans</span></a>
        <a href="/feedback" class="nav-link"><i class="fas fa-comment-dots"></i> <span>Feedback</span></a>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard" class="btn btn-primary">Dashboard</a>
        <% } else { %>
          <a href="/login" class="btn btn-secondary">Login</a>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="page-hero">
    <h1><i class="fas fa-shopping-bag"></i> Handcrafted Products</h1>
    <p>Authentic handmade products from local artisans of Gloria, Oriental Mindoro</p>
  </section>

  <div class="container">
    <!-- Filter Bar -->
    <form class="filter-bar" method="GET">
      <div class="filter-group search">
        <label>Search</label>
        <input type="text" name="search" class="filter-input" placeholder="Search products..." value="<%= filters.search || '' %>">
      </div>
      <div class="filter-group">
        <label>Category</label>
        <select name="category" class="filter-select">
          <option value="">All Categories</option>
          <% if (categories && categories.length) { categories.forEach(c => { %>
            <option value="<%= c.id %>" <%= filters.category == c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }); } %>
        </select>
      </div>
      <div class="filter-group">
        <label>Price Range</label>
        <div class="price-row">
          <input type="number" name="min_price" class="filter-input" placeholder="Min ₱" value="<%= filters.min_price || '' %>">
          <input type="number" name="max_price" class="filter-input" placeholder="Max ₱" value="<%= filters.max_price || '' %>">
        </div>
      </div>
      <div class="filter-btns">
        <button type="submit" class="btn-filter btn-search"><i class="fas fa-search"></i> Filter</button>
        <a href="/showcase/products" class="btn-filter btn-clear"><i class="fas fa-times"></i> Clear</a>
      </div>
    </form>

    <!-- Category Pills -->
    <div class="category-pills">
      <a href="/showcase/products" class="cat-pill <%= !filters.category ? 'active' : '' %>"><i class="fas fa-th"></i> All</a>
      <% if (categories && categories.length) { categories.forEach(c => { %>
        <a href="/showcase/products?category=<%= c.id %>" class="cat-pill <%= filters.category == c.id ? 'active' : '' %>">
          <i class="fas <%= c.icon || 'fa-tag' %>"></i> <%= c.name %>
        </a>
      <% }); } %>
    </div>

    <!-- Results Bar -->
    <div class="results-bar">
      <div class="results-count">
        <strong><%= products ? products.length : 0 %></strong> product<%= products && products.length !== 1 ? 's' : '' %> found
      </div>
      <select class="sort-select" onchange="sortProducts(this.value)">
        <option value="newest">Newest First</option>
        <option value="price_low">Price: Low to High</option>
        <option value="price_high">Price: High to Low</option>
        <option value="popular">Most Popular</option>
      </select>
    </div>

    <!-- Product Grid -->
    <div class="product-grid">
      <% if (products && products.length > 0) { %>
        <% products.forEach(product => { %>
          <a href="/showcase/products/<%= product.id %>" class="product-card">
            <div class="product-img">
              <% const productImg = product.image_url ? '/' + product.image_url : (product.images && product.images[0] ? product.images[0] : null); %>
              <% if (productImg) { %>
                <img src="<%= productImg %>" alt="<%= product.name %>" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
              <% } %>
              <i class="fas fa-box-open placeholder" style="<%= productImg ? 'display:none' : '' %>"></i>
              <% if (product.featured) { %><span class="product-badge"><i class="fas fa-star"></i> Featured</span><% } %>
              <% if (product.stock_status === 'made_to_order') { %><span class="product-stock">Made to Order</span><% } %>
            </div>
            <div class="product-body">
              <div class="product-cat"><%= product.category ? product.category.replace(/_/g, ' ') : 'Handcraft' %></div>
              <h3 class="product-name"><%= product.name %></h3>
              <p class="product-desc"><%= product.description || 'Handcrafted with care by local artisans.' %></p>
              <div class="product-artisan"><i class="fas fa-user-circle"></i> <%= product.artisan_name || 'Local Artisan' %></div>
              <div class="product-footer">
                <span class="product-price">₱<%= Number(product.price || 0).toLocaleString() %></span>
                <% if (product.rating) { %><span class="product-rating"><i class="fas fa-star"></i> <%= product.rating %></span><% } %>
              </div>
            </div>
          </a>
        <% }); %>
      <% } else { %>
        <div class="empty-state">
          <i class="fas fa-shopping-bag"></i>
          <h3>No Products Found</h3>
          <p>Try adjusting your filters or check back later.</p>
        </div>
      <% } %>
    </div>
  </div>

  <script>
    // Mobile nav
    (function(){
      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navLinks');
      const overlay = document.getElementById('navOverlay');
      const close = document.getElementById('navClose');
      function openMenu() { links.classList.add('active'); overlay.classList.add('active'); document.body.style.overflow = 'hidden'; }
      function closeMenu() { links.classList.remove('active'); overlay.classList.remove('active'); document.body.style.overflow = ''; }
      if(toggle) toggle.addEventListener('click', openMenu);
      if(close) close.addEventListener('click', closeMenu);
      if(overlay) overlay.addEventListener('click', closeMenu);
    })();

    function sortProducts(value) {
      const url = new URL(window.location);
      url.searchParams.set('sort', value);
      window.location = url;
    }
  </script>
</body>
</html>
