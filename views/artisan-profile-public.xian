<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root { --primary: #2d8659; --primary-dark: #1a5f3f; --primary-light: #3fa872; --accent: #ff6b35; --bg-main: #f8faf9; --bg-card: #ffffff; --text-primary: #064e3b; --text-secondary: #6b7280; --border: #d1fae5; }
        body { font-family: 'Inter', sans-serif; background: var(--bg-main); color: var(--text-primary); }
        .navbar { background: var(--primary-dark); padding: 1rem 2rem; }
        .nav-container { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
        .nav-logo { color: white; font-size: 1.5rem; font-weight: 700; text-decoration: none; display: flex; align-items: center; gap: 0.5rem; }
        .nav-logo img { height: 40px; }
        .nav-links a { color: #d1fae5; text-decoration: none; margin-left: 2rem; font-weight: 500; }
        .profile-header { background: linear-gradient(135deg, var(--primary-dark), var(--primary)); padding: 3rem 2rem 6rem; }
        .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
        .profile-card { background: var(--bg-card); border-radius: 1rem; margin-top: -4rem; padding: 2rem; box-shadow: 0 10px 40px rgba(0,0,0,0.1); display: grid; grid-template-columns: 200px 1fr; gap: 2rem; }
        .profile-avatar { width: 180px; height: 180px; border-radius: 1rem; background: linear-gradient(135deg, var(--primary), var(--primary-light)); display: flex; align-items: center; justify-content: center; font-size: 5rem; color: white; overflow: hidden; }
        .profile-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .profile-info h1 { font-size: 2rem; margin-bottom: 0.5rem; }
        .profile-specialty { color: var(--accent); font-weight: 600; font-size: 1.1rem; margin-bottom: 0.5rem; }
        .profile-location { color: var(--text-secondary); margin-bottom: 1rem; }
        .profile-bio { color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem; }
        .profile-stats { display: flex; gap: 2rem; margin-bottom: 1.5rem; }
        .stat { text-align: center; padding: 1rem 1.5rem; background: var(--bg-main); border-radius: 0.75rem; }
        .stat-value { font-size: 1.5rem; font-weight: 700; color: var(--primary); }
        .stat-label { font-size: 0.8rem; color: var(--text-secondary); }
        .profile-actions { display: flex; gap: 1rem; }
        .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; border-radius: 0.75rem; font-weight: 600; text-decoration: none; border: none; cursor: pointer; }
        .btn-primary { background: var(--accent); color: white; }
        .btn-secondary { background: var(--bg-main); color: var(--primary); border: 2px solid var(--primary); }
        .section { margin-top: 3rem; }
        .section-title { font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem; }
        .section-title i { color: var(--primary); }
        .story-card { background: var(--bg-card); border-radius: 1rem; padding: 2rem; border-left: 4px solid var(--accent); }
        .story-card p { color: var(--text-secondary); line-height: 1.8; font-style: italic; font-size: 1.05rem; }
        .awards-list { display: flex; flex-wrap: wrap; gap: 0.75rem; }
        .award-badge { background: linear-gradient(135deg, #fef3c7, #fde68a); color: #92400e; padding: 0.5rem 1rem; border-radius: 2rem; font-size: 0.9rem; font-weight: 600; display: flex; align-items: center; gap: 0.5rem; }
        .contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; }
        .contact-item { background: var(--bg-card); padding: 1rem; border-radius: 0.75rem; display: flex; align-items: center; gap: 1rem; }
        .contact-icon { width: 45px; height: 45px; background: var(--bg-main); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--primary); font-size: 1.1rem; }
        .contact-info .label { font-size: 0.8rem; color: var(--text-secondary); }
        .contact-info .value { font-weight: 600; color: var(--text-primary); }
        .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem; }
        .product-card { background: var(--bg-card); border-radius: 1rem; overflow: hidden; border: 2px solid var(--border); transition: all 0.3s; text-decoration: none; }
        .product-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
        .product-image { height: 180px; background: linear-gradient(135deg, #e0f2fe, #dbeafe); display: flex; align-items: center; justify-content: center; }
        .product-image i { font-size: 3rem; color: var(--primary-light); }
        .product-body { padding: 1.25rem; }
        .product-name { font-size: 1.1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem; }
        .product-price { font-size: 1.25rem; font-weight: 700; color: var(--primary); }
        .empty-products { text-align: center; padding: 3rem; background: var(--bg-card); border-radius: 1rem; color: var(--text-secondary); }
        @media (max-width: 768px) { .profile-card { grid-template-columns: 1fr; text-align: center; } .profile-avatar { margin: 0 auto; } .profile-stats { justify-content: center; } .profile-actions { justify-content: center; } .nav-links { display: none; } }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="nav-logo"><img src="/uploads/logo.jpg" alt=""> HeritageLink</a>
            <div class="nav-links">
                <a href="/showcase">Artisans</a><a href="/showcase/products">Products</a>
                <% if (user) { %><a href="/dashboard">Dashboard</a><% } else { %><a href="/login">Login</a><% } %>
            </div>
        </div>
    </nav>
    <div class="profile-header"></div>
    <div class="container">
        <div class="profile-card">
            <div class="profile-avatar">
                <% if (artisan.profile_photo) { %><img src="/<%= artisan.profile_photo %>" alt=""><% } else { %><%= (artisan.name || 'A').charAt(0).toUpperCase() %><% } %>
            </div>
            <div class="profile-info">
                <h1><%= artisan.name %></h1>
                <div class="profile-specialty"><i class="fas fa-star"></i> <%= artisan.specialty || artisan.specialization || 'Master Craftsman' %></div>
                <div class="profile-location"><i class="fas fa-map-marker-alt"></i> <%= artisan.location || 'Gloria, Oriental Mindoro' %></div>
                <p class="profile-bio"><%= artisan.bio || 'Skilled artisan dedicated to preserving traditional crafts and cultural heritage.' %></p>
                <div class="profile-stats">
                    <div class="stat"><div class="stat-value"><%= artisan.product_count || products.length %></div><div class="stat-label">Products</div></div>
                    <div class="stat"><div class="stat-value"><%= artisan.experience_years || '10+' %></div><div class="stat-label">Years Experience</div></div>
                    <% if (artisan.rating) { %><div class="stat"><div class="stat-value"><i class="fas fa-star" style="color:#f59e0b;"></i> <%= artisan.rating %></div><div class="stat-label">Rating</div></div><% } %>
                </div>
                <div class="profile-actions">
                    <button class="btn btn-primary" onclick="messageArtisan(<%= artisan.id || artisan.user_id %>, '<%= artisan.name %>')"><i class="fas fa-envelope"></i> Send Message</button>
                    <a href="/showcase/products?artisan_id=<%= artisan.id || artisan.user_id %>" class="btn btn-secondary"><i class="fas fa-shopping-bag"></i> View All Products</a>
                </div>
            </div>
        </div>

        <% if (artisan.story) { %>
        <div class="section">
            <h2 class="section-title"><i class="fas fa-book-open"></i> My Story</h2>
            <div class="story-card"><p>"<%= artisan.story %>"</p></div>
        </div>
        <% } %>

        <% if (artisan.awards && artisan.awards.length > 0) { %>
        <div class="section">
            <h2 class="section-title"><i class="fas fa-trophy"></i> Awards & Recognition</h2>
            <div class="awards-list">
                <% artisan.awards.forEach(award => { %><span class="award-badge"><i class="fas fa-medal"></i> <%= award %></span><% }); %>
            </div>
        </div>
        <% } %>

        <div class="section">
            <h2 class="section-title"><i class="fas fa-address-card"></i> Contact Information</h2>
            <div class="contact-grid">
                <% if (artisan.contact_email) { %><div class="contact-item"><div class="contact-icon"><i class="fas fa-envelope"></i></div><div class="contact-info"><div class="label">Email</div><div class="value"><%= artisan.contact_email %></div></div></div><% } %>
                <% if (artisan.contact_phone) { %><div class="contact-item"><div class="contact-icon"><i class="fas fa-phone"></i></div><div class="contact-info"><div class="label">Phone</div><div class="value"><%= artisan.contact_phone %></div></div></div><% } %>
                <% if (artisan.social_facebook) { %><div class="contact-item"><div class="contact-icon"><i class="fab fa-facebook"></i></div><div class="contact-info"><div class="label">Facebook</div><div class="value"><%= artisan.social_facebook %></div></div></div><% } %>
                <% if (artisan.social_instagram) { %><div class="contact-item"><div class="contact-icon"><i class="fab fa-instagram"></i></div><div class="contact-info"><div class="label">Instagram</div><div class="value"><%= artisan.social_instagram %></div></div></div><% } %>
            </div>
        </div>

        <div class="section">
            <h2 class="section-title"><i class="fas fa-box"></i> Products by <%= artisan.name %></h2>
            <% if (products && products.length > 0) { %>
            <div class="product-grid">
                <% products.forEach(product => { %>
                <a href="/showcase/products/<%= product.id %>" class="product-card">
                    <div class="product-image"><i class="fas fa-box"></i></div>
                    <div class="product-body">
                        <h3 class="product-name"><%= product.name %></h3>
                        <div class="product-price">₱<%= Number(product.price || 0).toLocaleString() %></div>
                    </div>
                </a>
                <% }); %>
            </div>
            <% } else { %>
            <div class="empty-products"><i class="fas fa-box" style="font-size: 3rem; margin-bottom: 1rem;"></i><p>No products available yet.</p></div>
            <% } %>
        </div>
    </div>
    <script>
        function messageArtisan(id, name) {
            const overlay = document.createElement('div');
            overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:1000;padding:1rem;';
            overlay.innerHTML = `<div style="background:white;border-radius:1rem;padding:2rem;max-width:500px;width:100%;"><h3 style="margin:0 0 1rem;"><i class="fas fa-envelope"></i> Message ${name}</h3><div id="msgStatus" style="margin-bottom:1rem;padding:0.75rem;border-radius:0.5rem;display:none;"></div><div style="margin-bottom:1rem;"><label style="font-weight:600;display:block;margin-bottom:0.5rem;">Subject</label><input id="msgSubject" type="text" style="width:100%;padding:0.75rem;border:2px solid #d1fae5;border-radius:0.5rem;box-sizing:border-box;"></div><div style="margin-bottom:1.5rem;"><label style="font-weight:600;display:block;margin-bottom:0.5rem;">Message</label><textarea id="msgText" rows="5" style="width:100%;padding:0.75rem;border:2px solid #d1fae5;border-radius:0.5rem;box-sizing:border-box;resize:vertical;"></textarea></div><div style="display:flex;gap:0.75rem;justify-content:flex-end;"><button onclick="this.closest('div').parentElement.remove()" style="padding:0.75rem 1.5rem;border:none;border-radius:0.5rem;background:#6b7280;color:white;font-weight:600;cursor:pointer;">Cancel</button><button onclick="sendMsg(${id})" style="padding:0.75rem 1.5rem;border:none;border-radius:0.5rem;background:#ff6b35;color:white;font-weight:600;cursor:pointer;"><i class="fas fa-paper-plane"></i> Send</button></div></div>`;
            document.body.appendChild(overlay);
            overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.remove(); });
        }
        async function sendMsg(id) {
            const subject = document.getElementById('msgSubject').value.trim();
            const message = document.getElementById('msgText').value.trim();
            const status = document.getElementById('msgStatus');
            if (!subject || !message) { status.style.display = 'block'; status.style.background = '#fee2e2'; status.style.color = '#991b1b'; status.textContent = 'Please fill in both fields'; return; }
            try {
                const res = await fetch('/api/messages/send', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ receiver_id: id, subject, message }) });
                const data = await res.json();
                if (res.ok && data.success) { status.style.display = 'block'; status.style.background = '#d1fae5'; status.style.color = '#065f46'; status.textContent = '✓ Message sent!'; setTimeout(() => document.querySelector('[style*="position:fixed"]')?.remove(), 2000); }
                else throw new Error(data.message || 'Failed');
            } catch (err) { status.style.display = 'block'; status.style.background = '#fee2e2'; status.style.color = '#991b1b'; status.textContent = err.message || 'Please login first'; }
        }
    </script>
</body>
</html>
