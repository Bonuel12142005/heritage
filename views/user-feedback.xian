<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <title><%= title %></title>
    <%- include('partials/user-dashboard-styles.xian') %>
    <style>
        .feedback-grid { display: flex; flex-direction: column; gap: 1.25rem; }
        
        .feedback-card {
            background: var(--bg-card, #fff);
            border-radius: 1.25rem;
            padding: 1.75rem;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
            border: 1px solid #d1fae5;
            transition: all 0.2s ease;
        }
        
        .feedback-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
        }
        
        .feedback-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 1rem;
            flex-wrap: wrap;
            gap: 0.75rem;
        }
        
        .feedback-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: #14532d;
            margin-bottom: 0.5rem;
        }
        
        .feedback-badges {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            align-items: center;
        }
        
        .badge {
            padding: 0.375rem 0.875rem;
            border-radius: 2rem;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
        }
        
        .badge-pending { background: linear-gradient(135deg, #fef3c7, #fde68a); color: #92400e; }
        .badge-reviewed { background: linear-gradient(135deg, #dbeafe, #bfdbfe); color: #1e40af; }
        .badge-resolved { background: linear-gradient(135deg, #d1fae5, #a7f3d0); color: #14532d; }
        .badge-category { background: #f0fdf4; color: #4b5563; border: 1px solid #bbf7d0; }
        
        .feedback-rating {
            color: #fbbf24;
            font-size: 1rem;
        }
        
        .feedback-message {
            color: #4b5563;
            line-height: 1.7;
            margin-bottom: 1rem;
            font-size: 0.95rem;
        }
        
        .feedback-date {
            font-size: 0.85rem;
            color: #9ca3af;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .admin-response {
            background: linear-gradient(135deg, #eff6ff, #dbeafe);
            border: 2px solid #93c5fd;
            border-radius: 1rem;
            padding: 1.25rem;
            margin-top: 1.25rem;
        }
        
        .admin-response-header {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #1e40af;
            font-weight: 700;
            margin-bottom: 0.75rem;
            font-size: 0.95rem;
        }
        
        .admin-response-header i {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            color: white;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
        }
        
        .admin-response p {
            color: #1e40af;
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 0.5rem;
        }
        
        .admin-response small {
            color: #3b82f6;
            font-size: 0.8rem;
        }
        
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            background: white;
            border-radius: 1.25rem;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }
        
        .empty-state-icon {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, #166534, #22c55e);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
        }
        
        .empty-state-icon i {
            font-size: 2.5rem;
            color: white;
        }
        
        .empty-state h2 {
            color: #14532d;
            margin-bottom: 0.75rem;
            font-size: 1.5rem;
        }
        
        .empty-state p {
            color: #4b5563;
            margin-bottom: 1.5rem;
            max-width: 400px;
            margin-left: auto;
            margin-right: auto;
        }
        
        .btn-feedback {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: linear-gradient(135deg, #f97316, #ea580c);
            color: white;
            padding: 0.875rem 1.75rem;
            border-radius: 0.875rem;
            text-decoration: none;
            font-weight: 700;
            transition: all 0.2s;
            box-shadow: 0 4px 14px rgba(249, 115, 22, 0.4);
        }
        
        .btn-feedback:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(249, 115, 22, 0.5);
        }
        
        .topbar-actions {
            display: flex;
            gap: 1rem;
            align-items: center;
        }
    </style>
</head>
<body>
    <%- include('partials/user-sidebar.xian') %>

    <main class="main-content">
        <div class="topbar">
            <div class="topbar-left">
                <h1><i class="fas fa-comment-dots"></i> My Feedback</h1>
                <p>Track your submitted feedback and suggestions</p>
            </div>
            <div class="topbar-actions">
                <a href="/feedback" class="btn-feedback">
                    <i class="fas fa-plus"></i> Submit New Feedback
                </a>
            </div>
        </div>

        <div class="dashboard-content">
            <% if (!feedback || feedback.length === 0) { %>
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="fas fa-comment-dots"></i>
                    </div>
                    <h2>No Feedback Yet</h2>
                    <p>Share your thoughts and help us improve tourism services in Gloria, Oriental Mindoro!</p>
                    <a href="/feedback" class="btn-feedback">
                        <i class="fas fa-paper-plane"></i> Submit Your First Feedback
                    </a>
                </div>
            <% } else { %>
                <div class="feedback-grid">
                    <% feedback.forEach(item => { %>
                        <div class="feedback-card">
                            <div class="feedback-header">
                                <div>
                                    <h3 class="feedback-title"><%= item.subject %></h3>
                                    <div class="feedback-badges">
                                        <span class="badge badge-<%= item.status %>">
                                            <i class="fas fa-<%= item.status === 'resolved' ? 'check-circle' : (item.status === 'reviewed' ? 'eye' : 'clock') %>"></i>
                                            <%= item.status.toUpperCase() %>
                                        </span>
                                        <span class="badge badge-category">
                                            <i class="fas fa-tag"></i> <%= item.category %>
                                        </span>
                                        <% if (item.rating) { %>
                                            <span class="feedback-rating">
                                                <% for(let i = 0; i < item.rating; i++) { %><i class="fas fa-star"></i><% } %>
                                                <% for(let i = item.rating; i < 5; i++) { %><i class="far fa-star"></i><% } %>
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                                <span class="feedback-date">
                                    <i class="fas fa-calendar-alt"></i>
                                    <%= new Date(item.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                </span>
                            </div>
                            
                            <p class="feedback-message"><%= item.message %></p>

                            <% if (item.admin_response) { %>
                                <div class="admin-response">
                                    <div class="admin-response-header">
                                        <i class="fas fa-reply"></i>
                                        Admin Response
                                    </div>
                                    <p><%= item.admin_response %></p>
                                    <% if (item.responded_at) { %>
                                        <small>
                                            <i class="fas fa-clock"></i>
                                            Responded on <%= new Date(item.responded_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                        </small>
                                    <% } %>
                                </div>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
