<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/dashboard-head.xian') %>
    <title><%= item ? 'Edit' : 'Add' %> Heritage Item - HeritageLink Admin</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --ocean-blue: #0077B6;
            --ocean-dark: #005A8D;
            --ocean-light: #0096C7;
            --accent-gold: #FFD700;
            --bg-main: #f8faf9;
            --bg-card: #ffffff;
            --text-primary: #064e3b;
            --text-secondary: #6b7280;
        }
        body { font-family: 'Inter', sans-serif; background: var(--bg-main); color: var(--text-primary); }
        
        /* Sidebar - Ocean Blue Theme */
        .sidebar { 
            position: fixed; 
            left: 0; 
            top: 0; 
            height: 100vh; 
            width: 260px; 
            background: linear-gradient(180deg, var(--ocean-blue) 0%, var(--ocean-dark) 100%);
            padding: 0;
            z-index: 1000;
            overflow-y: auto;
        }
        
        .sidebar-logo { 
            padding: 2rem 1.5rem;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        
        .sidebar-logo img {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            margin-bottom: 0.75rem;
            background: white;
            padding: 4px;
        }
        
        .sidebar-logo h2 { 
            color: white; 
            font-size: 1.35rem; 
            font-weight: 700;
            margin-bottom: 0.5rem;
        }
        
        .sidebar-logo .badge { 
            background: var(--accent-gold);
            color: var(--ocean-dark);
            padding: 0.35rem 1rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.05em;
            display: inline-block;
        }
        
        .sidebar-menu { 
            list-style: none;
            padding: 1rem 0;
        }
        
        .menu-section { 
            color: rgba(255,255,255,0.4);
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            padding: 1.5rem 1.5rem 0.5rem;
            margin-top: 0.5rem;
        }
        
        .menu-item { 
            margin: 0.15rem 0.75rem;
        }
        
        .menu-link { 
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 0.85rem 1rem;
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            border-radius: 10px;
            transition: all 0.2s;
            font-weight: 500;
            font-size: 0.95rem;
        }
        
        .menu-link:hover { 
            background: rgba(255,255,255,0.1);
            color: white;
        }
        
        .menu-link.active { 
            background: white;
            color: var(--ocean-blue);
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }
        
        .menu-link i { 
            width: 20px;
            text-align: center;
            font-size: 1.1rem;
        }
        
        .menu-link .caret {
            margin-left: auto;
            font-size: 0.75rem;
            transition: transform 0.3s;
        }
        
        /* Submenu */
        .submenu {
            list-style: none;
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            background: rgba(0,0,0,0.15);
            margin: 0.25rem 0.75rem;
            border-radius: 8px;
        }
        
        .submenu.open {
            max-height: 300px;
            padding: 0.5rem 0;
        }
        
        .submenu .menu-link {
            padding-left: 3rem;
            font-size: 0.9rem;
        }
        
        .main-content { margin-left: 260px; min-height: 100vh; }
        .topbar { background: var(--bg-card); padding: 1.5rem 2rem; border-bottom: 3px solid var(--ocean-blue); display: flex; justify-content: space-between; align-items: center; }
        .topbar-left h1 { font-size: 1.75rem; font-weight: 700; color: var(--ocean-blue); }
        .topbar-left p { color: var(--text-secondary); margin-top: 0.25rem; }
        .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; border-radius: 0.75rem; text-decoration: none; font-weight: 600; font-size: 0.875rem; transition: all 0.2s; border: none; cursor: pointer; }
        .btn-primary { background: var(--accent-gold); color: var(--ocean-dark); }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(255,215,0,0.3); }
        .btn-secondary { background: var(--bg-main); color: var(--ocean-blue); border: 2px solid var(--ocean-blue); }
        .content { padding: 2rem; max-width: 900px; }
        .form-card { background: var(--bg-card); border-radius: 1rem; padding: 2rem; border: 2px solid #e5e7eb; }
        .form-section { margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 1px solid #e5e7eb; }
        .form-section:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
        .form-section-title { font-size: 1.1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem; }
        .form-section-title i { color: var(--ocean-blue); }
        .form-group { margin-bottom: 1.25rem; }
        .form-group label { display: block; font-weight: 600; color: var(--text-primary); margin-bottom: 0.5rem; font-size: 0.875rem; }
        .form-group label .required { color: #ef4444; }
        .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 0.75rem 1rem; border: 2px solid #e5e7eb; border-radius: 0.5rem; font-size: 0.95rem; transition: border-color 0.2s; background: var(--bg-main); }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus { outline: none; border-color: var(--ocean-blue); background: white; }
        .form-group textarea { min-height: 120px; resize: vertical; }
        .form-group .hint { font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.35rem; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
        .form-actions { display: flex; gap: 1rem; margin-top: 2rem; }
        .upload-area { border: 2px dashed #e5e7eb; border-radius: 0.75rem; padding: 2rem; text-align: center; background: var(--bg-main); cursor: pointer; transition: all 0.2s; }
        .upload-area:hover { border-color: var(--ocean-blue); background: #f0f9ff; }
        .upload-area i { font-size: 2.5rem; color: var(--ocean-blue); margin-bottom: 0.75rem; }
        .upload-area p { color: var(--text-secondary); margin-bottom: 0.5rem; }
        .upload-area small { color: var(--text-muted); }
        .preview-container { margin-top: 1rem; }
        .preview-container img, .preview-container video { max-width: 100%; max-height: 200px; border-radius: 0.5rem; }
        .current-media { margin-top: 1rem; padding: 1rem; background: var(--bg-main); border-radius: 0.5rem; }
        .current-media img { max-width: 200px; border-radius: 0.5rem; }
        @media (max-width: 768px) {
            .sidebar { width: 70px; }
            .sidebar-logo h2 span, .sidebar-logo .badge, .menu-link span { display: none; }
            .menu-link { justify-content: center; }
            .main-content { margin-left: 70px; }
            .form-row { grid-template-columns: 1fr; }
        }
        
        /* Section headers */
        .menu-section { 
            color: rgba(255,255,255,0.5); 
            font-size: 0.75rem; 
            font-weight: 700; 
            text-transform: uppercase; 
            letter-spacing: 0.05em; 
            padding: 1.5rem 2rem 0.5rem; 
            margin-top: 1rem;
        }
        
        /* Submenu styles */
        .submenu { 
            max-height: 0; 
            overflow: hidden; 
            transition: max-height 0.3s ease; 
            background: rgba(0,0,0,0.2); 
            margin: 0 1rem; 
            border-radius: 0.5rem;
        }
        .submenu.open { max-height: 500px; }
        .submenu .menu-link { padding-left: 3rem; font-size: 0.9rem; }
        .menu-link .caret { margin-left: auto; transition: transform 0.3s; }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-logo">
            <img src="/uploads/logo.jpg" alt="HeritageLink">
            <h2>HeritageLink</h2>
            <span class="badge">ADMIN</span>
        </div>
        <ul class="sidebar-menu">
            <li class="menu-section">MAIN</li>
            <li class="menu-item"><a href="/admin/dashboard" class="menu-link"><i class="fas fa-th-large"></i><span>Dashboard</span></a></li>
            <li class="menu-item"><a href="/admin/events" class="menu-link"><i class="fas fa-calendar-alt"></i><span>Events</span></a></li>
            <li class="menu-item"><a href="/admin/heritage-gallery" class="menu-link active"><i class="fas fa-landmark"></i><span>Heritage Gallery</span></a></li>
            <li class="menu-item">
                <a href="#" class="menu-link" onclick="toggleLocationsMenu(event)">
                    <i class="fas fa-globe"></i><span>Locations</span>
                    <i class="fas fa-chevron-down caret" id="locations-caret"></i>
                </a>
                <ul class="submenu" id="locations-submenu">
                    <li class="menu-item"><a href="/admin/destinations" class="menu-link"><i class="fas fa-map-marked-alt"></i><span>Destinations</span></a></li>
                    <li class="menu-item"><a href="/admin/map-places" class="menu-link"><i class="fas fa-map-pin"></i><span>Map Places</span></a></li>
                </ul>
            </li>
            <li class="menu-item"><a href="/admin/users" class="menu-link"><i class="fas fa-users"></i><span>Users</span></a></li>
            
            <li class="menu-section">MANAGEMENT</li>
            <li class="menu-item"><a href="/admin/moderate" class="menu-link"><i class="fas fa-shield-alt"></i><span>Moderation</span></a></li>
            <li class="menu-item"><a href="/admin/feedback" class="menu-link"><i class="fas fa-comment-dots"></i><span>Feedback</span></a></li>
            <li class="menu-item"><a href="/admin/analytics" class="menu-link"><i class="fas fa-chart-line"></i><span>Analytics</span></a></li>
            <li class="menu-item"><a href="/admin/settings" class="menu-link"><i class="fas fa-cog"></i><span>Settings</span></a></li>
            
            <li class="menu-section" style="margin-top: 2rem;"></li>
            <li class="menu-item"><a href="/" class="menu-link"><i class="fas fa-home"></i><span>Home</span></a></li>
            <li class="menu-item"><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt"></i><span>Logout</span></a></li>
        </ul>
    </aside>

    <main class="main-content">
        <div class="topbar">
            <div class="topbar-left">
                <h1><i class="fas fa-<%= item ? 'edit' : 'plus' %>"></i> <%= item ? 'Edit' : 'Add' %> Heritage Item</h1>
                <p><%= item ? 'Update cultural asset information' : 'Add a new cultural asset to the archive' %></p>
            </div>
        </div>

        <div class="content">
            <form action="/admin/heritage-gallery/save" method="POST" enctype="multipart/form-data" class="form-card">
                <% if (item) { %>
                    <input type="hidden" name="id" value="<%= item.id %>">
                <% } %>

                <!-- Basic Information -->
                <div class="form-section">
                    <h3 class="form-section-title"><i class="fas fa-info-circle"></i> Basic Information</h3>
                    <div class="form-group">
                        <label>Title <span class="required">*</span></label>
                        <input type="text" name="title" value="<%= item ? item.title : '' %>" required placeholder="e.g., Traditional Mangyan Weaving Demonstration">
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <textarea name="description" placeholder="Describe the cultural significance and context of this item..."><%= item ? item.description : '' %></textarea>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Category <span class="required">*</span></label>
                            <select name="category" required>
                                <option value="">Select Category</option>
                                <option value="traditional_crafts" <%= item && item.category === 'traditional_crafts' ? 'selected' : '' %>>Traditional Crafts</option>
                                <option value="festivals" <%= item && item.category === 'festivals' ? 'selected' : '' %>>Festivals</option>
                                <option value="oral_history" <%= item && item.category === 'oral_history' ? 'selected' : '' %>>Oral History</option>
                                <option value="historical_photos" <%= item && item.category === 'historical_photos' ? 'selected' : '' %>>Historical Photos</option>
                                <option value="traditional_music" <%= item && item.category === 'traditional_music' ? 'selected' : '' %>>Traditional Music</option>
                                <option value="dance" <%= item && item.category === 'dance' ? 'selected' : '' %>>Dance</option>
                                <option value="cuisine" <%= item && item.category === 'cuisine' ? 'selected' : '' %>>Cuisine</option>
                                <option value="architecture" <%= item && item.category === 'architecture' ? 'selected' : '' %>>Architecture</option>
                                <option value="clothing" <%= item && item.category === 'clothing' ? 'selected' : '' %>>Clothing</option>
                                <option value="rituals" <%= item && item.category === 'rituals' ? 'selected' : '' %>>Rituals</option>
                                <option value="documents" <%= item && item.category === 'documents' ? 'selected' : '' %>>Documents</option>
                                <option value="other" <%= item && item.category === 'other' ? 'selected' : '' %>>Other</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Media Type <span class="required">*</span></label>
                            <select name="media_type" id="mediaType" required onchange="updateUploadHint()">
                                <option value="">Select Type</option>
                                <option value="photo" <%= item && item.media_type === 'photo' ? 'selected' : '' %>>Photo</option>
                                <option value="video" <%= item && item.media_type === 'video' ? 'selected' : '' %>>Video</option>
                                <option value="audio" <%= item && item.media_type === 'audio' ? 'selected' : '' %>>Audio (Oral History)</option>
                                <option value="document" <%= item && item.media_type === 'document' ? 'selected' : '' %>>Document</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Media Upload -->
                <div class="form-section">
                    <h3 class="form-section-title"><i class="fas fa-upload"></i> Media File</h3>
                    <div class="form-group">
                        <label>Upload File <%= item ? '' : '<span class="required">*</span>' %></label>
                        <div class="upload-area" onclick="document.getElementById('mediaFile').click()">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <p>Click to upload or drag and drop</p>
                            <small id="uploadHint">Photos: JPG, PNG | Videos: MP4, WebM | Audio: MP3, WAV | Documents: PDF</small>
                        </div>
                        <input type="file" id="mediaFile" name="media_file" accept="image/*,video/*,audio/*,.pdf" style="display: none;" onchange="previewFile(this)">
                        <div class="preview-container" id="previewContainer"></div>
                        <% if (item && item.media_url) { 
                            // Ensure absolute path for media URL
                            let currentMediaPath = item.media_url;
                            if (!currentMediaPath.startsWith('http') && !currentMediaPath.startsWith('/')) {
                                currentMediaPath = '/' + currentMediaPath;
                            }
                        %>
                            <div class="current-media">
                                <p style="font-weight: 600; margin-bottom: 0.5rem;">Current file:</p>
                                <% if (item.media_type === 'photo') { %>
                                    <img src="<%= currentMediaPath %>" alt="Current media" onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22200%22 height=%22150%22%3E%3Crect fill=%22%23f3f4f6%22 width=%22200%22 height=%22150%22/%3E%3Ctext x=%2250%25%22 y=%2250%25%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22 font-family=%22Arial%22 font-size=%2214%22 fill=%22%23999%22%3EImage Missing%3C/text%3E%3Ctext x=%2250%25%22 y=%2265%25%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22 font-family=%22Arial%22 font-size=%2210%22 fill=%22%23999%22%3EPlease re-upload%3C/text%3E%3C/svg%3E'; this.style.border='2px dashed #e5e7eb';">
                                <% } else { %>
                                    <a href="<%= currentMediaPath %>" target="_blank"><%= item.media_url %></a>
                                <% } %>
                            </div>
                        <% } %>
                    </div>
                    <div class="form-group">
                        <label>Or Enter Media URL</label>
                        <input type="url" name="media_url" value="<%= item ? item.media_url : '' %>" placeholder="https://example.com/media/file.jpg">
                        <p class="hint">Use this if the file is hosted externally (YouTube, Vimeo, etc.)</p>
                    </div>
                </div>

                <!-- Historical Context -->
                <div class="form-section">
                    <h3 class="form-section-title"><i class="fas fa-history"></i> Historical Context</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Historical Date/Era</label>
                            <input type="text" name="historical_date" value="<%= item ? item.historical_date : '' %>" placeholder="e.g., 1950s, Pre-colonial, 2020">
                            <p class="hint">Approximate date or era when this was created/captured</p>
                        </div>
                        <div class="form-group">
                            <label>Location</label>
                            <input type="text" name="location" value="<%= item ? item.location : '' %>" placeholder="e.g., Gloria Town Plaza, Barangay Agsalin">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Contributor/Source Person</label>
                            <input type="text" name="contributor_name" value="<%= item ? item.contributor_name : '' %>" placeholder="e.g., Elder Juan Dela Cruz, Maria Santos">
                        </div>
                        <div class="form-group">
                            <label>Source/Collection</label>
                            <input type="text" name="source" value="<%= item ? item.source : '' %>" placeholder="e.g., Municipal Archives, Family Collection">
                        </div>
                    </div>
                </div>

                <!-- Additional Details -->
                <div class="form-section">
                    <h3 class="form-section-title"><i class="fas fa-tags"></i> Additional Details</h3>
                    <div class="form-group">
                        <label>Tags</label>
                        <input type="text" name="tags" value="<%= item ? item.tags : '' %>" placeholder="mangyan, weaving, traditional, craft (comma-separated)">
                        <p class="hint">Add keywords to help with search and discovery</p>
                    </div>
                    <div class="form-group" id="transcriptGroup" style="display: none;">
                        <label>Transcript (for audio/video)</label>
                        <textarea name="transcript" placeholder="Enter transcript of oral history or video narration..."><%= item ? item.transcript : '' %></textarea>
                    </div>
                    <div class="form-row">
                        <div class="form-group" id="durationGroup" style="display: none;">
                            <label>Duration</label>
                            <input type="text" name="duration" value="<%= item ? item.duration : '' %>" placeholder="e.g., 5:30, 1:23:45">
                        </div>
                        <div class="form-group">
                            <label>Status</label>
                            <select name="status">
                                <option value="published" <%= !item || item.status === 'published' ? 'selected' : '' %>>Published</option>
                                <option value="draft" <%= item && item.status === 'draft' ? 'selected' : '' %>>Draft</option>
                                <option value="archived" <%= item && item.status === 'archived' ? 'selected' : '' %>>Archived</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= item ? 'Update' : 'Save' %> Item</button>
                    <a href="/admin/heritage-gallery" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </main>

    <script>
        function updateUploadHint() {
            const mediaType = document.getElementById('mediaType').value;
            const transcriptGroup = document.getElementById('transcriptGroup');
            const durationGroup = document.getElementById('durationGroup');
            
            if (mediaType === 'audio' || mediaType === 'video') {
                transcriptGroup.style.display = 'block';
                durationGroup.style.display = 'block';
            } else {
                transcriptGroup.style.display = 'none';
                durationGroup.style.display = 'none';
            }
        }

        function previewFile(input) {
            const container = document.getElementById('previewContainer');
            container.innerHTML = '';
            
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const reader = new FileReader();
                
                if (file.type.startsWith('image/')) {
                    reader.onload = function(e) {
                        container.innerHTML = '<img src="' + e.target.result + '" alt="Preview">';
                    };
                    reader.readAsDataURL(file);
                } else if (file.type.startsWith('video/')) {
                    reader.onload = function(e) {
                        container.innerHTML = '<video src="' + e.target.result + '" controls style="max-width: 100%;"></video>';
                    };
                    reader.readAsDataURL(file);
                } else {
                    container.innerHTML = '<p style="padding: 1rem; background: var(--bg-main); border-radius: 0.5rem;"><i class="fas fa-file"></i> ' + file.name + '</p>';
                }
            }
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', updateUploadHint);
        
        // Handle form submission with AJAX
        document.querySelector('form').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const form = e.target;
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalBtnText = submitBtn.innerHTML;
            
            // Disable submit button and show loading
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
            
            try {
                const formData = new FormData(form);
                
                const response = await fetch('/admin/heritage-gallery/save', {
                    method: 'POST',
                    body: formData
                });
                
                const data = await response.json();
                
                if (data.success) {
                    // Show success message
                    alert('✅ ' + data.message);
                    // Redirect to heritage gallery list
                    window.location.href = '/admin/heritage-gallery';
                } else {
                    // Show error message
                    alert('❌ ' + data.message);
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalBtnText;
                }
            } catch (error) {
                console.error('Error saving heritage item:', error);
                alert('❌ Failed to save heritage item. Please try again.');
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalBtnText;
            }
        });
    </script>
</body>
</html>
