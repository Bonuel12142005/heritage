<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - HeritageLink</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/heritagelink-unified.css">
  <style>
    html,body{overflow-x:clip;max-width:100vw}
    
    /* Hero */
    .page-hero{background:var(--gradient-nature);padding:3rem 1.5rem 2.5rem;text-align:center;position:relative}
    .page-hero::after{content:'';position:absolute;bottom:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#D4AF37,#FFD700,#D4AF37)}
    .hero-icon{width:70px;height:70px;background:rgba(255,255,255,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem}
    .hero-icon i{font-size:1.75rem;color:#fff}
    .page-hero h1{color:#fff;font-size:2rem;font-weight:800;margin:0 0 0.5rem;font-family:'Poppins',sans-serif}
    .page-hero p{color:var(--leaf-green);font-size:1rem;margin:0 auto;max-width:600px}
    
    .container{max-width:800px;margin:0 auto;padding:1.5rem}
    
    /* Info Box */
    .info-box{background:linear-gradient(135deg,#eff6ff,#dbeafe);border:1px solid #93c5fd;border-radius:var(--radius-lg);padding:1.25rem;margin:-1.5rem auto 1.5rem;max-width:700px;position:relative;z-index:10;display:flex;gap:1rem;align-items:flex-start}
    .info-icon{width:44px;height:44px;background:linear-gradient(135deg,#3b82f6,#2563eb);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .info-icon i{color:#fff;font-size:1.1rem}
    .info-content h4{color:#1e40af;font-size:0.95rem;font-weight:700;margin:0 0 0.25rem}
    .info-content p{color:#1e40af;font-size:0.85rem;margin:0;opacity:0.9;line-height:1.5}
    
    /* Alerts */
    .alert{padding:1rem 1.25rem;border-radius:var(--radius-md);margin-bottom:1.25rem;display:flex;align-items:center;gap:0.75rem;font-size:0.9rem;font-weight:500}
    .alert-success{background:var(--leaf-green);color:var(--forest-green);border:1px solid var(--sage-green)}
    .alert-error{background:#fee2e2;color:#991b1b;border:1px solid #fca5a5}
    .alert i{font-size:1.1rem}
    
    /* Feedback Card */
    .feedback-card{background:#fff;border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);padding:2rem;border:1px solid var(--rock-gray)}
    
    /* Category Grid */
    .section-label{font-size:0.9rem;font-weight:700;color:var(--forest-green);margin-bottom:0.85rem}
    .category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem;margin-bottom:1.5rem}
    .cat-option{position:relative}
    .cat-option input{position:absolute;opacity:0;pointer-events:none}
    .cat-option label{display:flex;flex-direction:column;align-items:center;gap:0.5rem;padding:1rem 0.75rem;border:2px solid var(--rock-gray);border-radius:var(--radius-md);cursor:pointer;transition:var(--transition);background:var(--pebble-gray);text-align:center}
    .cat-option label i{font-size:1.35rem;color:var(--sage-green);transition:transform 0.2s}
    .cat-option label span{font-size:0.8rem;font-weight:600;color:var(--slate-gray)}
    .cat-option input:checked+label{border-color:var(--sage-green);background:var(--leaf-green)}
    .cat-option input:checked+label i{transform:scale(1.15);color:var(--forest-green)}
    .cat-option input:checked+label span{color:var(--forest-green)}
    .cat-option label:hover{border-color:var(--sage-green);transform:translateY(-2px)}
    
    /* Form */
    .form-group{margin-bottom:1.25rem}
    .form-label{display:block;font-size:0.875rem;font-weight:600;color:var(--forest-green);margin-bottom:0.5rem}
    .form-label .req{color:#ef4444;margin-left:2px}
    .form-input,.form-textarea{width:100%;padding:0.75rem 1rem;border:2px solid var(--rock-gray);border-radius:var(--radius-md);font-size:0.9rem;font-family:inherit;transition:var(--transition);background:#fff;color:var(--charcoal)}
    .form-input:focus,.form-textarea:focus{outline:none;border-color:var(--sage-green);box-shadow:0 0 0 3px rgba(45,134,89,0.1)}
    .form-input::placeholder,.form-textarea::placeholder{color:var(--slate-gray)}
    .form-textarea{min-height:130px;resize:vertical;line-height:1.6}
    .form-hint{font-size:0.8rem;color:var(--slate-gray);margin-top:0.4rem;display:flex;align-items:center;gap:0.35rem}
    .form-hint i{font-size:0.75rem}
    
    /* Rating */
    .rating-box{background:var(--pebble-gray);padding:1rem;border-radius:var(--radius-md);border:2px solid var(--rock-gray)}
    .rating-label{font-size:0.85rem;color:var(--slate-gray);margin-bottom:0.65rem;text-align:center}
    .rating-stars{display:flex;gap:0.35rem;flex-direction:row-reverse;justify-content:center}
    .rating-stars input{display:none}
    .rating-stars label{font-size:2rem;color:#d1d5db;cursor:pointer;transition:all 0.15s;line-height:1}
    .rating-stars label:hover,.rating-stars label:hover~label,.rating-stars input:checked~label{color:#fbbf24;transform:scale(1.1)}
    
    /* Checkbox */
    .checkbox-row{display:flex;align-items:center;gap:0.75rem;padding:0.85rem 1rem;background:var(--pebble-gray);border-radius:var(--radius-md);border:2px solid var(--rock-gray);cursor:pointer;transition:var(--transition)}
    .checkbox-row:hover{border-color:var(--sage-green)}
    .checkbox-row input[type="checkbox"]{width:20px;height:20px;accent-color:var(--sage-green);cursor:pointer}
    .checkbox-row label{cursor:pointer;font-weight:500;color:var(--forest-green);font-size:0.9rem}
    
    /* Submit Button */
    .btn-submit{width:100%;padding:0.9rem 1.5rem;background:linear-gradient(135deg,#D4AF37,#FFD700);color:#fff;border:none;border-radius:var(--radius-md);font-size:1rem;font-weight:700;cursor:pointer;transition:var(--transition);display:flex;align-items:center;justify-content:center;gap:0.5rem;box-shadow:0 4px 15px rgba(212,175,55,0.3)}
    .btn-submit:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(212,175,55,0.4)}
    .btn-submit:disabled{opacity:0.7;cursor:not-allowed;transform:none}
    
    /* Footer Link */
    .footer-link{text-align:center;margin-top:1.5rem;padding:1.25rem;background:#fff;border-radius:var(--radius-md);box-shadow:var(--shadow-sm)}
    .footer-link p{color:var(--slate-gray);font-size:0.9rem;margin:0}
    .footer-link a{color:var(--sage-green);font-weight:600;text-decoration:none}
    .footer-link a:hover{text-decoration:underline}
    
    /* Responsive */
    @media(max-width:768px){
      .page-hero{padding:2rem 1rem}
      .page-hero h1{font-size:1.65rem}
      .container{padding:1rem}
      .info-box{margin:-1rem 0.75rem 1.25rem;flex-direction:column;text-align:center}
      .info-icon{margin:0 auto}
      .category-grid{grid-template-columns:repeat(2,1fr)}
      .feedback-card{padding:1.5rem}
    }
    @media(max-width:480px){
      .page-hero h1{font-size:1.4rem}
      .hero-icon{width:60px;height:60px}
      .hero-icon i{font-size:1.5rem}
      .category-grid{grid-template-columns:repeat(2,1fr);gap:0.5rem}
      .cat-option label{padding:0.85rem 0.5rem}
      .cat-option label i{font-size:1.15rem}
      .cat-option label span{font-size:0.75rem}
      .rating-stars label{font-size:1.65rem}
      .feedback-card{padding:1.25rem}
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="logo">
        <img src="/uploads/logo.jpg" alt="HeritageLink"> HeritageLink
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
        <i class="fas fa-bars"></i>
      </button>
      <div class="nav-overlay" id="navOverlay"></div>
      <div class="nav-links" id="navLinks">
        <button class="nav-close" id="navClose" aria-label="Close menu">
          <i class="fas fa-times"></i>
        </button>
        <a href="/" class="nav-link"><i class="fas fa-home"></i> <span>Home</span></a>
        <a href="/destinations" class="nav-link"><i class="fas fa-map-marked-alt"></i> <span>Explore Map & Sites</span></a>
        <a href="/events" class="nav-link"><i class="fas fa-calendar-alt"></i> <span>Events</span></a>
        <a href="/heritage-gallery" class="nav-link"><i class="fas fa-landmark"></i> <span>Heritage Gallery</span></a>
        
        <a href="/showcase" class="nav-link"><i class="fas fa-palette"></i> <span>Artisans</span></a>
        <a href="/feedback" class="nav-link" style="background:rgba(255,255,255,0.15);color:#fff"><i class="fas fa-comment-dots"></i> <span>Feedback</span></a>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard" class="btn btn-primary">Dashboard</a>
        <% } else { %>
          <a href="/login" class="btn btn-secondary">Login</a>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="page-hero">
    <div class="hero-icon"><i class="fas fa-comment-dots"></i></div>
    <h1>Share Your Feedback</h1>
    <p>Help us improve tourism services and visitor experiences in Gloria, Oriental Mindoro</p>
  </section>

  <div class="container">
    <!-- Info Box -->
    <div class="info-box">
      <div class="info-icon"><i class="fas fa-lightbulb"></i></div>
      <div class="info-content">
        <h4>Your Voice Matters</h4>
        <p>Your feedback helps us enhance the cultural tourism experience. Whether it's a suggestion, compliment, or concern, we value your input.</p>
      </div>
    </div>

    <!-- Alerts -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>

    <!-- Feedback Form -->
    <div class="feedback-card">
      <form action="/feedback/submit" method="POST" id="feedbackForm">
        <!-- Category -->
        <div class="form-group">
          <div class="section-label">What is your feedback about?</div>
          <div class="category-grid">
            <div class="cat-option">
              <input type="radio" name="category" value="destination" id="cat-dest">
              <label for="cat-dest"><i class="fas fa-map-marked-alt"></i><span>Destinations</span></label>
            </div>
            <div class="cat-option">
              <input type="radio" name="category" value="event" id="cat-event">
              <label for="cat-event"><i class="fas fa-calendar-alt"></i><span>Events</span></label>
            </div>
            <div class="cat-option">
              <input type="radio" name="category" value="artisan" id="cat-artisan">
              <label for="cat-artisan"><i class="fas fa-palette"></i><span>Artisans</span></label>
            </div>
            <div class="cat-option">
              <input type="radio" name="category" value="service" id="cat-service">
              <label for="cat-service"><i class="fas fa-concierge-bell"></i><span>Services</span></label>
            </div>
            <div class="cat-option">
              <input type="radio" name="category" value="website" id="cat-website">
              <label for="cat-website"><i class="fas fa-globe"></i><span>Website</span></label>
            </div>
            <div class="cat-option">
              <input type="radio" name="category" value="general" id="cat-general" checked>
              <label for="cat-general"><i class="fas fa-comment"></i><span>General</span></label>
            </div>
          </div>
        </div>

        <!-- Subject -->
        <div class="form-group">
          <label class="form-label" for="subject">Subject <span class="req">*</span></label>
          <input type="text" id="subject" name="subject" class="form-input" placeholder="Brief summary of your feedback" required maxlength="255">
        </div>

        <!-- Message -->
        <div class="form-group">
          <label class="form-label" for="message">Your Feedback <span class="req">*</span></label>
          <textarea id="message" name="message" class="form-textarea" placeholder="Please share your thoughts, suggestions, or experiences..." required maxlength="5000"></textarea>
          <p class="form-hint"><i class="fas fa-info-circle"></i> Be specific to help us understand your feedback.</p>
        </div>

        <!-- Rating -->
        <div class="form-group">
          <label class="form-label">Overall Experience (Optional)</label>
          <div class="rating-box">
            <p class="rating-label">How would you rate your experience?</p>
            <div class="rating-stars">
              <input type="radio" name="rating" value="5" id="star5"><label for="star5" title="Excellent"><i class="fas fa-star"></i></label>
              <input type="radio" name="rating" value="4" id="star4"><label for="star4" title="Good"><i class="fas fa-star"></i></label>
              <input type="radio" name="rating" value="3" id="star3"><label for="star3" title="Average"><i class="fas fa-star"></i></label>
              <input type="radio" name="rating" value="2" id="star2"><label for="star2" title="Poor"><i class="fas fa-star"></i></label>
              <input type="radio" name="rating" value="1" id="star1"><label for="star1" title="Very Poor"><i class="fas fa-star"></i></label>
            </div>
          </div>
        </div>

        <!-- Anonymous -->
        <div class="form-group">
          <div class="checkbox-row">
            <input type="checkbox" name="is_anonymous" id="is_anonymous" <%= typeof user === 'undefined' || !user ? 'checked' : '' %>>
            <label for="is_anonymous">Submit anonymously</label>
          </div>
          <% if (typeof user === 'undefined' || !user) { %>
            <p class="form-hint"><i class="fas fa-user-secret"></i> Anonymous feedback is welcome. Login to allow follow-up.</p>
          <% } %>
        </div>

        <!-- Submit -->
        <button type="submit" class="btn-submit" id="submitBtn">
          <i class="fas fa-paper-plane"></i> Submit Feedback
        </button>
      </form>
    </div>

    <!-- Footer Link -->
    <div class="footer-link">
      <p>Want to review a specific destination? <a href="/destinations">Browse Destinations <i class="fas fa-arrow-right"></i></a></p>
    </div>
  </div>

  <script>
    // Mobile nav
    (function(){
      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navLinks');
      const overlay = document.getElementById('navOverlay');
      const close = document.getElementById('navClose');
      function openMenu() { links.classList.add('active'); overlay.classList.add('active'); document.body.style.overflow = 'hidden'; }
      function closeMenu() { links.classList.remove('active'); overlay.classList.remove('active'); document.body.style.overflow = ''; }
      if(toggle) toggle.addEventListener('click', openMenu);
      if(close) close.addEventListener('click', closeMenu);
      if(overlay) overlay.addEventListener('click', closeMenu);
    })();

    // Form submission
    document.getElementById('feedbackForm').addEventListener('submit', function(e) {
      const btn = document.getElementById('submitBtn');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...';
    });
  </script>
</body>
</html>
