<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - HeritageLink</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/heritagelink-unified.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary: #2d8659; --primary-dark: #1a5f3f; --primary-light: #3fa872;
            --accent: #D4AF37; --accent-dark: #B8941E;
            --bg-main: #f8faf9; --bg-card: #ffffff;
            --text-primary: #064e3b; --text-secondary: #6b7280; --text-muted: #9ca3af;
            --border: #d1fae5; --border-light: #e5e7eb;
        }
        
        html, body { 
            min-height: 100vh; 
            overflow-x: clip;
            max-width: 100vw;
        }
        
        body { 
            font-family: 'Inter', sans-serif; 
            background: var(--bg-main); 
            color: var(--text-primary);
            display: flex;
            flex-direction: column;
        }
        
        /* Container */
        .container { 
            max-width: 1200px; 
            margin: 0 auto; 
            padding: 1.5rem;
            flex: 1;
        }
        
        /* Breadcrumb */
        .breadcrumb { 
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
            font-size: 0.85rem;
            flex-wrap: wrap;
        }
        .breadcrumb a { 
            color: var(--primary); 
            text-decoration: none;
            transition: color 0.2s;
        }
        .breadcrumb a:hover { color: var(--primary-dark); }
        .breadcrumb span { color: var(--text-muted); }
        .breadcrumb .current { color: var(--text-secondary); }
        
        /* Product Layout */
        .product-layout { 
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            gap: 2rem;
            margin-bottom: 2rem;
        }
        
        /* Gallery */
        .product-gallery { 
            background: var(--bg-card); 
            border-radius: 1rem; 
            overflow: hidden;
            border: 1px solid var(--border);
            position: sticky;
            top: 1rem;
        }
        .main-image { 
            height: 400px; 
            background: linear-gradient(135deg, var(--border), #e0f2fe); 
            display: flex; 
            align-items: center; 
            justify-content: center;
            position: relative;
            overflow: hidden;
        }
        .main-image img { 
            width: 100%; 
            height: 100%; 
            object-fit: contain;
            transition: transform 0.3s;
        }
        .main-image:hover img { transform: scale(1.02); }
        .main-image .placeholder { font-size: 5rem; color: var(--primary-light); opacity: 0.5; }
        
        .thumbnail-strip {
            display: flex;
            gap: 0.5rem;
            padding: 0.75rem;
            overflow-x: auto;
            background: var(--bg-main);
        }
        .thumbnail {
            width: 60px;
            height: 60px;
            border-radius: 0.5rem;
            overflow: hidden;
            cursor: pointer;
            border: 2px solid transparent;
            flex-shrink: 0;
            transition: all 0.2s;
        }
        .thumbnail.active, .thumbnail:hover { border-color: var(--primary); }
        .thumbnail img { width: 100%; height: 100%; object-fit: cover; }
        
        /* Product Info */
        .product-info { display: flex; flex-direction: column; }
        
        .product-category { 
            font-size: 0.75rem; 
            color: var(--accent); 
            font-weight: 700; 
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }
        
        .product-title { 
            font-size: 1.75rem; 
            font-weight: 800; 
            margin-bottom: 0.75rem; 
            line-height: 1.3;
            font-family: 'Poppins', sans-serif;
            color: var(--text-primary);
        }
        
        .product-rating { 
            display: flex; 
            align-items: center; 
            gap: 0.5rem; 
            margin-bottom: 1rem;
        }
        .stars { color: #f59e0b; font-size: 0.9rem; }
        .review-count { color: var(--text-secondary); font-size: 0.85rem; }
        .review-count a { color: var(--primary); text-decoration: none; }
        
        .product-price { 
            font-size: 2rem; 
            font-weight: 800; 
            color: var(--primary); 
            margin-bottom: 1rem;
            font-family: 'Poppins', sans-serif;
        }
        
        .stock-badge { 
            display: inline-flex; 
            align-items: center; 
            gap: 0.35rem; 
            padding: 0.4rem 0.85rem; 
            border-radius: 2rem; 
            font-size: 0.8rem; 
            font-weight: 600; 
            margin-bottom: 1rem;
        }
        .stock-available { background: #d1fae5; color: #065f46; }
        .stock-order { background: #fef3c7; color: #92400e; }
        .stock-out { background: #fee2e2; color: #991b1b; }
        
        .product-desc { 
            color: var(--text-secondary); 
            line-height: 1.7; 
            margin-bottom: 1.25rem;
            font-size: 0.95rem;
        }
        
        /* Product Meta */
        .product-meta { 
            background: var(--bg-main); 
            border-radius: 0.75rem; 
            padding: 1rem; 
            margin-bottom: 1.25rem;
        }
        .meta-row { 
            display: flex; 
            justify-content: space-between; 
            padding: 0.5rem 0; 
            border-bottom: 1px solid var(--border);
            font-size: 0.9rem;
        }
        .meta-row:last-child { border-bottom: none; }
        .meta-label { color: var(--text-secondary); display: flex; align-items: center; gap: 0.4rem; }
        .meta-label i { color: var(--primary); font-size: 0.8rem; width: 16px; }
        .meta-value { font-weight: 600; color: var(--text-primary); text-align: right; }
        
        /* Buttons */
        .btn { 
            display: inline-flex; 
            align-items: center; 
            justify-content: center;
            gap: 0.5rem; 
            padding: 0.85rem 1.5rem; 
            border-radius: 0.6rem; 
            font-weight: 600; 
            font-size: 0.9rem; 
            text-decoration: none; 
            border: none; 
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-primary { 
            background: linear-gradient(135deg, var(--accent), var(--accent-dark)); 
            color: white;
            box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);
        }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(255, 107, 53, 0.4); }
        .btn-secondary { 
            background: var(--bg-main); 
            color: var(--primary); 
            border: 2px solid var(--primary);
        }
        .btn-secondary:hover { background: var(--primary); color: white; }
        
        .btn-group { 
            display: flex; 
            gap: 0.75rem; 
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
        }
        .btn-group .btn { flex: 1; min-width: 140px; }
        
        /* Artisan Card */
        .artisan-card { 
            background: var(--bg-card); 
            border-radius: 0.875rem; 
            padding: 1.25rem; 
            border: 1px solid var(--border); 
            display: flex; 
            gap: 1rem; 
            align-items: center;
        }
        .artisan-avatar { 
            width: 60px; 
            height: 60px; 
            border-radius: 50%; 
            background: linear-gradient(135deg, var(--primary), var(--primary-light)); 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            color: white; 
            font-size: 1.5rem;
            font-weight: 700;
            overflow: hidden;
            flex-shrink: 0;
        }
        .artisan-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .artisan-info { flex: 1; min-width: 0; }
        .artisan-info h4 { font-size: 1rem; margin-bottom: 0.2rem; color: var(--text-primary); }
        .artisan-specialty { color: var(--accent); font-size: 0.8rem; font-weight: 600; }
        .artisan-link { 
            color: var(--primary); 
            text-decoration: none; 
            font-size: 0.85rem; 
            margin-top: 0.35rem; 
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
        }
        .artisan-link:hover { text-decoration: underline; }
        
        /* Related Section */
        .section { margin-top: 2.5rem; }
        .section-title { 
            font-size: 1.35rem; 
            font-weight: 700; 
            margin-bottom: 1.25rem;
            font-family: 'Poppins', sans-serif;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .section-title i { color: var(--primary); }
        
        .related-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); 
            gap: 1rem;
        }
        .related-card { 
            background: var(--bg-card); 
            border-radius: 0.75rem; 
            overflow: hidden; 
            border: 1px solid var(--border); 
            text-decoration: none; 
            transition: all 0.3s;
        }
        .related-card:hover { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(0,0,0,0.1); }
        .related-image { 
            height: 140px; 
            background: linear-gradient(135deg, var(--border), #e0f2fe); 
            display: flex; 
            align-items: center; 
            justify-content: center;
            overflow: hidden;
        }
        .related-image img { width: 100%; height: 100%; object-fit: cover; }
        .related-image i { font-size: 2rem; color: var(--primary-light); opacity: 0.5; }
        .related-body { padding: 0.875rem; }
        .related-name { 
            font-weight: 600; 
            color: var(--text-primary); 
            margin-bottom: 0.3rem; 
            font-size: 0.9rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .related-price { color: var(--primary); font-weight: 700; font-size: 1rem; }
        
        /* Footer */
        .page-footer {
            background: linear-gradient(135deg, var(--primary-dark), var(--primary));
            color: white;
            text-align: center;
            padding: 1.25rem;
            margin-top: auto;
        }
        .page-footer p { opacity: 0.9; font-size: 0.85rem; margin: 0; }
        
        /* Responsive */
        @media (max-width: 900px) {
            .product-layout { grid-template-columns: 1fr; gap: 1.5rem; }
            .product-gallery { position: static; }
            .main-image { height: 350px; }
            .product-title { font-size: 1.5rem; }
            .product-price { font-size: 1.75rem; }
        }
        
        @media (max-width: 640px) {
            .container { padding: 1rem; }
            .main-image { height: 280px; }
            .product-title { font-size: 1.35rem; }
            .product-price { font-size: 1.5rem; }
            .btn-group { flex-direction: column; }
            .btn-group .btn { width: 100%; }
            .artisan-card { flex-direction: column; text-align: center; }
            .related-grid { grid-template-columns: repeat(2, 1fr); }
            .related-image { height: 120px; }
        }
        
        @media (max-width: 400px) {
            .related-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="logo">
                <img src="/uploads/logo.jpg" alt="HeritageLink"> HeritageLink
            </a>
            <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
                <i class="fas fa-bars"></i>
            </button>
            <div class="nav-overlay" id="navOverlay"></div>
            <div class="nav-links" id="navLinks">
                <button class="nav-close" id="navClose" aria-label="Close menu">
                    <i class="fas fa-times"></i>
                </button>
                <a href="/" class="nav-link"><i class="fas fa-home"></i> <span>Home</span></a>
                <a href="/destinations" class="nav-link"><i class="fas fa-map-marked-alt"></i> <span>Destinations</span></a>
                <a href="/showcase" class="nav-link"><i class="fas fa-palette"></i> <span>Artisans</span></a>
                <a href="/feedback" class="nav-link"><i class="fas fa-comment-alt"></i> <span>Feedback</span></a>
                <a href="/showcase/products" class="nav-link" style="background:rgba(255,255,255,0.15);color:#fff"><i class="fas fa-shopping-bag"></i> <span>Products</span></a>
                <% if (typeof user !== 'undefined' && user) { %>
                    <a href="/dashboard" class="btn btn-primary">Dashboard</a>
                <% } else { %>
                    <a href="/login" class="btn btn-secondary">Login</a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container">
        <!-- Breadcrumb -->
        <div class="breadcrumb">
            <a href="/"><i class="fas fa-home"></i></a>
            <span>/</span>
            <a href="/showcase/products">Products</a>
            <span>/</span>
            <span class="current"><%= product.name %></span>
        </div>

        <!-- Product Layout -->
        <div class="product-layout">
            <!-- Gallery -->
            <div class="product-gallery">
                <div class="main-image" id="mainImage">
                    <% if (product.images && product.images[0]) { %>
                        <img src="<%= product.images[0] %>" alt="<%= product.name %>" id="mainImg">
                    <% } else if (product.product_image) { %>
                        <img src="/<%= product.product_image %>" alt="<%= product.name %>" id="mainImg">
                    <% } else { %>
                        <i class="fas fa-box-open placeholder"></i>
                    <% } %>
                </div>
                <% if (product.images && product.images.length > 1) { %>
                <div class="thumbnail-strip">
                    <% product.images.forEach((img, idx) => { %>
                        <div class="thumbnail <%= idx === 0 ? 'active' : '' %>" onclick="changeImage('<%= img %>', this)">
                            <img src="<%= img %>" alt="Thumbnail">
                        </div>
                    <% }); %>
                </div>
                <% } %>
            </div>

            <!-- Product Info -->
            <div class="product-info">
                <div class="product-category">
                    <i class="fas fa-tag"></i>
                    <%= product.category ? product.category.replace(/_/g, ' ') : 'Handcraft' %>
                </div>
                
                <h1 class="product-title"><%= product.name %></h1>
                
                <% if (product.rating) { %>
                <div class="product-rating">
                    <span class="stars">
                        <% for(let i = 0; i < 5; i++) { %>
                            <i class="fas fa-star<%= i < Math.floor(product.rating) ? '' : (i < product.rating ? '-half-alt' : '') %>" style="<%= i >= product.rating ? 'opacity:0.3' : '' %>"></i>
                        <% } %>
                    </span>
                    <span class="review-count">
                        <%= product.rating.toFixed(1) %> 
                        (<a href="#reviews"><%= product.review_count || 0 %> reviews</a>)
                    </span>
                </div>
                <% } %>
                
                <div class="product-price">₱<%= Number(product.price || 0).toLocaleString('en-PH', {minimumFractionDigits: 2}) %></div>
                
                <% if (product.stock_status === 'in_stock' || product.status === 'available') { %>
                    <span class="stock-badge stock-available"><i class="fas fa-check-circle"></i> In Stock</span>
                <% } else if (product.stock_status === 'made_to_order') { %>
                    <span class="stock-badge stock-order"><i class="fas fa-clock"></i> Made to Order (<%= product.lead_time || '2-3 weeks' %>)</span>
                <% } else if (product.stock_status === 'out_of_stock') { %>
                    <span class="stock-badge stock-out"><i class="fas fa-times-circle"></i> Out of Stock</span>
                <% } else { %>
                    <span class="stock-badge stock-available"><i class="fas fa-check-circle"></i> Available</span>
                <% } %>
                
                <p class="product-desc"><%= product.description || 'Handcrafted with care using traditional techniques passed down through generations. Each piece is unique and made with attention to detail.' %></p>
                
                <div class="product-meta">
                    <% if (product.materials) { %>
                    <div class="meta-row">
                        <span class="meta-label"><i class="fas fa-layer-group"></i> Materials</span>
                        <span class="meta-value"><%= Array.isArray(product.materials) ? product.materials.join(', ') : product.materials %></span>
                    </div>
                    <% } %>
                    <% if (product.dimensions) { %>
                    <div class="meta-row">
                        <span class="meta-label"><i class="fas fa-ruler-combined"></i> Dimensions</span>
                        <span class="meta-value"><%= product.dimensions %></span>
                    </div>
                    <% } %>
                    <% if (product.care_instructions) { %>
                    <div class="meta-row">
                        <span class="meta-label"><i class="fas fa-hand-sparkles"></i> Care</span>
                        <span class="meta-value"><%= product.care_instructions %></span>
                    </div>
                    <% } %>
                    <div class="meta-row">
                        <span class="meta-label"><i class="fas fa-map-marker-alt"></i> Origin</span>
                        <span class="meta-value">Gloria, Oriental Mindoro</span>
                    </div>
                </div>
                
                <div class="btn-group">
                    <button class="btn btn-primary" onclick="openBuyModal()"><i class="fas fa-shopping-cart"></i> Buy Now</button>
                    <button class="btn btn-secondary" onclick="inquireProduct()">
                        <i class="fas fa-envelope"></i> Inquire
                    </button>
                    <button class="btn btn-outline" onclick="messageArtisan(<%= product.artisan_id %>, '<%= (product.artisan_name || 'Artisan').replace(/'/g, "\\'") %>')">
                        <i class="fas fa-comment"></i> Message
                    </button>
                </div>
                
                <!-- Artisan Card -->
                <div class="artisan-card">
                    <div class="artisan-avatar">
                        <% if (product.artisan_photo) { %>
                            <img src="/<%= product.artisan_photo %>" alt="<%= product.artisan_name %>">
                        <% } else { %>
                            <%= (product.artisan_name || 'A').charAt(0).toUpperCase() %>
                        <% } %>
                    </div>
                    <div class="artisan-info">
                        <h4><%= product.artisan_name || 'Local Artisan' %></h4>
                        <div class="artisan-specialty"><%= product.artisan_specialty || 'Master Craftsman' %></div>
                        <a href="/showcase/artisans/<%= product.artisan_id %>" class="artisan-link">
                            View Profile <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Related Products -->
        <% if (relatedProducts && relatedProducts.length > 0) { %>
        <div class="section">
            <h2 class="section-title"><i class="fas fa-th-large"></i> More from this Artisan</h2>
            <div class="related-grid">
                <% relatedProducts.forEach(p => { %>
                <a href="/showcase/products/<%= p.id %>" class="related-card">
                    <div class="related-image">
                        <% if (p.images && p.images[0]) { %>
                            <img src="<%= p.images[0] %>" alt="<%= p.name %>">
                        <% } else if (p.product_image) { %>
                            <img src="/<%= p.product_image %>" alt="<%= p.name %>">
                        <% } else { %>
                            <i class="fas fa-box"></i>
                        <% } %>
                    </div>
                    <div class="related-body">
                        <div class="related-name"><%= p.name %></div>
                        <div class="related-price">₱<%= Number(p.price || 0).toLocaleString() %></div>
                    </div>
                </a>
                <% }); %>
            </div>
        </div>
        <% } %>
    </div>

    <!-- Footer -->
    <footer class="page-footer">
        <p>&copy; 2025 HeritageLink - Cultural Tourism Platform for Gloria, Oriental Mindoro</p>
    </footer>

    <script>
        // Mobile nav
        (function(){
            const toggle = document.getElementById('navToggle');
            const links = document.getElementById('navLinks');
            const overlay = document.getElementById('navOverlay');
            const close = document.getElementById('navClose');
            function openMenu() { links.classList.add('active'); overlay.classList.add('active'); document.body.style.overflow = 'hidden'; }
            function closeMenu() { links.classList.remove('active'); overlay.classList.remove('active'); document.body.style.overflow = ''; }
            if(toggle) toggle.addEventListener('click', openMenu);
            if(close) close.addEventListener('click', closeMenu);
            if(overlay) overlay.addEventListener('click', closeMenu);
        })();

        // Change main image
        function changeImage(src, thumb) {
            const mainImg = document.getElementById('mainImg');
            if (mainImg) {
                mainImg.src = src;
                document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
                thumb.classList.add('active');
            }
        }

        // Inquire product
        function inquireProduct() {
            messageArtisan(<%= product.artisan_id %>, '<%= (product.artisan_name || 'Artisan').replace(/'/g, "\\'") %>', 'Inquiry about: <%= product.name.replace(/'/g, "\\'") %>');
        }

        // Message artisan modal
        function messageArtisan(id, name, subject = '') {
            const overlay = document.createElement('div');
            overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.6);display:flex;align-items:center;justify-content:center;z-index:1000;padding:1rem;';
            overlay.innerHTML = `
                <div style="background:white;border-radius:1rem;padding:1.5rem;max-width:450px;width:100%;max-height:90vh;overflow-y:auto;">
                    <h3 style="margin:0 0 1rem;font-size:1.1rem;display:flex;align-items:center;gap:0.5rem;">
                        <i class="fas fa-envelope" style="color:#2d8659;"></i> Contact ${name}
                    </h3>
                    <div id="msgStatus" style="margin-bottom:1rem;padding:0.75rem;border-radius:0.5rem;display:none;font-size:0.9rem;"></div>
                    <div style="margin-bottom:1rem;">
                        <label style="font-weight:600;display:block;margin-bottom:0.4rem;font-size:0.9rem;">Subject</label>
                        <input id="msgSubject" type="text" value="${subject}" style="width:100%;padding:0.75rem;border:2px solid #d1fae5;border-radius:0.5rem;box-sizing:border-box;font-size:0.9rem;">
                    </div>
                    <div style="margin-bottom:1.25rem;">
                        <label style="font-weight:600;display:block;margin-bottom:0.4rem;font-size:0.9rem;">Message</label>
                        <textarea id="msgText" rows="4" placeholder="I'm interested in this product..." style="width:100%;padding:0.75rem;border:2px solid #d1fae5;border-radius:0.5rem;box-sizing:border-box;resize:vertical;font-family:inherit;font-size:0.9rem;"></textarea>
                    </div>
                    <div style="display:flex;gap:0.75rem;justify-content:flex-end;">
                        <button onclick="this.closest('[style*=position]').remove()" style="padding:0.65rem 1.25rem;border:2px solid #e5e7eb;border-radius:0.5rem;background:#f8faf9;color:#6b7280;font-weight:600;cursor:pointer;font-size:0.85rem;">Cancel</button>
                        <button onclick="sendMsg(${id})" style="padding:0.65rem 1.25rem;border:none;border-radius:0.5rem;background:linear-gradient(135deg,#D4AF37,#FFD700);color:white;font-weight:600;cursor:pointer;font-size:0.85rem;display:flex;align-items:center;gap:0.4rem;">
                            <i class="fas fa-paper-plane"></i> Send
                        </button>
                    </div>
                </div>
            `;
            document.body.appendChild(overlay);
            overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.remove(); });
        }

        // Send message
        async function sendMsg(id) {
            const subject = document.getElementById('msgSubject').value.trim();
            const message = document.getElementById('msgText').value.trim();
            const status = document.getElementById('msgStatus');
            
            if (!subject || !message) {
                status.style.display = 'block';
                status.style.background = '#fee2e2';
                status.style.color = '#991b1b';
                status.textContent = 'Please fill in both fields';
                return;
            }
            
            try {
                const res = await fetch('/api/messages/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ receiver_id: id, subject, message })
                });
                const data = await res.json();
                
                if (res.ok && data.success) {
                    status.style.display = 'block';
                    status.style.background = '#d1fae5';
                    status.style.color = '#065f46';
                    status.innerHTML = '<i class="fas fa-check-circle"></i> Message sent successfully!';
                    setTimeout(() => document.querySelector('[style*="position:fixed"]')?.remove(), 2000);
                } else {
                    throw new Error(data.message || 'Failed to send');
                }
            } catch (err) {
                status.style.display = 'block';
                status.style.background = '#fee2e2';
                status.style.color = '#991b1b';
                status.textContent = err.message || 'Please login to send messages';
            }
        }

        // Buy Now Logic
        function openBuyModal() {
            const overlay = document.createElement('div');
            overlay.className = 'buy-modal-overlay';
            overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.6);display:flex;align-items:center;justify-content:center;z-index:1000;padding:1rem;';
            overlay.innerHTML = `
                <div style="background:white;border-radius:1rem;padding:2rem;max-width:450px;width:100%;box-shadow:0 20px 50px rgba(0,0,0,0.3);">
                    <h3 style="margin:0 0 1rem;font-family:Poppins,sans-serif;color:var(--primary);"><i class="fas fa-shopping-basket"></i> Checkout</h3>
                    <p style="font-size:0.9rem;color:var(--text-secondary);margin-bottom:1.5rem;">Purchase <strong><%= product.name.replace(/'/g, "\\'") %></strong></p>
                    <div id="buyStatus" style="display:none;padding:0.75rem;border-radius:0.5rem;margin-bottom:1rem;font-size:0.85rem;"></div>
                    <div style="margin-bottom:1rem;">
                        <label style="display:block;font-size:0.8rem;font-weight:700;margin-bottom:0.3rem;">Full Name</label>
                        <input id="buyName" type="text" value="<%= (typeof user !== 'undefined' && user) ? user.name : '' %>" style="width:100%;padding:0.75rem;border:1px solid var(--border);border-radius:0.5rem;">
                    </div>
                    <div style="margin-bottom:1rem;">
                        <label style="display:block;font-size:0.8rem;font-weight:700;margin-bottom:0.3rem;">Email</label>
                        <input id="buyEmail" type="email" value="<%= (typeof user !== 'undefined' && user) ? user.email : '' %>" style="width:100%;padding:0.75rem;border:1px solid var(--border);border-radius:0.5rem;">
                    </div>
                    <div style="margin-bottom:1.5rem;">
                        <label style="display:block;font-size:0.8rem;font-weight:700;margin-bottom:0.3rem;">Quantity</label>
                        <input id="buyQty" type="number" min="1" value="1" style="width:100%;padding:0.75rem;border:1px solid var(--border);border-radius:0.5rem;">
                    </div>
                    <div style="display:flex;gap:0.75rem;">
                        <button onclick="this.closest('.buy-modal-overlay').remove()" style="flex:1;padding:0.85rem;border:1px solid var(--border);background:#f8faf9;border-radius:0.5rem;font-weight:600;cursor:pointer;">Cancel</button>
                        <button onclick="confirmPurchase(<%= product.id %>)" id="btnConfirmBuy" style="flex:2;padding:0.85rem;background:var(--primary);color:white;border:none;border-radius:0.5rem;font-weight:700;cursor:pointer;">Confirm Order</button>
                    </div>
                </div>
            `;
            document.body.appendChild(overlay);
        }

        async function confirmPurchase(id) {
            const name = document.getElementById('buyName').value.trim();
            const email = document.getElementById('buyEmail').value.trim();
            const quantity = document.getElementById('buyQty').value;
            const status = document.getElementById('buyStatus');
            const btn = document.getElementById('btnConfirmBuy');

            if(!name || !email) {
                status.style.display = 'block';
                status.style.background = '#fee2e2';
                status.style.color = '#991b1b';
                status.textContent = 'Please provide name and email';
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Processing...';

            try {
                const res = await fetch(`/api/products/${id}/buy`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, email, quantity })
                });
                const data = await res.json();
                if(data.success) {
                    status.style.display = 'block';
                    status.style.background = '#d1fae5';
                    status.style.color = '#065f46';
                    status.textContent = 'Order placed successfully!';
                    btn.style.display = 'none';
                    setTimeout(() => document.querySelector('.buy-modal-overlay')?.remove(), 2000);
                } else {
                    throw new Error(data.message || 'Error placing order');
                }
            } catch(err) {
                status.style.display = 'block';
                status.style.background = '#fee2e2';
                status.style.color = '#991b1b';
                status.textContent = err.message;
                btn.disabled = false;
                btn.textContent = 'Confirm Order';
            }
        }
    </script>
</body>
</html>
