<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Heritage Gallery - HeritageLink</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/heritagelink-unified.css">
  <style>
    html,body{overflow-x:clip;max-width:100vw}
    
    /* Hero */
    .page-hero{background:var(--gradient-nature);padding:3rem 1.5rem 2.5rem;text-align:center;position:relative}
    .page-hero::after{content:'';position:absolute;bottom:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#D4AF37,#FFD700,#D4AF37)}
    .page-hero h1{color:#fff;font-size:2.25rem;font-weight:800;margin:0 0 0.75rem;font-family:'Poppins',sans-serif}
    .page-hero p{color:var(--leaf-green);font-size:1rem;margin:0 auto 1.5rem;max-width:700px}
    .hero-stats{display:flex;justify-content:center;gap:2rem;flex-wrap:wrap}
    .stat-item{text-align:center;background:rgba(255,255,255,0.1);padding:0.75rem 1.25rem;border-radius:var(--radius-md)}
    .stat-item .value{font-size:1.75rem;font-weight:800;color:#fff}
    .stat-item .label{font-size:0.75rem;color:var(--leaf-green);text-transform:uppercase;letter-spacing:0.05em}
    
    .container{max-width:1400px;margin:0 auto;padding:1.5rem}
    
    /* Filter Bar */
    .filter-bar{background:#fff;border-radius:var(--radius-lg);padding:1rem 1.25rem;box-shadow:var(--shadow-md);margin:-1.5rem auto 1.5rem;max-width:1000px;position:relative;z-index:10;display:flex;gap:0.75rem;flex-wrap:wrap;align-items:flex-end}
    .filter-group{flex:1;min-width:150px}
    .filter-group label{display:block;font-size:0.75rem;font-weight:600;color:var(--slate-gray);margin-bottom:0.3rem}
    .filter-select,.search-input{width:100%;padding:0.65rem 0.85rem;border:2px solid var(--rock-gray);border-radius:var(--radius-md);font-size:0.875rem;transition:var(--transition);background:#fff}
    .filter-select:focus,.search-input:focus{outline:none;border-color:var(--sage-green)}
    .clear-btn{padding:0.65rem 1rem;border:2px solid var(--rock-gray);border-radius:var(--radius-md);background:var(--pebble-gray);font-size:0.875rem;font-weight:600;cursor:pointer;color:var(--slate-gray);transition:var(--transition);white-space:nowrap}
    .clear-btn:hover{background:var(--rock-gray)}
    
    /* Category Pills */
    .category-pills{display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.5rem;justify-content:center}
    .cat-pill{padding:0.5rem 1rem;border-radius:var(--radius-full);background:#fff;border:2px solid var(--rock-gray);color:var(--slate-gray);font-size:0.8rem;font-weight:600;cursor:pointer;transition:var(--transition);display:inline-flex;align-items:center;gap:0.35rem}
    .cat-pill:hover,.cat-pill.active{background:var(--sage-green);color:#fff;border-color:var(--sage-green)}
    .cat-pill i{font-size:0.9rem}
    
    /* Gallery Grid */
    .gallery-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.25rem}
    
    /* Gallery Card */
    .gallery-card{background:#fff;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm);border:1px solid var(--rock-gray);transition:var(--transition);cursor:pointer}
    .gallery-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg);border-color:var(--sage-green)}
    .card-thumb{height:200px;background:linear-gradient(135deg,var(--sage-green),var(--mint-green));position:relative;overflow:hidden}
    .card-thumb img{width:100%;height:100%;object-fit:cover;transition:transform 0.4s}
    .gallery-card:hover .card-thumb img{transform:scale(1.08)}
    .card-thumb .placeholder{display:flex;align-items:center;justify-content:center;height:100%;color:#fff;font-size:3rem;opacity:0.7}
    .media-badge{position:absolute;top:0.75rem;left:0.75rem;background:rgba(0,0,0,0.7);color:#fff;padding:0.3rem 0.65rem;border-radius:var(--radius-md);font-size:0.7rem;font-weight:600;display:flex;align-items:center;gap:0.3rem}
    .cat-badge{position:absolute;top:0.75rem;right:0.75rem;background:linear-gradient(135deg,#D4AF37,#FFD700);color:#fff;padding:0.3rem 0.65rem;border-radius:var(--radius-md);font-size:0.65rem;font-weight:700;text-transform:uppercase}
    .card-overlay{position:absolute;inset:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.3s}
    .gallery-card:hover .card-overlay{opacity:1}
    .overlay-icon{width:55px;height:55px;background:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.25rem;color:var(--sage-green)}
    .card-body{padding:1rem}
    .card-title{font-size:1rem;font-weight:700;color:var(--forest-green);margin:0 0 0.5rem;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .card-meta{display:flex;align-items:center;gap:0.4rem;color:var(--slate-gray);font-size:0.8rem;margin-bottom:0.25rem}
    .card-meta i{color:var(--sage-green);width:14px}
    .card-desc{color:var(--slate-gray);font-size:0.85rem;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin:0.5rem 0}
    .card-tags{display:flex;flex-wrap:wrap;gap:0.25rem;margin-top:0.75rem}
    .card-tags span{background:var(--pebble-gray);color:var(--slate-gray);padding:0.2rem 0.5rem;border-radius:var(--radius-sm);font-size:0.7rem}
    
    /* Modal */
    .modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.9);z-index:2000;overflow-y:auto;padding:1rem}
    .modal.active{display:flex;align-items:center;justify-content:center}
    .modal-box{background:#fff;border-radius:var(--radius-lg);max-width:900px;width:100%;max-height:90vh;overflow-y:auto;position:relative}
    .modal-close{position:absolute;top:0.75rem;right:0.75rem;width:38px;height:38px;background:rgba(0,0,0,0.6);color:#fff;border:none;border-radius:50%;font-size:1.1rem;cursor:pointer;z-index:10;transition:var(--transition)}
    .modal-close:hover{background:rgba(0,0,0,0.8)}
    .modal-media{background:#111;min-height:250px;display:flex;align-items:center;justify-content:center}
    .modal-media img{max-width:100%;max-height:450px;object-fit:contain}
    .modal-media video,.modal-media audio{width:100%;max-height:450px}
    .modal-media iframe{width:100%;height:380px;border:none}
    .modal-body{padding:1.5rem}
    .modal-title{font-size:1.35rem;font-weight:700;color:var(--forest-green);margin:0 0 1rem}
    .modal-meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:0.75rem;padding:1rem;background:var(--pebble-gray);border-radius:var(--radius-md);margin-bottom:1rem}
    .meta-item{display:flex;align-items:flex-start;gap:0.5rem}
    .meta-item i{color:var(--sage-green);margin-top:0.15rem}
    .meta-item .lbl{font-size:0.7rem;color:var(--slate-gray)}
    .meta-item .val{font-size:0.875rem;font-weight:600;color:var(--forest-green)}
    .modal-desc{color:var(--slate-gray);line-height:1.7;font-size:0.9rem}
    .modal-transcript{background:var(--pebble-gray);padding:1rem;border-radius:var(--radius-md);margin-top:1rem}
    .modal-transcript h4{font-size:0.9rem;color:var(--forest-green);margin:0 0 0.5rem}
    .modal-transcript p{color:var(--slate-gray);font-style:italic;font-size:0.875rem;margin:0}
    
    /* Empty */
    .empty-state{text-align:center;padding:4rem 2rem;background:#fff;border-radius:var(--radius-lg);grid-column:1/-1}
    .empty-state i{font-size:4rem;color:var(--rock-gray);margin-bottom:1rem}
    .empty-state h3{color:var(--forest-green);margin:0 0 0.5rem}
    .empty-state p{color:var(--slate-gray);margin:0}
    
    /* Footer */
    .footer{background:var(--gradient-nature);color:#fff;padding:2rem;text-align:center;margin-top:3rem}
    .footer p{margin:0;opacity:0.9;font-size:0.9rem}
    
    /* Responsive */
    @media(max-width:900px){
      .page-hero{padding:2rem 1rem 2rem}
      .page-hero h1{font-size:1.75rem}
      .hero-stats{gap:1rem}
      .stat-item{padding:0.5rem 1rem}
      .stat-item .value{font-size:1.35rem}
      .filter-bar{margin:-1rem 1rem 1.25rem;flex-direction:column}
      .filter-group{width:100%}
      .container{padding:1rem}
    }
    @media(max-width:640px){
      .page-hero h1{font-size:1.5rem}
      .page-hero p{font-size:0.9rem}
      .hero-stats{gap:0.75rem}
      .stat-item{padding:0.4rem 0.75rem}
      .stat-item .value{font-size:1.15rem}
      .gallery-grid{grid-template-columns:1fr}
      .card-thumb{height:180px}
      .category-pills{justify-content:flex-start;overflow-x:auto;flex-wrap:nowrap;padding-bottom:0.5rem}
      .cat-pill{flex-shrink:0}
      .modal-box{margin:0.5rem;border-radius:var(--radius-md)}
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="logo">
        <img src="/uploads/logo.jpg" alt="HeritageLink"> HeritageLink
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
        <i class="fas fa-bars"></i>
      </button>
      <div class="nav-overlay" id="navOverlay"></div>
      <div class="nav-links" id="navLinks">
        <button class="nav-close" id="navClose" aria-label="Close menu">
          <i class="fas fa-times"></i>
        </button>
        <a href="/" class="nav-link"><i class="fas fa-home"></i> <span>Home</span></a>
        <a href="/destinations" class="nav-link"><i class="fas fa-map-marked-alt"></i> <span>Explore Map & Sites</span></a>
        <a href="/events" class="nav-link"><i class="fas fa-calendar-alt"></i> <span>Events</span></a>
        <a href="/heritage-gallery" class="nav-link" style="background:rgba(255,255,255,0.15);color:#fff"><i class="fas fa-landmark"></i> <span>Heritage Gallery</span></a>
        
        <a href="/showcase" class="nav-link"><i class="fas fa-palette"></i> <span>Artisans</span></a>
        <a href="/feedback" class="nav-link"><i class="fas fa-comment-dots"></i> <span>Feedback</span></a>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard" class="btn btn-primary">Dashboard</a>
        <% } else { %>
          <a href="/login" class="btn btn-secondary">Login</a>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="page-hero">
    <h1><i class="fas fa-landmark"></i> Heritage Gallery</h1>
    <p>Explore our digital archive of cultural treasures — photos, videos, oral histories & documents preserving the heritage of Gloria, Oriental Mindoro</p>
    <div class="hero-stats">
      <div class="stat-item"><div class="value"><%= stats.total %></div><div class="label">Total Items</div></div>
      <div class="stat-item"><div class="value"><%= stats.photos %></div><div class="label">Photos</div></div>
      <div class="stat-item"><div class="value"><%= stats.videos %></div><div class="label">Videos</div></div>
      <div class="stat-item"><div class="value"><%= stats.audio %></div><div class="label">Audio</div></div>
      <div class="stat-item"><div class="value"><%= stats.documents %></div><div class="label">Documents</div></div>
    </div>
  </section>

  <div class="container">
    <!-- Filter Bar -->
    <div class="filter-bar">
      <div class="filter-group">
        <label>Category</label>
        <select id="filterCategory" class="filter-select" onchange="applyFilters()">
          <option value="">All Categories</option>
          <option value="traditional_crafts">Traditional Crafts</option>
          <option value="festivals">Festivals</option>
          <option value="oral_history">Oral History</option>
          <option value="historical_photos">Historical Photos</option>
          <option value="traditional_music">Traditional Music</option>
          <option value="dance">Dance</option>
          <option value="cuisine">Cuisine</option>
          <option value="architecture">Architecture</option>
        </select>
      </div>
      <div class="filter-group">
        <label>Media Type</label>
        <select id="filterMedia" class="filter-select" onchange="applyFilters()">
          <option value="">All Types</option>
          <option value="photo">Photos</option>
          <option value="video">Videos</option>
          <option value="audio">Audio</option>
          <option value="document">Documents</option>
        </select>
      </div>
      <div class="filter-group">
        <label>Search</label>
        <input type="text" id="searchInput" class="search-input" placeholder="Search..." onkeyup="applyFilters()">
      </div>
      <button class="clear-btn" onclick="clearFilters()"><i class="fas fa-times"></i> Clear</button>
    </div>

    <!-- Category Pills -->
    <div class="category-pills">
      <span class="cat-pill active" data-category="" onclick="selectCategory(this)"><i class="fas fa-th"></i> All</span>
      <span class="cat-pill" data-category="traditional_crafts" onclick="selectCategory(this)"><i class="fas fa-hands"></i> Crafts</span>
      <span class="cat-pill" data-category="festivals" onclick="selectCategory(this)"><i class="fas fa-mask"></i> Festivals</span>
      <span class="cat-pill" data-category="oral_history" onclick="selectCategory(this)"><i class="fas fa-microphone"></i> Oral History</span>
      <span class="cat-pill" data-category="dance" onclick="selectCategory(this)"><i class="fas fa-music"></i> Dance</span>
      <span class="cat-pill" data-category="cuisine" onclick="selectCategory(this)"><i class="fas fa-utensils"></i> Cuisine</span>
      <span class="cat-pill" data-category="architecture" onclick="selectCategory(this)"><i class="fas fa-building"></i> Architecture</span>
    </div>

    <!-- Gallery Grid -->
    <div class="gallery-grid" id="galleryGrid">
      <% if (items && items.length > 0) { %>
        <% items.forEach(item => { %>
          <div class="gallery-card" 
               data-id="<%= item.id %>"
               data-category="<%= item.category %>" 
               data-media="<%= item.media_type %>" 
               data-title="<%= item.title.toLowerCase() %>"
               data-tags="<%= item.tags ? item.tags.toLowerCase() : '' %>"
               onclick='openModal(<%- JSON.stringify(item) %>)'>
            <div class="card-thumb">
              <% if (item.thumbnail_url || item.media_type === 'photo') { %>
                <img src="<%= item.thumbnail_url || item.media_url %>" alt="<%= item.title %>" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                <div class="placeholder" style="display:none"><i class="fas fa-image"></i></div>
              <% } else { %>
                <div class="placeholder">
                  <% if (item.media_type === 'video') { %><i class="fas fa-video"></i>
                  <% } else if (item.media_type === 'audio') { %><i class="fas fa-microphone"></i>
                  <% } else { %><i class="fas fa-file-alt"></i><% } %>
                </div>
              <% } %>
              <span class="media-badge">
                <% if (item.media_type === 'photo') { %><i class="fas fa-camera"></i> Photo
                <% } else if (item.media_type === 'video') { %><i class="fas fa-video"></i> Video
                <% } else if (item.media_type === 'audio') { %><i class="fas fa-microphone"></i> Audio
                <% } else { %><i class="fas fa-file-alt"></i> Doc<% } %>
              </span>
              <span class="cat-badge"><%= item.category ? item.category.replace(/_/g, ' ') : 'Other' %></span>
              <div class="card-overlay">
                <div class="overlay-icon">
                  <% if (item.media_type === 'photo') { %><i class="fas fa-search-plus"></i>
                  <% } else if (item.media_type === 'video') { %><i class="fas fa-play"></i>
                  <% } else if (item.media_type === 'audio') { %><i class="fas fa-headphones"></i>
                  <% } else { %><i class="fas fa-eye"></i><% } %>
                </div>
              </div>
            </div>
            <div class="card-body">
              <h3 class="card-title"><%= item.title %></h3>
              <% if (item.historical_date) { %><div class="card-meta"><i class="fas fa-clock"></i> <%= item.historical_date %></div><% } %>
              <% if (item.location) { %><div class="card-meta"><i class="fas fa-map-marker-alt"></i> <%= item.location %></div><% } %>
              <p class="card-desc"><%= item.description || 'No description available' %></p>
              <% if (item.tags) { %>
                <div class="card-tags">
                  <% item.tags.split(',').slice(0, 3).forEach(tag => { %><span>#<%= tag.trim() %></span><% }); %>
                </div>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="empty-state">
          <i class="fas fa-landmark"></i>
          <h3>No Heritage Items Found</h3>
          <p>Check back soon as we continue to build our digital archive.</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Modal -->
  <div class="modal" id="itemModal">
    <div class="modal-box">
      <button class="modal-close" onclick="closeModal()"><i class="fas fa-times"></i></button>
      <div class="modal-media" id="modalMedia"></div>
      <div class="modal-body">
        <h2 class="modal-title" id="modalTitle"></h2>
        <div class="modal-meta" id="modalMeta"></div>
        <p class="modal-desc" id="modalDesc"></p>
        <div class="modal-transcript" id="modalTranscript" style="display:none">
          <h4><i class="fas fa-file-alt"></i> Transcript</h4>
          <p id="transcriptText"></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="footer">
    <p>&copy; 2024 HeritageLink - Preserving the Cultural Heritage of Gloria, Oriental Mindoro</p>
  </footer>

  <script>
    // Mobile nav
    (function(){
      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navLinks');
      const overlay = document.getElementById('navOverlay');
      const close = document.getElementById('navClose');
      function openMenu() { links.classList.add('active'); overlay.classList.add('active'); document.body.style.overflow = 'hidden'; }
      function closeMenu() { links.classList.remove('active'); overlay.classList.remove('active'); document.body.style.overflow = ''; }
      if(toggle) toggle.addEventListener('click', openMenu);
      if(close) close.addEventListener('click', closeMenu);
      if(overlay) overlay.addEventListener('click', closeMenu);
    })();

    function applyFilters() {
      const category = document.getElementById('filterCategory').value.toLowerCase();
      const media = document.getElementById('filterMedia').value.toLowerCase();
      const search = document.getElementById('searchInput').value.toLowerCase();
      document.querySelectorAll('.gallery-card').forEach(item => {
        const cat = item.dataset.category || '';
        const med = item.dataset.media || '';
        const title = item.dataset.title || '';
        const tags = item.dataset.tags || '';
        const matchCat = !category || cat === category;
        const matchMed = !media || med === media;
        const matchSearch = !search || title.includes(search) || tags.includes(search);
        item.style.display = (matchCat && matchMed && matchSearch) ? '' : 'none';
      });
      document.querySelectorAll('.cat-pill').forEach(p => p.classList.toggle('active', p.dataset.category === category));
    }

    function selectCategory(pill) {
      document.getElementById('filterCategory').value = pill.dataset.category;
      applyFilters();
    }

    function clearFilters() {
      document.getElementById('filterCategory').value = '';
      document.getElementById('filterMedia').value = '';
      document.getElementById('searchInput').value = '';
      applyFilters();
    }

    function openModal(item) {
      const modal = document.getElementById('itemModal');
      const media = document.getElementById('modalMedia');
      document.getElementById('modalTitle').textContent = item.title;

      if (item.media_type === 'photo') {
        media.innerHTML = `<img src="${item.media_url}" alt="${item.title}">`;
      } else if (item.media_type === 'video') {
        if (item.media_url.includes('youtube') || item.media_url.includes('vimeo')) {
          media.innerHTML = `<iframe src="${item.media_url}" allowfullscreen></iframe>`;
        } else {
          media.innerHTML = `<video src="${item.media_url}" controls></video>`;
        }
      } else if (item.media_type === 'audio') {
        media.innerHTML = `<div style="padding:2rem;text-align:center;width:100%"><i class="fas fa-microphone" style="font-size:3rem;color:#fff;margin-bottom:1rem"></i><audio src="${item.media_url}" controls style="width:100%;max-width:400px"></audio></div>`;
      } else {
        media.innerHTML = `<div style="padding:2rem;text-align:center"><i class="fas fa-file-pdf" style="font-size:3rem;color:#fff;margin-bottom:1rem"></i><p><a href="${item.media_url}" target="_blank" style="color:#fff;text-decoration:underline">Open Document</a></p></div>`;
      }

      let metaHTML = '';
      if (item.category) metaHTML += `<div class="meta-item"><i class="fas fa-folder"></i><div><div class="lbl">Category</div><div class="val">${item.category.replace(/_/g,' ')}</div></div></div>`;
      if (item.historical_date) metaHTML += `<div class="meta-item"><i class="fas fa-clock"></i><div><div class="lbl">Date/Era</div><div class="val">${item.historical_date}</div></div></div>`;
      if (item.location) metaHTML += `<div class="meta-item"><i class="fas fa-map-marker-alt"></i><div><div class="lbl">Location</div><div class="val">${item.location}</div></div></div>`;
      if (item.contributor_name) metaHTML += `<div class="meta-item"><i class="fas fa-user"></i><div><div class="lbl">Contributor</div><div class="val">${item.contributor_name}</div></div></div>`;
      if (item.source) metaHTML += `<div class="meta-item"><i class="fas fa-archive"></i><div><div class="lbl">Source</div><div class="val">${item.source}</div></div></div>`;
      document.getElementById('modalMeta').innerHTML = metaHTML;
      document.getElementById('modalDesc').textContent = item.description || 'No description available.';

      const transcriptDiv = document.getElementById('modalTranscript');
      if (item.transcript) {
        transcriptDiv.style.display = 'block';
        document.getElementById('transcriptText').textContent = item.transcript;
      } else {
        transcriptDiv.style.display = 'none';
      }

      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      document.getElementById('itemModal').classList.remove('active');
      document.body.style.overflow = '';
      const m = document.querySelector('#modalMedia video, #modalMedia audio');
      if (m) m.pause();
    }

    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
    document.getElementById('itemModal').addEventListener('click', e => { if (e.target.id === 'itemModal') closeModal(); });
  </script>
</body>
</html>
