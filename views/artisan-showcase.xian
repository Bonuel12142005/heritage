<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - HeritageLink</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="stylesheet" href="/css/heritagelink-unified.css">
  <style>
    html,body{overflow-x:clip;max-width:100vw}

    /* Hero */
    .showcase-hero{background:var(--gradient-nature);padding:3rem 1.5rem 2.5rem;text-align:center;position:relative}
    .showcase-hero::after{content:'';position:absolute;bottom:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#D4AF37,#FFD700,#D4AF37)}
    .showcase-hero h1{color:#fff;font-size:2.5rem;font-weight:800;margin:0 0 0.75rem;font-family:'Poppins',sans-serif;display:flex;align-items:center;justify-content:center;gap:0.75rem}
    .showcase-hero p{color:var(--leaf-green);font-size:1.05rem;margin:0 auto 1.5rem;max-width:700px;line-height:1.6}

    /* Tabs */
    .tab-bar{display:flex;justify-content:center;gap:0.5rem;flex-wrap:wrap;padding-bottom:1.5rem}
    .tab-btn{display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.75rem;border-radius:var(--radius-md);font-weight:700;font-size:0.95rem;cursor:pointer;border:2px solid rgba(255,255,255,0.3);background:rgba(255,255,255,0.15);color:#fff;transition:var(--transition)}
    .tab-btn:hover{background:rgba(255,255,255,0.25)}
    .tab-btn.active{background:#fff;color:var(--forest-green);border-color:#fff;box-shadow:0 4px 15px rgba(0,0,0,0.15)}

    .container{max-width:1400px;margin:0 auto;padding:2rem 1.5rem}

    /* Tab Panels */
    .tab-panel{display:none}
    .tab-panel.active{display:block}

    /* Section Header */
    .section-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem}
    .section-title{font-size:1.5rem;font-weight:800;color:var(--forest-green);display:flex;align-items:center;gap:0.5rem;margin:0}
    .section-title i{color:var(--textile-orange)}
    .view-all{color:var(--sage-green);text-decoration:none;font-weight:600;display:flex;align-items:center;gap:0.35rem;font-size:0.9rem}
    .view-all:hover{color:var(--forest-green);text-decoration:underline}

    /* Artisan Grid */
    .artisan-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.5rem;margin-bottom:3rem}
    .artisan-card{background:#fff;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm);border:1px solid var(--rock-gray);transition:var(--transition)}
    .artisan-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg);border-color:var(--sage-green)}
    .artisan-header{background:var(--gradient-nature);padding:1.75rem;text-align:center}
    .artisan-avatar{width:90px;height:90px;border-radius:50%;background:#fff;margin:0 auto;display:flex;align-items:center;justify-content:center;font-size:2.25rem;color:var(--sage-green);border:4px solid rgba(255,255,255,0.4);overflow:hidden}
    .artisan-avatar img{width:100%;height:100%;object-fit:cover}
    .artisan-body{padding:1.25rem;text-align:center}
    .artisan-name{font-size:1.15rem;font-weight:700;color:var(--forest-green);margin-bottom:0.35rem}
    .artisan-specialty{color:var(--textile-orange);font-weight:700;font-size:0.85rem;margin-bottom:0.75rem}
    .artisan-bio{color:var(--slate-gray);font-size:0.875rem;line-height:1.6;margin-bottom:1rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .artisan-stats{display:flex;justify-content:center;gap:1.5rem;margin-bottom:1rem}
    .artisan-stat .val{font-size:1.15rem;font-weight:800;color:var(--sage-green)}
    .artisan-stat .lbl{font-size:0.7rem;color:var(--slate-gray);text-transform:uppercase}
    .artisan-actions{display:flex;gap:0.5rem;justify-content:center}
    .btn-card{padding:0.5rem 1rem;border-radius:var(--radius-md);font-size:0.8rem;font-weight:600;text-decoration:none;transition:var(--transition);display:inline-flex;align-items:center;gap:0.35rem;border:none;cursor:pointer}
    .btn-card:hover{transform:translateY(-2px)}
    .btn-orange{background:linear-gradient(135deg,#D4AF37,#FFD700);color:#fff}
    .btn-outline{background:#fff;color:var(--forest-green);border:1px solid var(--rock-gray)}
    .btn-outline:hover{background:var(--leaf-green)}

    /* Product Grid */
    .product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1.5rem;margin-bottom:3rem}
    .product-card{background:#fff;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm);border:1px solid var(--rock-gray);transition:var(--transition)}
    .product-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg);border-color:var(--sage-green)}
    .product-img{height:180px;background:linear-gradient(135deg,var(--leaf-green),var(--pebble-gray));position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}
    .product-img img{width:100%;height:100%;object-fit:cover;transition:transform 0.4s}
    .product-card:hover .product-img img{transform:scale(1.08)}
    .product-img .placeholder{font-size:3.5rem;color:var(--sage-green);opacity:0.5}
    .product-badge{position:absolute;top:0.75rem;left:0.75rem;background:linear-gradient(135deg,#D4AF37,#FFD700);color:#fff;padding:0.3rem 0.7rem;border-radius:var(--radius-md);font-size:0.7rem;font-weight:700;text-transform:uppercase}
    .product-body{padding:1.25rem}
    .product-cat{font-size:0.7rem;color:var(--textile-orange);font-weight:700;text-transform:uppercase;letter-spacing:0.03em;margin-bottom:0.35rem}
    .product-name{font-size:1.05rem;font-weight:700;color:var(--forest-green);margin-bottom:0.5rem;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .product-artisan{font-size:0.8rem;color:var(--slate-gray);margin-bottom:0.75rem;display:flex;align-items:center;gap:0.35rem}
    .product-artisan i{color:var(--sage-green)}
    .product-footer{display:flex;justify-content:space-between;align-items:center}
    .product-price{font-size:1.2rem;font-weight:800;color:var(--sage-green)}
    .product-rating{font-size:0.85rem;color:#f59e0b}

    /* Category Grid */
    .category-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:1rem}
    .category-card{background:#fff;border-radius:var(--radius-lg);padding:1.5rem 1rem;text-align:center;border:2px solid var(--rock-gray);transition:var(--transition);cursor:pointer;text-decoration:none}
    .category-card:hover{border-color:var(--sage-green);background:var(--leaf-green);transform:translateY(-4px)}
    .category-icon{width:55px;height:55px;background:var(--gradient-nature);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 0.85rem;color:#fff;font-size:1.35rem}
    .category-card:hover .category-icon{background:linear-gradient(135deg,#D4AF37,#FFD700)}
    .category-name{font-weight:700;color:var(--forest-green);font-size:0.9rem}
    .category-count{font-size:0.75rem;color:var(--slate-gray);margin-top:0.25rem}

    /* Workshops tab */
    .workshop-filter-bar{background:#fff;border-radius:var(--radius-lg);padding:1rem 1.25rem;box-shadow:var(--shadow-md);margin-bottom:1.5rem;display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center}
    .search-box{flex:1;min-width:200px;position:relative}
    .search-box i{position:absolute;left:1rem;top:50%;transform:translateY(-50%);color:var(--slate-gray)}
    .search-input{width:100%;padding:0.7rem 1rem 0.7rem 2.5rem;border:2px solid var(--rock-gray);border-radius:var(--radius-md);font-size:0.9rem;transition:var(--transition)}
    .search-input:focus{outline:none;border-color:var(--sage-green);box-shadow:0 0 0 3px rgba(45,134,89,0.1)}
    .filter-select{padding:0.7rem 1rem;border:2px solid var(--rock-gray);border-radius:var(--radius-md);font-size:0.9rem;background:#fff;min-width:140px;cursor:pointer;transition:var(--transition)}
    .filter-select:focus{outline:none;border-color:var(--sage-green)}
    .results-info{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:0.5rem}
    .results-count{font-size:0.9rem;color:var(--slate-gray)}
    .results-count strong{color:var(--forest-green)}
    .workshops-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1.5rem}
    .workshop-card{background:#fff;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm);border:1px solid var(--rock-gray);transition:var(--transition);display:flex;flex-direction:column}
    .workshop-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg);border-color:var(--sage-green)}
    .workshop-img{height:180px;background:linear-gradient(135deg,var(--sage-green),var(--forest-green));position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}
    .workshop-img img{width:100%;height:100%;object-fit:cover}
    .workshop-img .no-img{color:rgba(255,255,255,0.7);font-size:3rem}
    .workshop-status{position:absolute;top:0.75rem;right:0.75rem;padding:0.3rem 0.75rem;border-radius:var(--radius-full);font-size:0.7rem;font-weight:700;text-transform:uppercase}
    .status-upcoming{background:#fef3c7;color:#92400e}
    .status-ongoing{background:#dbeafe;color:#1e40af}
    .status-completed{background:#d1fae5;color:#065f46}
    .workshop-body{padding:1.25rem;display:flex;flex-direction:column;flex:1}
    .workshop-title{font-size:1.15rem;font-weight:700;color:var(--forest-green);margin:0 0 0.5rem;line-height:1.3}
    .workshop-artisan{font-size:0.85rem;color:var(--slate-gray);margin-bottom:0.75rem;display:flex;align-items:center;gap:0.4rem}
    .workshop-artisan i{color:var(--sage-green)}
    .workshop-meta{display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;margin-bottom:0.75rem}
    .meta-item{display:flex;align-items:center;gap:0.4rem;font-size:0.8rem;color:var(--slate-gray)}
    .meta-item i{color:var(--sage-green);width:14px}
    .workshop-desc{font-size:0.85rem;color:var(--slate-gray);line-height:1.5;flex:1;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:0.75rem}
    .workshop-footer{display:flex;justify-content:space-between;align-items:center;padding-top:0.75rem;border-top:1px solid var(--rock-gray)}
    .workshop-price{font-size:1.25rem;font-weight:800;color:var(--forest-green)}
    .workshop-price.free{color:var(--sage-green)}
    .workshop-capacity{display:flex;align-items:center;gap:0.5rem}
    .capacity-bar{width:60px;height:6px;background:var(--rock-gray);border-radius:3px;overflow:hidden}
    .capacity-fill{height:100%;background:var(--sage-green);border-radius:3px}
    .capacity-text{font-size:0.75rem;color:var(--slate-gray)}
    .btn-view{background:var(--gradient-nature);color:#fff;padding:0.6rem 1.25rem;border-radius:var(--radius-md);font-size:0.85rem;font-weight:600;display:inline-flex;align-items:center;gap:0.4rem;transition:var(--transition);border:none;cursor:pointer;margin-top:0.75rem}
    .btn-view:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(45,134,89,0.3)}
    .loading{text-align:center;padding:3rem;grid-column:1/-1;color:var(--slate-gray)}
    .loading i{font-size:2rem;color:var(--sage-green)}

    /* Modal */
    .modal{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:1rem}
    .modal-overlay{position:absolute;inset:0;background:rgba(0,0,0,0.6);backdrop-filter:blur(4px)}
    .modal-content{position:relative;background:#fff;border-radius:var(--radius-lg);max-width:700px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,0.3)}
    .modal-close{position:absolute;top:1rem;right:1rem;background:var(--rock-gray);border:none;width:36px;height:36px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:10;transition:var(--transition)}
    .modal-close:hover{background:var(--slate-gray);color:#fff}
    .modal-header{padding:1.5rem;border-bottom:1px solid var(--rock-gray)}
    .modal-header h2{font-size:1.5rem;font-weight:700;color:var(--forest-green);margin:0 0 0.5rem}
    .modal-body{padding:1.5rem}
    .modal-map{height:250px;border-radius:var(--radius-md);margin:1rem 0;border:2px solid var(--rock-gray)}
    .detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem}
    .detail-item{display:flex;align-items:flex-start;gap:0.5rem}
    .detail-item i{color:var(--sage-green);margin-top:0.2rem}
    .detail-item label{font-weight:600;color:var(--forest-green);display:block;font-size:0.8rem}
    .detail-item span{color:var(--slate-gray);font-size:0.9rem}
    .btn-register{background:linear-gradient(135deg,#D4AF37,#FFD700);color:#fff;padding:0.85rem 2rem;border-radius:var(--radius-md);font-size:1rem;font-weight:700;border:none;cursor:pointer;width:100%;margin-top:1rem;transition:var(--transition)}
    .btn-register:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(212,175,55,0.4)}
    .btn-register:disabled{background:var(--rock-gray);cursor:not-allowed;transform:none;box-shadow:none}

    /* Empty State */
    .empty-state{text-align:center;padding:3rem 2rem;background:#fff;border-radius:var(--radius-lg);border:1px solid var(--rock-gray);grid-column:1/-1}
    .empty-state i{font-size:3rem;color:var(--rock-gray);margin-bottom:0.75rem}
    .empty-state h3{color:var(--forest-green);margin:0 0 0.35rem;font-size:1.1rem}
    .empty-state p{color:var(--slate-gray);margin:0;font-size:0.9rem}

    @media(max-width:900px){
      .showcase-hero{padding:2.5rem 1rem 2rem}
      .showcase-hero h1{font-size:2rem}
      .container{padding:1.5rem 1rem}
      .artisan-grid,.product-grid,.workshops-grid{grid-template-columns:repeat(auto-fill,minmax(280px,1fr))}
    }
    @media(max-width:640px){
      .showcase-hero h1{font-size:1.65rem;flex-direction:column;gap:0.5rem}
      .tab-btn{padding:0.6rem 1.25rem;font-size:0.875rem}
      .artisan-grid,.product-grid,.workshops-grid{grid-template-columns:1fr}
      .category-grid{grid-template-columns:repeat(2,1fr)}
      .section-header{flex-direction:column;align-items:flex-start}
      .workshop-filter-bar{flex-direction:column}
      .search-box,.filter-select{width:100%}
      .detail-grid{grid-template-columns:1fr}
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="logo">
        <img src="/uploads/logo.jpg" alt="HeritageLink"> HeritageLink
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
        <i class="fas fa-bars"></i>
      </button>
      <div class="nav-overlay" id="navOverlay"></div>
      <div class="nav-links" id="navLinks">
        <button class="nav-close" id="navClose" aria-label="Close menu">
          <i class="fas fa-times"></i>
        </button>
        <a href="/" class="nav-link"><i class="fas fa-home"></i> <span>Home</span></a>
        <a href="/destinations" class="nav-link"><i class="fas fa-map-marked-alt"></i> <span>Explore Map &amp; Sites</span></a>
        <a href="/events" class="nav-link"><i class="fas fa-calendar-alt"></i> <span>Events</span></a>
        <a href="/heritage-gallery" class="nav-link"><i class="fas fa-landmark"></i> <span>Heritage Gallery</span></a>
        <a href="/showcase" class="nav-link" style="background:rgba(255,255,255,0.15);color:#fff"><i class="fas fa-palette"></i> <span>Artisans</span></a>
        <a href="/feedback" class="nav-link"><i class="fas fa-comment-alt"></i> <span>Feedback</span></a>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard" class="btn btn-primary">Dashboard</a>
        <% } else { %>
          <a href="/login" class="btn btn-secondary">Login</a>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="showcase-hero">
    <h1><i class="fas fa-hands"></i> Local Artisans &amp; Workshops</h1>
    <p>Discover the skilled artisans of Gloria, Oriental Mindoro — explore their handmade products and join their craft workshops.</p>
    <div class="tab-bar">
      <button class="tab-btn active" onclick="switchTab('artisans', this)" id="tab-artisans">
        <i class="fas fa-users"></i> Artisans &amp; Products
      </button>
      <button class="tab-btn" onclick="switchTab('workshops', this)" id="tab-workshops">
        <i class="fas fa-chalkboard-teacher"></i> Workshops
      </button>
    </div>
  </section>

  <div class="container">

    <!-- ===== ARTISANS TAB ===== -->
    <div class="tab-panel active" id="panel-artisans">
      <!-- Featured Artisans -->
      <div class="section-header">
        <h2 class="section-title"><i class="fas fa-star"></i> Featured Artisans</h2>
        <a href="/showcase/artisans" class="view-all">View All Artisans <i class="fas fa-arrow-right"></i></a>
      </div>
      <div class="artisan-grid" id="artisanGrid"></div>

      <!-- Featured Products -->
      <div class="section-header">
        <h2 class="section-title"><i class="fas fa-gem"></i> Handcrafted Products</h2>
        <a href="/showcase/products" class="view-all">View All Products <i class="fas fa-arrow-right"></i></a>
      </div>
      <div class="product-grid" id="productGrid"></div>

      <!-- Categories -->
      <div class="section-header">
        <h2 class="section-title"><i class="fas fa-th-large"></i> Shop by Category</h2>
      </div>
      <div class="category-grid" id="categoryGrid"></div>
    </div>

    <!-- ===== WORKSHOPS TAB ===== -->
    <div class="tab-panel" id="panel-workshops">
      <div class="workshop-filter-bar">
        <div class="search-box">
          <i class="fas fa-search"></i>
          <input type="text" id="searchInput" class="search-input" placeholder="Search workshops...">
        </div>
        <select id="statusFilter" class="filter-select">
          <option value="">All Active</option>
          <option value="upcoming">🟢 Upcoming</option>
          <option value="ongoing">🔵 Ongoing</option>
        </select>
        <select id="priceFilter" class="filter-select">
          <option value="">All Prices</option>
          <option value="free">Free</option>
          <option value="paid">Paid</option>
        </select>
      </div>
      <div class="results-info">
        <div class="results-count" id="resultsCount">Loading workshops...</div>
      </div>
      <div id="workshopsGrid" class="workshops-grid">
        <div class="loading"><i class="fas fa-spinner fa-spin"></i> Loading workshops...</div>
      </div>
    </div>

  </div>

  <!-- Workshop Detail Modal -->
  <div id="workshopModal" class="modal" style="display:none;">
    <div class="modal-overlay" onclick="closeModal()"></div>
    <div class="modal-content">
      <button class="modal-close" onclick="closeModal()"><i class="fas fa-times"></i></button>
      <div id="modalBody"></div>
    </div>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    const ARTISANS = <%- JSON.stringify(featuredArtisans || []) %>;
    const PRODUCTS = <%- JSON.stringify(featuredProducts || []) %>;
    const CATEGORIES = <%- JSON.stringify(categories || []) %>;
    const IS_LOGGED_IN = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;
  </script>
  <script>
    // Mobile nav
    (function(){
      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navLinks');
      const overlay = document.getElementById('navOverlay');
      const close = document.getElementById('navClose');
      function openMenu() { links.classList.add('active'); overlay.classList.add('active'); document.body.style.overflow = 'hidden'; }
      function closeMenu() { links.classList.remove('active'); overlay.classList.remove('active'); document.body.style.overflow = ''; }
      if(toggle) toggle.addEventListener('click', openMenu);
      if(close) close.addEventListener('click', closeMenu);
      if(overlay) overlay.addEventListener('click', closeMenu);
    })();

    // Tab switching
    function switchTab(tab, btn) {
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('panel-' + tab).classList.add('active');
      btn.classList.add('active');
      if (tab === 'workshops' && !workshopsLoaded) loadWorkshops();
    }

    function escapeHtml(str) {
      return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ===== ARTISANS TAB =====
    function renderArtisans() {
      const grid = document.getElementById('artisanGrid');
      if (!ARTISANS || ARTISANS.length === 0) {
        grid.innerHTML = `<div class="empty-state"><i class="fas fa-users"></i><h3>No Artisans Yet</h3><p>Check back soon to meet our talented artisans.</p></div>`;
        return;
      }
      grid.innerHTML = ARTISANS.slice(0, 6).map(a => {
        const name = a.name || 'Artisan';
        const specialty = a.specialization || a.specialty || 'Handcrafts';
        const bio = a.bio || 'Traditional craftsman from Gloria';
        const products = a.product_count || 0;
        const initial = name.charAt(0).toUpperCase();
        const photo = a.profile_photo;
        return `
          <div class="artisan-card">
            <div class="artisan-header">
              <div class="artisan-avatar">
                ${photo ? `<img src="/${escapeHtml(photo)}" alt="${escapeHtml(name)}" onerror="this.style.display='none';this.parentElement.innerHTML='${initial}'">` : initial}
              </div>
            </div>
            <div class="artisan-body">
              <div class="artisan-name">${escapeHtml(name)}</div>
              <div class="artisan-specialty">${escapeHtml(specialty)}</div>
              <p class="artisan-bio">${escapeHtml(bio)}</p>
              <div class="artisan-stats">
                <div class="artisan-stat"><div class="val">${products}</div><div class="lbl">Products</div></div>
              </div>
              <div class="artisan-actions">
                <a href="/artisans/${a.id}" class="btn-card btn-orange"><i class="fas fa-eye"></i> View</a>
                <button class="btn-card btn-outline" onclick="messageArtisan(${a.id},'${escapeHtml(name)}')"><i class="fas fa-envelope"></i> Message</button>
              </div>
            </div>
          </div>`;
      }).join('');
    }

    function renderProducts() {
      const grid = document.getElementById('productGrid');
      if (!PRODUCTS || PRODUCTS.length === 0) {
        grid.innerHTML = `<div class="empty-state"><i class="fas fa-shopping-bag"></i><h3>No Products Yet</h3><p>Check back soon for handcrafted products.</p></div>`;
        return;
      }
      grid.innerHTML = PRODUCTS.slice(0, 8).map(p => {
        const name = p.name || p.title || 'Product';
        const price = p.price ? '₱' + Number(p.price).toFixed(2) : 'Contact';
        const category = p.category || 'Handcraft';
        const artisan = p.artisan_name || 'Local Artisan';
        const image = p.image_url || p.image;
        const rating = p.rating || null;
        return `
          <a href="/products/${p.id}" class="product-card" style="text-decoration:none">
            <div class="product-img">
              ${image ? `<img src="${escapeHtml(image)}" alt="${escapeHtml(name)}" onerror="this.style.display='none'">` : '<i class="fas fa-box-open placeholder"></i>'}
              ${p.featured ? '<span class="product-badge">Featured</span>' : ''}
            </div>
            <div class="product-body">
              <div class="product-cat">${escapeHtml(category)}</div>
              <div class="product-name">${escapeHtml(name)}</div>
              <div class="product-artisan"><i class="fas fa-user"></i> ${escapeHtml(artisan)}</div>
              <div class="product-footer">
                <span class="product-price">${price}</span>
                ${rating ? `<span class="product-rating"><i class="fas fa-star"></i> ${rating}</span>` : ''}
              </div>
            </div>
          </a>`;
      }).join('');
    }

    function renderCategories() {
      const grid = document.getElementById('categoryGrid');
      const defaultCats = [
        { name: 'Weaving', icon: 'fa-scroll', slug: 'weaving' },
        { name: 'Pottery', icon: 'fa-wine-bottle', slug: 'pottery' },
        { name: 'Woodcarving', icon: 'fa-tree', slug: 'woodcarving' },
        { name: 'Basketry', icon: 'fa-shopping-basket', slug: 'basketry' },
        { name: 'Embroidery', icon: 'fa-tshirt', slug: 'embroidery' },
        { name: 'Jewelry', icon: 'fa-gem', slug: 'jewelry' }
      ];
      const cats = CATEGORIES && CATEGORIES.length > 0 ? CATEGORIES : defaultCats;
      grid.innerHTML = cats.map(c => `
        <a href="/showcase/products?category=${c.slug || c.name.toLowerCase()}" class="category-card">
          <div class="category-icon"><i class="fas ${c.icon || 'fa-tag'}"></i></div>
          <div class="category-name">${escapeHtml(c.name)}</div>
          ${c.count ? `<div class="category-count">${c.count} items</div>` : ''}
        </a>`).join('');
    }

    function messageArtisan(id, name) {
      alert('Please login to message ' + name);
    }

    // ===== WORKSHOPS TAB =====
    let workshopsLoaded = false;
    let allWorkshops = [];
    let modalMap = null;

    function getWorkshopStatus(workshop) {
      if (workshop.status === 'ongoing') return 'ongoing';
      if (workshop.status === 'completed') return 'completed';
      if (workshop.status === 'cancelled') return 'cancelled';
      if (!workshop.workshop_date) return 'upcoming';
      const workshopDate = new Date(workshop.workshop_date);
      const today = new Date();
      today.setHours(0,0,0,0);
      workshopDate.setHours(0,0,0,0);
      if (isNaN(workshopDate.getTime())) return 'upcoming';
      if (workshopDate < today) return 'completed';
      if (workshopDate.getTime() === today.getTime()) return 'ongoing';
      return 'upcoming';
    }

    async function loadWorkshops() {
      workshopsLoaded = true;
      try {
        const res = await fetch('/api/workshops');
        const data = await res.json();
        allWorkshops = data.workshops || [];
        renderWorkshops(allWorkshops);
        attachFilters();
      } catch (err) {
        console.error('Error loading workshops:', err);
        document.getElementById('workshopsGrid').innerHTML = `<div class="empty-state"><i class="fas fa-exclamation-triangle"></i><h3>Error Loading Workshops</h3><p>Please try again later.</p></div>`;
      }
    }

    function renderWorkshops(workshops) {
      const grid = document.getElementById('workshopsGrid');
      const countEl = document.getElementById('resultsCount');
      countEl.innerHTML = `<strong>${workshops.length}</strong> workshop${workshops.length !== 1 ? 's' : ''} available`;
      if (!workshops || workshops.length === 0) {
        grid.innerHTML = `<div class="empty-state"><i class="fas fa-chalkboard-teacher"></i><h3>No Workshops Available</h3><p>Check back soon for upcoming craft workshops!</p></div>`;
        return;
      }
      grid.innerHTML = workshops.map(w => {
        const status = getWorkshopStatus(w);
        const capacityPercent = w.max_participants ? Math.round((w.current_participants || 0) / w.max_participants * 100) : 0;
        const isFull = w.max_participants && (w.current_participants || 0) >= w.max_participants;
        const price = parseFloat(w.fee) || 0;
        return `
          <div class="workshop-card" data-id="${w.id}" data-status="${status}" data-price="${price > 0 ? 'paid' : 'free'}">
            <div class="workshop-img">
              ${w.image_path ? `<img src="/${escapeHtml(w.image_path)}" alt="${escapeHtml(w.title)}" loading="lazy">` : '<i class="fas fa-chalkboard-teacher no-img"></i>'}
              <span class="workshop-status status-${status}">${status}</span>
            </div>
            <div class="workshop-body">
              <h3 class="workshop-title">${escapeHtml(w.title)}</h3>
              <div class="workshop-artisan"><i class="fas fa-user-circle"></i> ${escapeHtml(w.artisan_name || 'Local Artisan')}</div>
              <div class="workshop-meta">
                <div class="meta-item"><i class="fas fa-calendar"></i> ${w.workshop_date ? new Date(w.workshop_date).toLocaleDateString('en-PH', {month:'short',day:'numeric',year:'numeric'}) : 'TBD'}</div>
                <div class="meta-item"><i class="fas fa-clock"></i> ${escapeHtml(w.workshop_time) || 'TBD'}</div>
                <div class="meta-item"><i class="fas fa-map-marker-alt"></i> ${escapeHtml(w.location) || 'Gloria, Oriental Mindoro'}</div>
                <div class="meta-item"><i class="fas fa-hourglass-half"></i> ${escapeHtml(w.duration) || '2 hours'}</div>
              </div>
              <p class="workshop-desc">${escapeHtml(w.description) || 'Learn traditional crafts from local artisans.'}</p>
              <div class="workshop-footer">
                <div class="workshop-price ${price === 0 ? 'free' : ''}">${price > 0 ? '₱' + price.toLocaleString('en-PH') : 'FREE'}</div>
                <div class="workshop-capacity">
                  <div class="capacity-bar"><div class="capacity-fill" style="width:${capacityPercent}%"></div></div>
                  <span class="capacity-text">${w.current_participants || 0}/${w.max_participants || '∞'}</span>
                </div>
              </div>
              <button class="btn-view" onclick="viewWorkshop(${w.id})" ${isFull ? 'disabled' : ''}>${isFull ? 'Full' : 'View Details'}</button>
            </div>
          </div>`;
      }).join('');
    }

    function attachFilters() {
      const search = document.getElementById('searchInput');
      const statusFilter = document.getElementById('statusFilter');
      const priceFilter = document.getElementById('priceFilter');
      function applyFilters() {
        const q = (search.value || '').toLowerCase().trim();
        const status = statusFilter.value;
        const price = priceFilter.value;
        const filtered = allWorkshops.filter(w => {
          const wStatus = getWorkshopStatus(w);
          if (status && wStatus !== status) return false;
          const wPrice = parseFloat(w.fee) || 0;
          if (price === 'free' && wPrice > 0) return false;
          if (price === 'paid' && wPrice === 0) return false;
          if (!q) return true;
          return (w.title + ' ' + w.description + ' ' + w.location + ' ' + (w.artisan_name || '')).toLowerCase().includes(q);
        });
        renderWorkshops(filtered);
      }
      function debounce(fn, wait) { let t; return function(...a) { clearTimeout(t); t = setTimeout(() => fn.apply(this, a), wait); }; }
      search.addEventListener('input', debounce(applyFilters, 200));
      statusFilter.addEventListener('change', applyFilters);
      priceFilter.addEventListener('change', applyFilters);
    }

    function viewWorkshop(id) {
      const workshop = allWorkshops.find(w => w.id === id);
      if (!workshop) return;
      const status = getWorkshopStatus(workshop);
      const capacityPercent = workshop.max_participants ? Math.round((workshop.current_participants || 0) / workshop.max_participants * 100) : 0;
      const isFull = workshop.max_participants && (workshop.current_participants || 0) >= workshop.max_participants;
      const price = parseFloat(workshop.fee) || 0;
      document.getElementById('modalBody').innerHTML = `
        <div class="modal-header">
          <h2>${escapeHtml(workshop.title)}</h2>
          <div class="workshop-artisan"><i class="fas fa-user-circle"></i> Hosted by ${escapeHtml(workshop.artisan_name || 'Local Artisan')}</div>
        </div>
        <div class="modal-body">
          ${workshop.image_path ? `<img src="/${escapeHtml(workshop.image_path)}" alt="${escapeHtml(workshop.title)}" style="width:100%;height:200px;object-fit:cover;border-radius:var(--radius-md);margin-bottom:1rem;">` : ''}
          <p style="color:var(--slate-gray);line-height:1.6;margin-bottom:1.5rem;">${escapeHtml(workshop.description) || 'Learn traditional crafts from local artisans in Gloria, Oriental Mindoro.'}</p>
          <div class="detail-grid">
            <div class="detail-item"><i class="fas fa-calendar-alt"></i><div><label>Date</label><span>${workshop.workshop_date ? new Date(workshop.workshop_date).toLocaleDateString('en-PH', {weekday:'long',month:'long',day:'numeric',year:'numeric'}) : 'To be announced'}</span></div></div>
            <div class="detail-item"><i class="fas fa-clock"></i><div><label>Time</label><span>${escapeHtml(workshop.workshop_time) || 'To be announced'}</span></div></div>
            <div class="detail-item"><i class="fas fa-hourglass-half"></i><div><label>Duration</label><span>${escapeHtml(workshop.duration) || '2 hours'}</span></div></div>
            <div class="detail-item"><i class="fas fa-users"></i><div><label>Capacity</label><span>${workshop.current_participants || 0} / ${workshop.max_participants || '∞'} (${capacityPercent}% full)</span></div></div>
            <div class="detail-item"><i class="fas fa-map-marker-alt"></i><div><label>Location</label><span>${escapeHtml(workshop.location) || 'Gloria, Oriental Mindoro'}</span></div></div>
            <div class="detail-item"><i class="fas fa-tag"></i><div><label>Fee</label><span style="font-weight:700;color:var(--forest-green);font-size:1.1rem;">${price > 0 ? '₱' + price.toLocaleString('en-PH') : 'FREE'}</span></div></div>
          </div>
          ${workshop.latitude && workshop.longitude ? '<div id="modalMap" class="modal-map"></div>' : ''}
          ${isFull ? '<p style="text-align:center;color:#991b1b;font-weight:600;margin-top:1rem;"><i class="fas fa-exclamation-circle"></i> This workshop is fully booked</p>' : ''}
          ${!IS_LOGGED_IN ? '<p style="text-align:center;color:var(--slate-gray);margin-top:1rem;">Please <a href="/login" style="color:var(--sage-green);font-weight:600;">login</a> to register for this workshop.</p>' : ''}
          <button class="btn-register" onclick="registerWorkshop(${workshop.id})" ${isFull || !IS_LOGGED_IN ? 'disabled' : ''}>
            <i class="fas fa-check-circle"></i> ${isFull ? 'Workshop Full' : 'Register Now'}
          </button>
        </div>`;
      document.getElementById('workshopModal').style.display = 'flex';
      document.body.style.overflow = 'hidden';
      if (workshop.latitude && workshop.longitude) {
        setTimeout(() => {
          if (modalMap) { modalMap.remove(); modalMap = null; }
          modalMap = L.map('modalMap').setView([workshop.latitude, workshop.longitude], 15);
          L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', { attribution: '© OpenStreetMap' }).addTo(modalMap);
          L.marker([workshop.latitude, workshop.longitude]).addTo(modalMap)
            .bindPopup(`<strong>${escapeHtml(workshop.title)}</strong><br>${escapeHtml(workshop.location)}`).openPopup();
        }, 100);
      }
    }

    function closeModal() {
      document.getElementById('workshopModal').style.display = 'none';
      document.body.style.overflow = '';
      if (modalMap) { modalMap.remove(); modalMap = null; }
    }

    async function registerWorkshop(id) {
      if (!confirm('Are you sure you want to register for this workshop?')) return;
      try {
        const res = await fetch(`/api/workshops/${id}/register`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          alert('Successfully registered! You will receive a confirmation.');
          closeModal();
          loadWorkshops();
        } else {
          alert(data.message || 'Failed to register. Please try again.');
        }
      } catch (err) {
        alert('Failed to register. Please try again.');
      }
    }

    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

    // Check if URL hash wants to open workshops tab
    if (window.location.hash === '#workshops') {
      switchTab('workshops', document.getElementById('tab-workshops'));
    }

    // Initialize artisans
    renderArtisans();
    renderProducts();
    renderCategories();
  </script>
  <script src="/js/artisan-showcase.js"></script>
</body>
</html>
