<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> - HeritageLink</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/heritagelink-unified.css">
  <style>
    html,body{overflow-x:clip;max-width:100vw}
    
    .page-container{max-width:1200px;margin:0 auto;padding:1.5rem;width:100%}
    
    .breadcrumb{display:flex;align-items:center;gap:0.5rem;margin-bottom:1.25rem;font-size:0.9rem;flex-wrap:wrap}
    .breadcrumb a{color:var(--sage-green);text-decoration:none;font-weight:500}
    .breadcrumb a:hover{text-decoration:underline}
    .breadcrumb span{color:var(--slate-gray)}
    
    .content-grid{display:grid;grid-template-columns:1fr 320px;gap:1.5rem;align-items:start}
    
    /* Hero Image */
    .hero-media{background:#fff;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-md)}
    .hero-img{width:100%;height:380px;object-fit:cover;display:block}
    .gallery-strip{display:flex;gap:0.5rem;padding:0.75rem;background:var(--pebble-gray);overflow-x:auto;-webkit-overflow-scrolling:touch}
    .gallery-strip::-webkit-scrollbar{height:4px}
    .gallery-strip::-webkit-scrollbar-thumb{background:var(--rock-gray);border-radius:2px}
    .gallery-thumb{width:70px;height:50px;flex-shrink:0;border-radius:var(--radius-sm);object-fit:cover;cursor:pointer;border:2px solid transparent;transition:var(--transition)}
    .gallery-thumb:hover,.gallery-thumb.active{border-color:var(--sage-green);transform:scale(1.05)}
    
    /* Title Section */
    .title-section{margin:1.25rem 0}
    .dest-title{font-size:1.65rem;font-weight:800;background:var(--gradient-nature);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;margin:0;line-height:1.3}
    .dest-meta{display:flex;align-items:center;gap:1rem;margin-top:0.5rem;flex-wrap:wrap;font-size:0.9rem;color:var(--slate-gray)}
    .dest-meta .badge{font-size:0.8rem}
    
    /* Info Cards */
    .info-card{background:#fff;border-radius:var(--radius-lg);padding:1.25rem;box-shadow:var(--shadow-sm);border:1px solid var(--rock-gray);margin-bottom:1rem}
    .info-card h3{font-size:1rem;font-weight:700;color:var(--forest-green);margin:0 0 0.75rem;display:flex;align-items:center;gap:0.5rem}
    .info-card h3 i{color:var(--sage-green)}
    .info-card p{color:var(--slate-gray);font-size:0.9rem;line-height:1.7;margin:0;word-wrap:break-word}
    
    /* Sidebar */
    .sidebar-card{background:#fff;border-radius:var(--radius-lg);padding:1.25rem;box-shadow:var(--shadow-sm);border:1px solid var(--rock-gray);margin-bottom:1rem}
    .sidebar-card .label{font-size:0.75rem;font-weight:700;color:var(--sage-green);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.75rem}
    .detail-row{display:flex;flex-direction:column;gap:0.25rem;padding:0.5rem 0;border-bottom:1px solid var(--rock-gray)}
    .detail-row:last-child{border-bottom:none}
    .detail-row strong{font-size:0.8rem;color:var(--forest-green)}
    .detail-row span{font-size:0.875rem;color:var(--slate-gray);word-wrap:break-word}
    .sidebar-btn{display:flex;align-items:center;justify-content:center;gap:0.5rem;width:100%;padding:0.7rem 1rem;border-radius:var(--radius-md);font-weight:600;font-size:0.875rem;text-decoration:none;transition:var(--transition);margin-top:0.5rem}
    .sidebar-btn-primary{background:var(--gradient-nature);color:#fff;box-shadow:0 4px 12px rgba(45,134,89,0.25)}
    .sidebar-btn-primary:hover{transform:translateY(-2px);box-shadow:0 6px 16px rgba(45,134,89,0.35)}
    .sidebar-btn-secondary{background:var(--pebble-gray);color:var(--forest-green);border:1px solid var(--rock-gray)}
    .sidebar-btn-secondary:hover{background:var(--leaf-green)}
    
    /* Reviews Section */
    .reviews-section{background:#fff;border-radius:var(--radius-lg);padding:1.25rem;box-shadow:var(--shadow-sm);border:1px solid var(--rock-gray)}
    .reviews-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;padding-bottom:0.75rem;border-bottom:2px solid var(--leaf-green);flex-wrap:wrap;gap:0.5rem}
    .reviews-header h3{font-size:1.1rem;font-weight:700;color:var(--forest-green);margin:0;display:flex;align-items:center;gap:0.5rem}
    .avg-badge{background:linear-gradient(135deg,#fef3c7,#fde68a);padding:0.35rem 0.75rem;border-radius:var(--radius-full);font-weight:700;color:#92400e;font-size:0.8rem}
    .avg-badge i{color:#fbbf24}
    
    .review-form{background:var(--leaf-green);padding:1rem;border-radius:var(--radius-md);margin-bottom:1rem}
    .review-form h4{font-size:0.9rem;font-weight:700;color:var(--forest-green);margin:0 0 0.75rem}
    .form-row{margin-bottom:0.75rem}
    .form-row label{display:block;font-size:0.8rem;font-weight:600;color:var(--forest-green);margin-bottom:0.35rem}
    .star-input{display:flex;gap:0.25rem;flex-direction:row-reverse;justify-content:flex-end}
    .star-input input{display:none}
    .star-input label{font-size:1.4rem;color:#d1d5db;cursor:pointer;transition:all 0.15s}
    .star-input label:hover,.star-input label:hover~label,.star-input input:checked~label{color:#fbbf24}
    .form-control{width:100%;padding:0.6rem 0.75rem;border:1px solid var(--rock-gray);border-radius:var(--radius-sm);font-size:0.875rem;font-family:inherit;background:#fff}
    .form-control:focus{outline:none;border-color:var(--sage-green);box-shadow:0 0 0 2px rgba(45,134,89,0.1)}
    textarea.form-control{min-height:70px;resize:vertical}
    .btn-submit{background:var(--gradient-sunset);color:#fff;border:none;padding:0.6rem 1.25rem;border-radius:var(--radius-md);font-weight:600;cursor:pointer;font-size:0.85rem;display:inline-flex;align-items:center;gap:0.4rem;transition:var(--transition)}
    .btn-submit:hover{transform:translateY(-2px)}
    
    .login-box{background:linear-gradient(135deg,#eff6ff,#dbeafe);padding:1rem;border-radius:var(--radius-md);text-align:center;margin-bottom:1rem;border:1px solid #93c5fd}
    .login-box p{margin:0;color:#1e40af;font-size:0.9rem}
    .login-box a{color:var(--forest-green);font-weight:600}
    
    .reviews-list{display:flex;flex-direction:column;gap:0.75rem;max-height:400px;overflow-y:auto}
    .review-item{padding:1rem;border-radius:var(--radius-md);background:var(--pebble-gray);border:1px solid var(--rock-gray)}
    .review-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.5rem;flex-wrap:wrap;gap:0.5rem}
    .reviewer{display:flex;align-items:center;gap:0.6rem}
    .avatar{width:34px;height:34px;background:var(--gradient-nature);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.8rem;flex-shrink:0}
    .reviewer-name{font-weight:600;color:var(--forest-green);font-size:0.875rem}
    .reviewer-stars{color:#fbbf24;font-size:0.8rem}
    .review-date{font-size:0.75rem;color:var(--slate-gray)}
    .review-text{color:var(--charcoal);font-size:0.85rem;line-height:1.6}
    .helpful-btn{background:#fff;border:1px solid var(--rock-gray);padding:0.25rem 0.6rem;border-radius:var(--radius-full);font-size:0.75rem;cursor:pointer;color:var(--slate-gray);margin-top:0.5rem;display:inline-flex;align-items:center;gap:0.25rem;transition:var(--transition)}
    .helpful-btn:hover{border-color:var(--sage-green);color:var(--sage-green)}
    .no-reviews{text-align:center;padding:1.5rem;color:var(--slate-gray)}
    .no-reviews i{font-size:2rem;color:#d1d5db;margin-bottom:0.5rem;display:block}
    

    
    /* Toast */
    @keyframes toastIn{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:translateX(0)}}
    @keyframes toastOut{from{opacity:1}to{opacity:0}}
    
    /* Responsive */
    @media(max-width:900px){
      .content-grid{grid-template-columns:1fr}
      .hero-img{height:300px}
    }
    @media(max-width:600px){
      .page-container{padding:1rem 0.75rem}
      .hero-img{height:220px}
      .dest-title{font-size:1.35rem}
      .info-card,.sidebar-card,.reviews-section{padding:1rem;border-radius:var(--radius-md)}
      .gallery-thumb{width:60px;height:42px}
      .float-back{width:42px;height:42px;font-size:1rem;left:0.75rem;bottom:0.75rem}
      .reviews-header{flex-direction:column;align-items:flex-start}
    }
    @media(max-width:400px){
      .hero-img{height:180px}
      .dest-title{font-size:1.2rem}
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="logo">
        <img src="/uploads/logo.jpg" alt="HeritageLink"> HeritageLink
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
        <i class="fas fa-bars"></i>
      </button>
      <div class="nav-overlay" id="navOverlay"></div>
      <div class="nav-links" id="navLinks">
        <button class="nav-close" id="navClose" aria-label="Close menu">
          <i class="fas fa-times"></i>
        </button>
        <a href="/" class="nav-link"><i class="fas fa-home"></i> <span>Home</span></a>
        <a href="/destinations" class="nav-link"><i class="fas fa-map-marked-alt"></i> <span>Explore Map & Sites</span></a>
        <a href="/events" class="nav-link"><i class="fas fa-calendar-alt"></i> <span>Events</span></a>
        <a href="/heritage-gallery" class="nav-link"><i class="fas fa-landmark"></i> <span>Heritage Gallery</span></a>
        
        <a href="/showcase" class="nav-link"><i class="fas fa-palette"></i> <span>Artisans</span></a>
        <a href="/feedback" class="nav-link"><i class="fas fa-comment-dots"></i> <span>Feedback</span></a>
        <% if (user) { %>
          <a href="/dashboard" class="btn btn-primary">Dashboard</a>
        <% } else { %>
          <a href="/login" class="btn btn-secondary">Login</a>
        <% } %>
      </div>
    </div>
  </nav>

  <div class="page-container">
    <!-- Breadcrumb -->
    <div class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/destinations">Destinations</a>
      <span>/</span>
      <span><%= destination.name %></span>
    </div>

    <div class="content-grid">
      <!-- Main Content -->
      <div>
        <!-- Hero Image -->
        <div class="hero-media">
          <% if (images && images.length > 0) { %>
            <img id="mainImg" class="hero-img" src="<%= images[0].url || images[0].image_url || images[0].photo || '' %>" alt="<%= destination.name %>" />
            <div class="gallery-strip">
              <% images.forEach((img, idx) => { %>
                <img class="gallery-thumb <%= idx === 0 ? 'active' : '' %>" src="<%= img.url || img.image_url || img.photo || '' %>" alt="Gallery" onclick="changeImg(this)" />
              <% }) %>
            </div>
          <% } else { %>
            <img class="hero-img" src="/placeholder-hero.jpg" alt="<%= destination.name %>" />
          <% } %>
        </div>

        <!-- Title -->
        <div class="title-section">
          <h1 class="dest-title"><%= destination.name %></h1>
          <div class="dest-meta">
            <span class="badge badge-success"><%= destination.site_type || destination.category || 'Cultural Site' %></span>
            <span><i class="fas fa-star" style="color:#fbbf24"></i> <%= destination.average_rating || 'N/A' %></span>
            <% if (destination.address || destination.location) { %>
              <span><i class="fas fa-map-marker-alt"></i> <%= destination.address || destination.location %></span>
            <% } %>
          </div>
        </div>

        <!-- Overview -->
        <div class="info-card">
          <h3><i class="fas fa-info-circle"></i> Overview</h3>
          <p><%= destination.description || 'No description available.' %></p>
        </div>

        <% if (destination.historical_background) { %>
        <div class="info-card">
          <h3><i class="fas fa-book-open"></i> Historical Background</h3>
          <p><%= destination.historical_background %></p>
        </div>
        <% } %>

        <!-- Reviews -->
        <div class="reviews-section">
          <div class="reviews-header">
            <h3><i class="fas fa-star"></i> Reviews & Ratings</h3>
            <span id="avgRating" class="avg-badge"><i class="fas fa-spinner fa-spin"></i></span>
          </div>
          
          <% if (user) { %>
          <div class="review-form">
            <h4><i class="fas fa-pen"></i> Write a Review</h4>
            <div class="form-row">
              <label>Your Rating</label>
              <div id="starRating" class="star-input">
                <input type="radio" name="rating" value="5" id="r5"><label for="r5"><i class="fas fa-star"></i></label>
                <input type="radio" name="rating" value="4" id="r4"><label for="r4"><i class="fas fa-star"></i></label>
                <input type="radio" name="rating" value="3" id="r3"><label for="r3"><i class="fas fa-star"></i></label>
                <input type="radio" name="rating" value="2" id="r2"><label for="r2"><i class="fas fa-star"></i></label>
                <input type="radio" name="rating" value="1" id="r1"><label for="r1"><i class="fas fa-star"></i></label>
              </div>
            </div>
            <div class="form-row">
              <label>Title (optional)</label>
              <input type="text" id="reviewTitle" class="form-control" placeholder="Summarize your experience">
            </div>
            <div class="form-row">
              <label>Your Review</label>
              <textarea id="reviewComment" class="form-control" placeholder="Share your experience..."></textarea>
            </div>
            <button onclick="submitReview()" class="btn-submit">
              <i class="fas fa-paper-plane"></i> Submit
            </button>
          </div>
          <% } else { %>
          <div class="login-box">
            <p><a href="/login">Login</a> or <a href="/register">Register</a> to share your experience</p>
          </div>
          <% } %>

          <div id="reviewsList" class="reviews-list">
            <div class="no-reviews"><i class="fas fa-spinner fa-spin"></i><p>Loading...</p></div>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside>
        <div class="sidebar-card">
          <div class="label">Details</div>
          <div class="detail-row">
            <strong>Address</strong>
            <span><%= destination.address || destination.location || 'Not specified' %></span>
          </div>
          <div class="detail-row">
            <strong>Opening Hours</strong>
            <span><%= destination.opening_hours || 'Not specified' %></span>
          </div>
          <div class="detail-row">
            <strong>Entrance Fee</strong>
            <span><%= destination.entrance_fee && Number(destination.entrance_fee) > 0 ? '₱' + Number(destination.entrance_fee).toFixed(2) : 'Free' %></span>
          </div>
          <div class="detail-row">
            <strong>Contact</strong>
            <span><%= destination.contact_info || 'Not provided' %></span>
          </div>
        </div>

        <div class="sidebar-card">
          <div class="label">Share</div>
          <a class="sidebar-btn sidebar-btn-primary" href="mailto:?subject=<%= encodeURIComponent(destination.name) %>&body=<%= encodeURIComponent('Check this place: ' + (destination.name||'')) %>">
            <i class="fas fa-envelope"></i> Share via Email
          </a>
        </div>

        <% if (user && user.role === 'admin') { %>
        <div class="sidebar-card">
          <div class="label">Admin</div>
          <a class="sidebar-btn sidebar-btn-secondary" href="/admin/destinations/edit/<%= destination.id %>">
            <i class="fas fa-edit"></i> Edit Destination
          </a>
        </div>
        <% } %>
      </aside>
    </div>
  </div>

  <script>
    // Mobile nav toggle
    (function(){
      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navLinks');
      const overlay = document.getElementById('navOverlay');
      const close = document.getElementById('navClose');
      
      function openMenu() {
        links.classList.add('active');
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
      
      function closeMenu() {
        links.classList.remove('active');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      }
      
      if(toggle) toggle.addEventListener('click', openMenu);
      if(close) close.addEventListener('click', closeMenu);
      if(overlay) overlay.addEventListener('click', closeMenu);
    })();

    // Gallery image switcher
    function changeImg(thumb) {
      document.getElementById('mainImg').src = thumb.src;
      document.querySelectorAll('.gallery-thumb').forEach(t => t.classList.remove('active'));
      thumb.classList.add('active');
    }



    // Star rating interaction
    const starContainer = document.getElementById('starRating');
    if (starContainer) {
      const labels = starContainer.querySelectorAll('label');
      const updateStars = (val) => {
        labels.forEach(l => {
          const v = l.previousElementSibling.value;
          l.style.color = v <= val ? '#fbbf24' : '#d1d5db';
        });
      };
      labels.forEach(label => {
        label.addEventListener('mouseover', function() { updateStars(this.previousElementSibling.value); });
        label.addEventListener('click', function() {
          this.previousElementSibling.checked = true;
          updateStars(this.previousElementSibling.value);
        });
      });
      starContainer.addEventListener('mouseleave', function() {
        const checked = starContainer.querySelector('input:checked');
        updateStars(checked ? checked.value : 0);
      });
    }

    // Reviews
    const destinationId = <%= destination.id %>;
    
    async function loadReviews() {
      try {
        const res = await fetch(`/api/destinations/${destinationId}/reviews`);
        const data = await res.json();
        if (data.success) renderReviews(data.reviews, data.stats);
      } catch (err) {
        document.getElementById('reviewsList').innerHTML = '<p style="text-align:center;color:#6b7280">Failed to load reviews</p>';
      }
    }

    function renderReviews(reviews, stats) {
      const avgEl = document.getElementById('avgRating');
      if (stats && stats.avg_rating) {
        avgEl.innerHTML = `<i class="fas fa-star"></i> ${parseFloat(stats.avg_rating).toFixed(1)} (${stats.total_reviews})`;
      } else {
        avgEl.innerHTML = '<i class="far fa-star"></i> No reviews';
        avgEl.style.background = '#f3f4f6';
        avgEl.style.color = '#6b7280';
      }

      const list = document.getElementById('reviewsList');
      if (!reviews || reviews.length === 0) {
        list.innerHTML = '<div class="no-reviews"><i class="far fa-comment-dots"></i><p>No reviews yet. Be the first!</p></div>';
        return;
      }

      list.innerHTML = reviews.map(r => {
        const initials = (r.user_name || 'A').charAt(0).toUpperCase();
        const stars = '<i class="fas fa-star"></i>'.repeat(r.rating) + '<i class="far fa-star"></i>'.repeat(5-r.rating);
        return `
          <div class="review-item">
            <div class="review-top">
              <div class="reviewer">
                <div class="avatar">${initials}</div>
                <div>
                  <div class="reviewer-name">${escapeHtml(r.user_name || 'Anonymous')}</div>
                  <div class="reviewer-stars">${stars}</div>
                </div>
              </div>
              <span class="review-date">${new Date(r.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            </div>
            ${r.title ? `<div style="font-weight:600;color:#14532d;margin-bottom:0.25rem;font-size:0.9rem">${escapeHtml(r.title)}</div>` : ''}
            <p class="review-text">${escapeHtml(r.comment)}</p>
            <button onclick="voteHelpful(${r.id})" class="helpful-btn">
              <i class="fas fa-thumbs-up"></i> Helpful ${r.helpful_count ? '(' + r.helpful_count + ')' : ''}
            </button>
          </div>`;
      }).join('');
    }

    function escapeHtml(str) {
      return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    async function submitReview() {
      const rating = document.querySelector('#starRating input:checked')?.value;
      const title = document.getElementById('reviewTitle')?.value || '';
      const comment = document.getElementById('reviewComment')?.value || '';
      const btn = document.querySelector('.btn-submit');

      if (!rating) { showToast('Please select a rating', 'warning'); return; }
      if (!comment.trim()) { showToast('Please write a review', 'warning'); return; }

      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...';

      try {
        const res = await fetch('/api/reviews', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ destination_id: destinationId, rating, title, comment })
        });
        const data = await res.json();
        if (data.success) {
          showToast('Review submitted!', 'success');
          document.getElementById('reviewTitle').value = '';
          document.getElementById('reviewComment').value = '';
          document.querySelectorAll('#starRating input').forEach(i => i.checked = false);
          document.querySelectorAll('#starRating label').forEach(l => l.style.color = '#d1d5db');
        } else {
          showToast(data.error || 'Failed to submit', 'error');
        }
      } catch (err) {
        showToast('Error submitting review', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paper-plane"></i> Submit';
      }
    }
    
    function showToast(message, type) {
      const colors = { success: '#10b981', error: '#ef4444', warning: '#f59e0b' };
      const toast = document.createElement('div');
      toast.style.cssText = `position:fixed;top:20px;right:20px;background:${colors[type]};color:#fff;padding:0.85rem 1.25rem;border-radius:0.75rem;box-shadow:0 10px 25px rgba(0,0,0,0.2);z-index:10000;font-weight:600;animation:toastIn 0.3s ease;max-width:90vw`;
      toast.textContent = message;
      document.body.appendChild(toast);
      setTimeout(() => { toast.style.animation = 'toastOut 0.3s ease'; setTimeout(() => toast.remove(), 300); }, 3000);
    }

    async function voteHelpful(reviewId) {
      try {
        const res = await fetch(`/api/reviews/${reviewId}/helpful`, { method: 'POST' });
        const data = await res.json();
        if (data.success) loadReviews();
        else showToast(data.error || 'Please login to vote', 'warning');
      } catch (err) { showToast('Error voting', 'error'); }
    }

    loadReviews();
  </script>
</body>
</html>
