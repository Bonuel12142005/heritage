<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <title><%= title %></title>
    <%- include('partials/user-dashboard-styles.xian') %>
    <style>
        .workshop-card{background:#fff;border-radius:0.875rem;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08);border:1px solid var(--border);transition:all 0.3s}
        .workshop-card:hover{transform:translateY(-3px);box-shadow:0 8px 20px rgba(0,0,0,0.1)}
        .workshop-header{padding:1.25rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:flex-start;gap:1rem}
        .workshop-title{font-size:1.15rem;font-weight:700;color:var(--text-primary);margin:0 0 0.5rem}
        .workshop-artisan{font-size:0.85rem;color:var(--text-secondary);display:flex;align-items:center;gap:0.4rem}
        .workshop-artisan i{color:var(--primary)}
        .workshop-body{padding:1.25rem}
        .workshop-meta{display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:1rem}
        .meta-item{display:flex;align-items:center;gap:0.5rem;font-size:0.85rem;color:var(--text-secondary)}
        .meta-item i{color:var(--primary);width:16px}
        .workshop-status{padding:0.3rem 0.75rem;border-radius:1rem;font-size:0.75rem;font-weight:600;text-transform:uppercase}
        .status-registered{background:#dbeafe;color:#1e40af}
        .status-attended{background:#d1fae5;color:#065f46}
        .status-cancelled{background:#fee2e2;color:#991b1b}
        .status-upcoming{background:#fef3c7;color:#92400e}
        .status-completed{background:#e5e7eb;color:#4b5563}
        .workshop-price{font-size:1.1rem;font-weight:700;color:var(--primary)}
        .workshop-price.free{color:#10b981}
        .workshop-actions{padding:1rem 1.25rem;border-top:1px solid var(--border);display:flex;gap:0.75rem}
        .btn-sm{padding:0.5rem 1rem;font-size:0.8rem}
        .btn-outline{background:transparent;border:2px solid var(--primary);color:var(--primary)}
        .btn-outline:hover{background:var(--primary);color:#fff}
        .btn-danger{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff}
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-logo">
            <h2>
                <img src="/uploads/logo.jpg" alt="HeritageLink">
                HeritageLink
                <span class="badge badge-info">Explorer</span>
            </h2>
        </div>
        <ul class="sidebar-menu">
            <li class="menu-item"><a href="/user/dashboard" class="menu-link"><i class="fas fa-th-large"></i><span>Dashboard</span></a></li>
            <li class="menu-item"><a href="/destinations" class="menu-link"><i class="fas fa-map-marked-alt"></i><span>Explore Map & Sites</span></a></li>
            <li class="menu-item"><a href="/events" class="menu-link"><i class="fas fa-calendar-alt"></i><span>Events</span></a></li>
            <li class="menu-item"><a href="/showcase" class="menu-link"><i class="fas fa-palette"></i><span>Artisans</span></a></li>
            <li class="menu-item"><a href="/workshops" class="menu-link"><i class="fas fa-chalkboard-teacher"></i><span>Workshops</span></a></li>
            <div class="menu-section">My Activity</div>
            <li class="menu-item"><a href="/user/reviews" class="menu-link"><i class="fas fa-star"></i><span>My Reviews</span></a></li>
            <li class="menu-item"><a href="/user/favorites" class="menu-link"><i class="fas fa-heart"></i><span>Favorites</span></a></li>
            <li class="menu-item"><a href="/user/workshops" class="menu-link active"><i class="fas fa-chalkboard-teacher"></i><span>My Workshops</span></a></li>
            <li class="menu-item"><a href="/user/gallery" class="menu-link"><i class="fas fa-images"></i><span>My Gallery</span></a></li>
            <li class="menu-item"><a href="/user/messages" class="menu-link"><i class="fas fa-envelope"></i><span>Messages</span></a></li>
            <div class="menu-section">Account</div>
            <li class="menu-item"><a href="/user/profile" class="menu-link"><i class="fas fa-user-circle"></i><span>My Profile</span></a></li>
            <li class="menu-item"><a href="/" class="menu-link"><i class="fas fa-home"></i><span>Home</span></a></li>
            <li class="menu-item"><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt"></i><span>Logout</span></a></li>
        </ul>
    </aside>

    <main class="main-content">
        <div class="topbar">
            <div class="topbar-left">
                <h1><i class="fas fa-chalkboard-teacher"></i> My Workshops</h1>
                <p>View and manage your registered workshop sessions</p>
            </div>
            <div class="topbar-right">
                <a href="/workshops" class="btn btn-primary"><i class="fas fa-plus"></i> Browse Workshops</a>
            </div>
        </div>

        <div class="dashboard-content">
            <% if (workshops.length === 0) { %>
                <div class="card text-center" style="padding: 3rem;">
                    <div style="font-size: 4rem; margin-bottom: 1rem;">🎨</div>
                    <h2 style="margin-bottom: 1rem;">No Workshops Registered</h2>
                    <p style="color: var(--text-secondary); margin-bottom: 2rem;">
                        Discover and register for artisan workshops to learn traditional crafts!
                    </p>
                    <a href="/workshops" class="btn btn-primary">
                        <i class="fas fa-chalkboard-teacher"></i> Browse Workshops
                    </a>
                </div>
            <% } else { %>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 1.5rem;">
                    <% workshops.forEach(workshop => { 
                        const workshopDate = new Date(workshop.workshop_date);
                        const today = new Date();
                        today.setHours(0,0,0,0);
                        workshopDate.setHours(0,0,0,0);
                        let dateStatus = 'upcoming';
                        if (workshopDate < today) dateStatus = 'completed';
                        else if (workshopDate.getTime() === today.getTime()) dateStatus = 'ongoing';
                        const price = parseFloat(workshop.fee) || 0;
                    %>
                        <div class="workshop-card">
                            <div class="workshop-header">
                                <div>
                                    <h3 class="workshop-title"><%= workshop.title %></h3>
                                    <div class="workshop-artisan"><i class="fas fa-user-circle"></i> <%= workshop.artisan_name || 'Local Artisan' %></div>
                                </div>
                                <span class="workshop-status status-<%= dateStatus %>"><%= dateStatus %></span>
                            </div>
                            <div class="workshop-body">
                                <div class="workshop-meta">
                                    <div class="meta-item"><i class="fas fa-calendar"></i> <%= workshopDate.toLocaleDateString('en-PH', {month:'short',day:'numeric',year:'numeric'}) %></div>
                                    <div class="meta-item"><i class="fas fa-clock"></i> <%= workshop.workshop_time || 'TBD' %></div>
                                    <div class="meta-item"><i class="fas fa-map-marker-alt"></i> <%= workshop.location || 'Gloria, Oriental Mindoro' %></div>
                                    <div class="meta-item"><i class="fas fa-hourglass-half"></i> <%= workshop.duration || '2 hours' %></div>
                                </div>
                                <p style="font-size:0.85rem;color:var(--text-secondary);line-height:1.5;margin-bottom:1rem;"><%= workshop.description ? workshop.description.substring(0, 120) + '...' : 'Learn traditional crafts from local artisans.' %></p>
                                <div style="display:flex;justify-content:space-between;align-items:center;">
                                    <span class="workshop-price <%= price === 0 ? 'free' : '' %>"><%= price > 0 ? '₱' + price.toLocaleString('en-PH') : 'FREE' %></span>
                                    <span class="workshop-status status-<%= workshop.registration_status || 'registered' %>"><%= workshop.registration_status || 'registered' %></span>
                                </div>
                            </div>
                            <div class="workshop-actions">
                                <a href="/workshops" class="btn btn-outline btn-sm"><i class="fas fa-eye"></i> View Details</a>
                                <% if (dateStatus === 'upcoming') { %>
                                    <button onclick="cancelRegistration(<%= workshop.id %>)" class="btn btn-danger btn-sm"><i class="fas fa-times"></i> Cancel</button>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </main>

    <script>
        async function cancelRegistration(workshopId) {
            if (!confirm('Are you sure you want to cancel your registration for this workshop?')) return;
            
            try {
                const res = await fetch(`/api/workshops/${workshopId}/cancel`, { method: 'POST' });
                const data = await res.json();
                
                if (data.success) {
                    alert('Registration cancelled successfully.');
                    location.reload();
                } else {
                    alert(data.message || 'Failed to cancel registration.');
                }
            } catch (err) {
                console.error('Cancel error:', err);
                alert('Failed to cancel registration. Please try again.');
            }
        }
    </script>
</body>
</html>
