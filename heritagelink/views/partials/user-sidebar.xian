<aside class="sidebar">
    <div class="sidebar-logo">
        <h2>
            <img src="/uploads/logo.jpg" alt="HeritageLink">
            HeritageLink
            <span class="badge">Explorer</span>
        </h2>
    </div>
    <ul class="sidebar-menu">
        <li class="menu-item">
            <a href="/user/dashboard" class="menu-link <%= currentPage === 'dashboard' ? 'active' : '' %>">
                <i class="fas fa-th-large"></i>
                <span>Dashboard</span>
            </a>
        </li>
        <li class="menu-item">
            <a href="/destinations" class="menu-link <%= currentPage === 'destinations' ? 'active' : '' %>">
                <i class="fas fa-map-marked-alt"></i>
                <span>Discover Sites</span>
            </a>
        </li>
        <li class="menu-item">
            <a href="/events" class="menu-link <%= currentPage === 'events' ? 'active' : '' %>">
                <i class="fas fa-calendar-alt"></i>
                <span>Events</span>
            </a>
        </li>
        <li class="menu-item">
            <a href="/artisans" class="menu-link">
                <i class="fas fa-palette"></i>
                <span>Artisans</span>
            </a>
        </li>
        <div class="menu-section">My Activity</div>
        <li class="menu-item">
            <a href="/user/reviews" class="menu-link <%= currentPage === 'reviews' ? 'active' : '' %>">
                <i class="fas fa-star"></i>
                <span>My Reviews</span>
            </a>
        </li>
        <li class="menu-item">
            <a href="/user/favorites" class="menu-link <%= currentPage === 'favorites' ? 'active' : '' %>">
                <i class="fas fa-heart"></i>
                <span>Favorites</span>
            </a>
        </li>
        <li class="menu-item">
            <a href="/user/gallery" class="menu-link <%= currentPage === 'gallery' ? 'active' : '' %>">
                <i class="fas fa-images"></i>
                <span>My Gallery</span>
            </a>
        </li>
        <li class="menu-item">
            <a href="/user/messages" class="menu-link <%= currentPage === 'messages' ? 'active' : '' %>">
                <i class="fas fa-envelope"></i>
                <span>Messages</span>
            </a>
        </li>
        <li class="menu-item">
            <a href="/user/feedback" class="menu-link <%= currentPage === 'feedback' ? 'active' : '' %>">
                <i class="fas fa-comment-dots"></i>
                <span>My Feedback</span>
            </a>
        </li>
        <div class="menu-section">Account</div>
        <li class="menu-item">
            <a href="/user/profile" class="menu-link <%= currentPage === 'profile' ? 'active' : '' %>">
                <i class="fas fa-user-circle"></i>
                <span>My Profile</span>
            </a>
        </li>
        <li class="menu-item">
            <a href="/" class="menu-link">
                <i class="fas fa-home"></i>
                <span>Home</span>
            </a>
        </li>
        <li class="menu-item">
            <a href="/logout" class="menu-link">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </a>
        </li>
    </ul>
</aside>
