<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/heritagelink-unified.css">
    <style>
        .place-hero {
            position: relative;
            height: 400px;
            background: linear-gradient(135deg, #1a5f3f, #2d8659);
            overflow: hidden;
        }
        
        .place-hero-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
        }
        
        .place-hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(26, 95, 63, 0.7), rgba(45, 134, 89, 0.5));
            z-index: 2;
        }
        
        .place-hero-content {
            position: relative;
            z-index: 3;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: white;
            padding: 2rem;
        }
        
        .place-hero h1 {
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 1rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
            font-family: 'Poppins', sans-serif;
        }
        
        .place-hero .category-badge {
            background: rgba(255, 107, 53, 0.9);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .place-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 3rem 2rem;
        }
        
        .place-info-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 3rem;
            margin-bottom: 3rem;
        }
        
        .place-description {
            background: white;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        
        .place-description h2 {
            color: #1a5f3f;
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 1rem;
            font-family: 'Poppins', sans-serif;
        }
        
        .place-description p {
            color: #78716c;
            line-height: 1.6;
            font-size: 1rem;
        }
        
        .place-details {
            background: white;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        
        .place-details h3 {
            color: #1a5f3f;
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            font-family: 'Poppins', sans-serif;
        }
        
        .detail-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #f5f5f4;
        }
        
        .detail-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }
        
        .detail-item i {
            color: #ff6b35;
            width: 20px;
            text-align: center;
        }
        
        .detail-item .label {
            font-weight: 600;
            color: #1a5f3f;
            min-width: 80px;
        }
        
        .detail-item .value {
            color: #78716c;
        }
        
        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1.5rem;
            background: #f5f5f4;
            color: #78716c;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.2s;
            margin-bottom: 2rem;
        }
        
        .back-button:hover {
            background: #e7e5e4;
            color: #1a5f3f;
        }
        
        @media (max-width: 768px) {
            .place-hero {
                height: 300px;
            }
            
            .place-hero h1 {
                font-size: 2rem;
            }
            
            .place-content {
                padding: 2rem 1rem;
            }
            
            .place-info-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/navbar.xian') %>
    
    <div class="place-hero">
        <% if (place.image_url) { %>
            <img src="<%= place.image_url %>" alt="<%= place.name %>" class="place-hero-image">
        <% } %>
        <div class="place-hero-overlay"></div>
        <div class="place-hero-content">
            <div>
                <div class="category-badge"><%= place.category || 'Attraction' %></div>
                <h1><%= place.name %></h1>
            </div>
        </div>
    </div>
    
    <div class="place-content">
        <a href="/map" class="back-button">
            <i class="fas fa-arrow-left"></i> Back to Map
        </a>
        
        <div class="place-info-grid">
            <div class="place-description">
                <h2>About This Place</h2>
                <p><%= place.description || 'No description available for this place.' %></p>
            </div>
            
            <div class="place-details">
                <h3>Details</h3>
                
                <% if (place.address) { %>
                <div class="detail-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <span class="label">Address:</span>
                    <span class="value"><%= place.address %></span>
                </div>
                <% } %>
                
                <% if (place.opening_hours) { %>
                <div class="detail-item">
                    <i class="fas fa-clock"></i>
                    <span class="label">Hours:</span>
                    <span class="value"><%= place.opening_hours %></span>
                </div>
                <% } %>
                
                <% if (place.contact) { %>
                <div class="detail-item">
                    <i class="fas fa-phone"></i>
                    <span class="label">Contact:</span>
                    <span class="value"><%= place.contact %></span>
                </div>
                <% } %>
                
                <% if (place.entrance_fee !== null && place.entrance_fee !== undefined) { %>
                <div class="detail-item">
                    <i class="fas fa-ticket-alt"></i>
                    <span class="label">Fee:</span>
                    <span class="value">
                        <% if (place.entrance_fee == 0) { %>
                            Free Entry
                        <% } else { %>
                            ₱<%= place.entrance_fee %>
                        <% } %>
                    </span>
                </div>
                <% } %>
                
                <% if (place.price_range) { %>
                <div class="detail-item">
                    <i class="fas fa-peso-sign"></i>
                    <span class="label">Price:</span>
                    <span class="value"><%= place.price_range %></span>
                </div>
                <% } %>
                
                <% if (place.type) { %>
                <div class="detail-item">
                    <i class="fas fa-tag"></i>
                    <span class="label">Type:</span>
                    <span class="value"><%= place.type %></span>
                </div>
                <% } %>
            </div>
        </div>
    </div>
    
    <%- include('partials/footer.xian') %>
</body>
</html>