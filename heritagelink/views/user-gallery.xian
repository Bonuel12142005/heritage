<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <title><%= title %></title>
    <%- include('partials/user-dashboard-styles.xian') %>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-logo">
            <h2>
                <img src="/uploads/logo.jpg" alt="HeritageLink">
                HeritageLink
                <span class="badge badge-info">Explorer</span>
            </h2>
        </div>
        <ul class="sidebar-menu">
            <li class="menu-item">
                <a href="/user/dashboard" class="menu-link">
                    <i class="fas fa-th-large"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/destinations" class="menu-link">
                    <i class="fas fa-map-marked-alt"></i>
                    <span>Discover Sites</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/events" class="menu-link">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Events</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/artisans" class="menu-link">
                    <i class="fas fa-palette"></i>
                    <span>Artisans</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/workshops" class="menu-link">
                    <i class="fas fa-chalkboard-teacher"></i>
                    <span>Workshops</span>
                </a>
            </li>
            <div class="menu-section">My Activity</div>
            <li class="menu-item">
                <a href="/user/reviews" class="menu-link">
                    <i class="fas fa-star"></i>
                    <span>My Reviews</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/user/favorites" class="menu-link">
                    <i class="fas fa-heart"></i>
                    <span>Favorites</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/user/workshops" class="menu-link">
                    <i class="fas fa-chalkboard-teacher"></i>
                    <span>My Workshops</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/user/gallery" class="menu-link active">
                    <i class="fas fa-images"></i>
                    <span>My Gallery</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/user/messages" class="menu-link">
                    <i class="fas fa-envelope"></i>
                    <span>Messages</span>
                </a>
            </li>
            <div class="menu-section">Account</div>
            <li class="menu-item">
                <a href="/user/profile" class="menu-link">
                    <i class="fas fa-user-circle"></i>
                    <span>My Profile</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/" class="menu-link">
                    <i class="fas fa-home"></i>
                    <span>Home</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/logout" class="menu-link">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </li>
        </ul>
    </aside>

    <main class="main-content">
        <div class="topbar">
            <div class="topbar-left">
                <h1><i class="fas fa-images"></i> My Gallery</h1>
                <p>Share your cultural journey through photos</p>
            </div>
        </div>

        <div class="dashboard-content">
            <% if (success) { %>
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> <%= success %>
                </div>
            <% } %>
            
            <% if (error) { %>
                <div class="alert alert-error">
                    <i class="fas fa-exclamation-circle"></i> <%= error %>
                </div>
            <% } %>

            <!-- Upload Form -->
            <div class="card" style="margin-bottom: 2rem;">
                <h3 style="margin-bottom: 1rem;">
                    <i class="fas fa-cloud-upload-alt"></i> Upload Photos
                </h3>
                <form method="POST" action="/user/gallery/upload" enctype="multipart/form-data">
                    <div class="form-group">
                        <label class="form-label">Select Photos (up to 10)</label>
                        <input type="file" name="gallery_images" class="form-input" accept="image/*" multiple required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Caption (Optional)</label>
                        <input type="text" name="caption" class="form-input" placeholder="Add a caption to your photos">
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-upload"></i> Upload Photos
                    </button>
                </form>
            </div>

            <!-- Gallery Grid -->
            <% if (photos.length === 0) { %>
                <div class="card text-center" style="padding: 3rem;">
                    <div style="font-size: 4rem; margin-bottom: 1rem;">📸</div>
                    <h2 style="margin-bottom: 1rem;">No Photos Yet</h2>
                    <p style="color: var(--slate-gray);">
                        Upload your first photo to start building your gallery!
                    </p>
                </div>
            <% } else { %>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
                    <% photos.forEach(photo => { %>
                        <div class="card" style="padding: 0; overflow: hidden;">
                            <img src="/<%= photo.image_path %>" alt="Gallery photo" 
                                 style="width: 100%; height: 280px; object-fit: cover; cursor: pointer;"
                                 onclick="window.open('/<%= photo.image_path %>', '_blank')">
                            <div style="padding: 1rem;">
                                <% if (photo.caption) { %>
                                    <p style="margin-bottom: 0.75rem; color: var(--charcoal);">
                                        <%= photo.caption %>
                                    </p>
                                <% } %>
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <span style="font-size: 0.875rem; color: var(--slate-gray);">
                                        <i class="fas fa-calendar"></i>
                                        <%= new Date(photo.created_at).toLocaleDateString() %>
                                    </span>
                                    <form method="POST" action="/user/gallery/<%= photo.id %>/delete" style="display: inline;">
                                        <button type="submit" class="btn" style="background: var(--textile-red); color: white; padding: 0.5rem 1rem;"
                                                onclick="return confirm('Delete this photo?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
