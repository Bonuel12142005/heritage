<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - HeritageLink</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/heritagelink-unified.css">
  <style>
    html,body{overflow-x:hidden;max-width:100vw}
    
    /* Page Hero */
    .page-hero{background:var(--gradient-nature);padding:2.5rem 1.5rem 2rem;text-align:center;position:relative}
    .page-hero::after{content:'';position:absolute;bottom:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#ff6b35,#f59e0b,#ff6b35)}
    .page-hero h1{color:#fff;font-size:2rem;font-weight:800;margin:0 0 0.5rem;font-family:'Poppins',sans-serif;display:flex;align-items:center;justify-content:center;gap:0.5rem}
    .page-hero p{color:var(--leaf-green);font-size:1rem;margin:0}
    
    /* Container */
    .container{max-width:1300px;margin:0 auto;padding:1.5rem}
    
    /* Filter Bar */
    .filter-bar{background:#fff;border-radius:var(--radius-lg);padding:1rem 1.25rem;box-shadow:var(--shadow-md);margin:-1.5rem auto 1.5rem;max-width:950px;position:relative;z-index:10;display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center}
    .search-box{flex:1;min-width:200px;position:relative}
    .search-box i{position:absolute;left:1rem;top:50%;transform:translateY(-50%);color:var(--slate-gray)}
    .search-input{width:100%;padding:0.7rem 1rem 0.7rem 2.5rem;border:2px solid var(--rock-gray);border-radius:var(--radius-md);font-size:0.9rem;transition:var(--transition)}
    .search-input:focus{outline:none;border-color:var(--sage-green);box-shadow:0 0 0 3px rgba(45,134,89,0.1)}
    .filter-select{padding:0.7rem 1rem;border:2px solid var(--rock-gray);border-radius:var(--radius-md);font-size:0.9rem;background:#fff;min-width:130px;cursor:pointer;transition:var(--transition)}
    .filter-select:focus{outline:none;border-color:var(--sage-green)}
    .clear-btn{padding:0.7rem 1.25rem;border:2px solid var(--rock-gray);border-radius:var(--radius-md);background:var(--pebble-gray);font-size:0.9rem;font-weight:600;cursor:pointer;transition:var(--transition);color:var(--slate-gray)}
    .clear-btn:hover{background:var(--rock-gray);color:var(--charcoal)}
    
    /* Results Info */
    .results-info{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:0.5rem}
    .results-count{font-size:0.9rem;color:var(--slate-gray)}
    .results-count strong{color:var(--forest-green)}
    
    /* Events Grid */
    .events-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.25rem}
    
    /* Event Card */
    .event-card{background:#fff;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm);border:1px solid var(--rock-gray);transition:var(--transition);display:flex;flex-direction:column}
    .event-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg);border-color:var(--textile-orange)}
    .event-img{height:160px;background:linear-gradient(135deg,#fef3c7,#fed7aa);position:relative;overflow:hidden}
    .event-img img{width:100%;height:100%;object-fit:cover;transition:transform 0.4s ease}
    .event-card:hover .event-img img{transform:scale(1.08)}
    .event-img .no-img{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:var(--clay-brown);gap:0.5rem}
    .event-img .no-img i{font-size:2.5rem;opacity:0.6}
    .event-img .date-badge{position:absolute;top:0.75rem;left:0.75rem;background:#fff;border-radius:var(--radius-md);padding:0.5rem 0.75rem;text-align:center;box-shadow:var(--shadow-sm);min-width:55px}
    .date-badge .day{font-size:1.25rem;font-weight:800;color:var(--forest-green);line-height:1}
    .date-badge .month{font-size:0.65rem;font-weight:700;color:var(--slate-gray);text-transform:uppercase;letter-spacing:0.05em}
    .event-type-tag{position:absolute;top:0.75rem;right:0.75rem;background:var(--gradient-sunset);color:#fff;padding:0.3rem 0.7rem;border-radius:var(--radius-full);font-size:0.7rem;font-weight:700;text-transform:uppercase}
    .event-body{padding:1rem;display:flex;flex-direction:column;flex:1}
    .event-title{font-size:1.1rem;font-weight:700;color:var(--forest-green);margin:0 0 0.5rem;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .event-desc{font-size:0.85rem;color:var(--slate-gray);line-height:1.55;flex:1;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:0.75rem}
    .event-details{display:flex;flex-direction:column;gap:0.4rem;margin-bottom:0.75rem;font-size:0.8rem;color:var(--slate-gray)}
    .event-details span{display:flex;align-items:center;gap:0.4rem}
    .event-details i{color:var(--sage-green);width:16px;text-align:center}
    .event-footer{display:flex;justify-content:space-between;align-items:center;padding-top:0.75rem;border-top:1px solid var(--rock-gray)}
    .event-status{font-size:0.75rem;font-weight:600;padding:0.3rem 0.6rem;border-radius:var(--radius-full)}
    .status-upcoming{background:var(--leaf-green);color:var(--forest-green)}
    .status-ongoing{background:#dbeafe;color:#1e40af}
    .status-past{background:var(--pebble-gray);color:var(--slate-gray)}
    .view-btn{background:var(--gradient-nature);color:#fff;padding:0.5rem 1rem;border-radius:var(--radius-md);text-decoration:none;font-size:0.8rem;font-weight:600;transition:var(--transition);display:inline-flex;align-items:center;gap:0.3rem}
    .view-btn:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(45,134,89,0.3)}
    
    /* Empty State */
    .empty-state{text-align:center;padding:4rem 2rem;background:#fff;border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);grid-column:1/-1}
    .empty-state i{font-size:4rem;color:var(--rock-gray);margin-bottom:1rem}
    .empty-state h3{color:var(--forest-green);margin:0 0 0.5rem}
    .empty-state p{color:var(--slate-gray);margin:0}
    
    /* Loading */
    .loading{text-align:center;padding:3rem;grid-column:1/-1}
    .loading i{font-size:2rem;color:var(--sage-green)}
    

    
    /* Responsive */
    @media(max-width:900px){
      .page-hero{padding:2rem 1rem 1.5rem}
      .page-hero h1{font-size:1.65rem}
      .filter-bar{margin:-1rem 1rem 1.25rem;padding:0.85rem 1rem}
      .container{padding:1rem}
      .events-grid{grid-template-columns:repeat(auto-fill,minmax(280px,1fr))}
    }
    @media(max-width:640px){
      .page-hero h1{font-size:1.4rem}
      .page-hero p{font-size:0.9rem}
      .filter-bar{flex-direction:column;margin:-1rem 0.75rem 1rem}
      .search-box{width:100%}
      .filter-select,.clear-btn{width:100%}
      .events-grid{grid-template-columns:1fr}
      .event-img{height:180px}
      .results-info{flex-direction:column;align-items:flex-start}
    }
    @media(max-width:400px){
      .container{padding:0.75rem}
      .event-card{border-radius:var(--radius-md)}
      .float-back{width:42px;height:42px;left:0.75rem;bottom:0.75rem}
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="logo">
        <img src="/uploads/logo.jpg" alt="HeritageLink"> HeritageLink
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
        <i class="fas fa-bars"></i>
      </button>
      <div class="nav-overlay" id="navOverlay"></div>
      <div class="nav-links" id="navLinks">
        <button class="nav-close" id="navClose" aria-label="Close menu">
          <i class="fas fa-times"></i>
        </button>
        <a href="/" class="nav-link"><i class="fas fa-home"></i> <span>Home</span></a>
        <a href="/destinations" class="nav-link"><i class="fas fa-map-marked-alt"></i> <span>Discover Sites</span></a>
        <a href="/events" class="nav-link" style="background:rgba(255,255,255,0.15);color:#fff"><i class="fas fa-calendar-alt"></i> <span>Events</span></a>
        <a href="/heritage-gallery" class="nav-link"><i class="fas fa-landmark"></i> <span>Heritage Gallery</span></a>
        <a href="/map" class="nav-link"><i class="fas fa-map"></i> <span>Map</span></a>
        <a href="/showcase" class="nav-link"><i class="fas fa-palette"></i> <span>Artisans</span></a>
        <a href="/feedback" class="nav-link"><i class="fas fa-comment-dots"></i> <span>Feedback</span></a>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard" class="btn btn-primary">Dashboard</a>
        <% } else { %>
          <a href="/login" class="btn btn-secondary">Login</a>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- Page Hero -->
  <section class="page-hero">
    <h1><i class="fas fa-calendar-star"></i> Cultural Events</h1>
    <p>Join festivals, workshops & community celebrations in Gloria, Oriental Mindoro</p>
  </section>

  <!-- Main Content -->
  <div class="container">
    <!-- Filter Bar -->
    <div class="filter-bar">
      <div class="search-box">
        <i class="fas fa-search"></i>
        <input type="text" id="searchInput" class="search-input" placeholder="Search events, organizers...">
      </div>
      <select id="whenFilter" class="filter-select">
        <option value="all">All Events</option>
        <option value="upcoming">Upcoming</option>
        <option value="past">Past Events</option>
      </select>
      <select id="typeFilter" class="filter-select">
        <option value="">All Types</option>
        <option value="festival">Festival</option>
        <option value="workshop">Workshop</option>
        <option value="exhibit">Exhibit</option>
        <option value="cultural">Cultural</option>
        <option value="community">Community</option>
      </select>
      <button id="clearBtn" class="clear-btn"><i class="fas fa-times"></i> Clear</button>
    </div>

    <!-- Results Info -->
    <div class="results-info">
      <div class="results-count" id="resultsCount">Loading events...</div>
    </div>

    <!-- Events Grid -->
    <div id="eventsGrid" class="events-grid">
      <div class="loading"><i class="fas fa-spinner fa-spin"></i></div>
    </div>
  </div>



  <% if (typeof initialEvents !== 'undefined') { %>
  <script>window._initialEvents = <%- JSON.stringify(initialEvents || []) %>;</script>
  <% } %>

  <script>
    // Mobile nav toggle
    (function(){
      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navLinks');
      const overlay = document.getElementById('navOverlay');
      const close = document.getElementById('navClose');
      
      function openMenu() {
        links.classList.add('active');
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
      
      function closeMenu() {
        links.classList.remove('active');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      }
      
      if(toggle) toggle.addEventListener('click', openMenu);
      if(close) close.addEventListener('click', closeMenu);
      if(overlay) overlay.addEventListener('click', closeMenu);
    })();



    // Escape HTML
    function escapeHtml(str) {
      if (!str && str !== 0) return '';
      return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // Format date
    function formatDate(dateStr) {
      if (!dateStr) return { day: '?', month: 'TBD', full: 'Date TBD' };
      const d = new Date(dateStr);
      return {
        day: d.getDate(),
        month: d.toLocaleString('en-US', { month: 'short' }),
        full: d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' })
      };
    }

    // Get event status
    function getEventStatus(dateStr) {
      if (!dateStr) return { label: 'TBD', class: 'status-upcoming' };
      const eventDate = new Date(dateStr);
      const now = new Date();
      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const eventDay = new Date(eventDate.getFullYear(), eventDate.getMonth(), eventDate.getDate());
      
      if (eventDay.getTime() === today.getTime()) return { label: 'Today', class: 'status-ongoing' };
      if (eventDay > today) return { label: 'Upcoming', class: 'status-upcoming' };
      return { label: 'Past', class: 'status-past' };
    }

    // Load events
    async function loadEvents() {
      try {
        let events = [];
        if (window._initialEvents && Array.isArray(window._initialEvents) && window._initialEvents.length) {
          events = window._initialEvents;
        } else {
          const res = await fetch('/api/events');
          let payload = await res.json().catch(() => []);
          if (Array.isArray(payload)) events = payload;
          else if (payload && Array.isArray(payload.events)) events = payload.events;
          else if (payload && Array.isArray(payload.data)) events = payload.data;
          else {
            const arr = Object.values(payload || {}).find(v => Array.isArray(v));
            if (arr) events = arr;
          }
        }

        const grid = document.getElementById('eventsGrid');
        const countEl = document.getElementById('resultsCount');

        if (!Array.isArray(events) || events.length === 0) {
          grid.innerHTML = `
            <div class="empty-state">
              <i class="fas fa-calendar-times"></i>
              <h3>No Events Yet</h3>
              <p>Check back soon for upcoming cultural events!</p>
            </div>`;
          countEl.innerHTML = '<strong>0</strong> events found';
          return;
        }

        window._events = events.map(ev => ({
          id: ev.id,
          title: ev.title || 'Untitled Event',
          description: ev.description || '',
          date: ev.event_date || ev.date || null,
          time: ev.event_time || ev.time || '',
          location: ev.location || ev.venue || '',
          venue: ev.venue || ev.location || '',
          organizer: ev.organizer || '',
          type: (ev.type || ev.category || ev.status || 'event').toString().toLowerCase(),
          is_active: ev.is_active !== undefined ? !!ev.is_active : true,
          image: ev.image_url || ev.image || null
        }));

        renderGrid(window._events);
        attachControls();
      } catch (err) {
        console.error('Error:', err);
        document.getElementById('eventsGrid').innerHTML = `
          <div class="empty-state">
            <i class="fas fa-exclamation-triangle"></i>
            <h3>Error Loading Events</h3>
            <p>Please try again later.</p>
          </div>`;
      }
    }

    function renderGrid(list) {
      const grid = document.getElementById('eventsGrid');
      const countEl = document.getElementById('resultsCount');
      
      countEl.innerHTML = `<strong>${list.length}</strong> event${list.length !== 1 ? 's' : ''} found`;

      if (!list || list.length === 0) {
        grid.innerHTML = `
          <div class="empty-state">
            <i class="fas fa-search"></i>
            <h3>No Results</h3>
            <p>Try adjusting your search or filters.</p>
          </div>`;
        return;
      }

      grid.innerHTML = list.map(ev => {
        const date = formatDate(ev.date);
        const status = getEventStatus(ev.date);
        const typeLabel = ev.type.charAt(0).toUpperCase() + ev.type.slice(1);
        
        return `
          <div class="event-card">
            <div class="event-img">
              ${ev.image ? `<img src="${escapeHtml(ev.image)}" alt="${escapeHtml(ev.title)}" loading="lazy">` : `<div class="no-img"><i class="fas fa-calendar-alt"></i><span>${date.full}</span></div>`}
              <div class="date-badge">
                <div class="day">${date.day}</div>
                <div class="month">${date.month}</div>
              </div>
              <span class="event-type-tag">${escapeHtml(typeLabel)}</span>
            </div>
            <div class="event-body">
              <h3 class="event-title">${escapeHtml(ev.title)}</h3>
              <p class="event-desc">${escapeHtml(ev.description.slice(0, 100))}${ev.description.length > 100 ? '...' : ''}</p>
              <div class="event-details">
                ${ev.time ? `<span><i class="fas fa-clock"></i> ${escapeHtml(ev.time)}</span>` : ''}
                ${ev.venue ? `<span><i class="fas fa-map-marker-alt"></i> ${escapeHtml(ev.venue)}</span>` : ''}
                ${ev.organizer ? `<span><i class="fas fa-user"></i> ${escapeHtml(ev.organizer)}</span>` : ''}
              </div>
              <div class="event-footer">
                <span class="event-status ${status.class}">${status.label}</span>
                <a href="/events/${ev.id}" class="view-btn">Details <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function attachControls() {
      const search = document.getElementById('searchInput');
      const when = document.getElementById('whenFilter');
      const type = document.getElementById('typeFilter');
      const clear = document.getElementById('clearBtn');

      function apply() {
        const q = (search.value || '').toLowerCase().trim();
        const w = when.value || 'all';
        const t = (type.value || '').toLowerCase();
        const now = new Date();

        const filtered = window._events.filter(ev => {
          if (t && ev.type.indexOf(t) === -1) return false;
          if (w === 'upcoming' && ev.date && new Date(ev.date) < now) return false;
          if (w === 'past' && ev.date && new Date(ev.date) >= now) return false;
          if (!q) return true;
          return (ev.title + ' ' + ev.description + ' ' + ev.location + ' ' + ev.organizer).toLowerCase().indexOf(q) !== -1;
        });
        renderGrid(filtered);
      }

      search.addEventListener('input', debounce(apply, 200));
      when.addEventListener('change', apply);
      type.addEventListener('change', apply);
      clear.addEventListener('click', () => { search.value = ''; when.value = 'all'; type.value = ''; apply(); });
    }

    function debounce(fn, wait) {
      let t;
      return function(...a) { clearTimeout(t); t = setTimeout(() => fn.apply(this, a), wait); };
    }

    loadEvents();
  </script>
</body>
</html>
