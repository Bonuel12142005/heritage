<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/heritagelink-unified.css">
    <style>
        /* Page Header */
        .page-header {
            background: linear-gradient(135deg, #1a5f3f 0%, #2d8659 50%, #3fa872 100%);
            color: white;
            padding: 3rem 2rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        .page-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #ff6b35, #f59e0b, #ff6b35);
        }
        
        .page-header-content {
            max-width: 900px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }
        
        .page-header h1 {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 0.75rem;
            color: white;
            font-family: 'Poppins', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
        }
        
        .page-header p {
            font-size: 1.125rem;
            opacity: 0.95;
            color: #d1fae5;
        }
        
        /* Container */
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
        }
        
        /* Filter Bar */
        .filter-bar {
            background: white;
            padding: 1.5rem;
            border-radius: 1rem;
            margin-bottom: 2rem;
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: center;
            box-shadow: 0 4px 15px rgba(26, 95, 63, 0.1);
            border: 2px solid #d1fae5;
        }
        
        .filter-bar input,
        .filter-bar select {
            padding: 0.75rem 1rem;
            border: 2px solid #e7e5e4;
            border-radius: 0.75rem;
            font-size: 0.9375rem;
            background: white;
            font-family: 'Inter', sans-serif;
            transition: all 0.3s ease;
        }
        
        .filter-bar input {
            flex: 1;
            min-width: 200px;
        }
        
        .filter-bar input:focus,
        .filter-bar select:focus {
            outline: none;
            border-color: #2d8659;
            box-shadow: 0 0 0 3px rgba(45, 134, 89, 0.1);
        }
        
        /* Artisan Grid */
        .artisan-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1.5rem;
        }
        
        .artisan-card {
            background: white;
            border-radius: 1.25rem;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(26, 95, 63, 0.1);
            border: 2px solid #d1fae5;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
        }
        
        .artisan-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 30px rgba(26, 95, 63, 0.18);
            border-color: #3fa872;
        }
        
        .artisan-banner {
            height: 100px;
            background: linear-gradient(135deg, #1a5f3f 0%, #2d8659 50%, #3fa872 100%);
            position: relative;
        }
        
        .artisan-avatar {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: white;
            position: absolute;
            bottom: -45px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: #1a5f3f;
            font-weight: 700;
            border: 4px solid white;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
            overflow: hidden;
        }
        
        .artisan-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .artisan-body {
            padding: 3.5rem 1.5rem 1.5rem;
            text-align: center;
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        
        .artisan-name {
            font-size: 1.25rem;
            font-weight: 700;
            color: #1a5f3f;
            margin-bottom: 0.5rem;
            font-family: 'Poppins', sans-serif;
        }
        
        .artisan-specialty {
            color: #ff6b35;
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
        }
        
        .artisan-location {
            color: #78716c;
            font-size: 0.85rem;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
        }
        
        .artisan-bio {
            color: #78716c;
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 1rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            flex: 1;
        }
        
        .artisan-stats {
            display: flex;
            justify-content: center;
            gap: 2rem;
            margin-bottom: 1rem;
            padding: 1rem;
            background: #f8faf9;
            border-radius: 0.75rem;
        }
        
        .stat {
            text-align: center;
        }
        
        .stat-value {
            font-size: 1.25rem;
            font-weight: 700;
            color: #1a5f3f;
            display: block;
        }
        
        .stat-label {
            font-size: 0.75rem;
            color: #78716c;
            font-weight: 500;
        }
        
        .artisan-actions {
            display: flex;
            gap: 0.75rem;
            justify-content: center;
        }
        
        .artisan-actions .btn {
            padding: 0.65rem 1.25rem;
            font-size: 0.875rem;
        }
        
        .btn-outline {
            background: transparent;
            color: #2d8659;
            border: 2px solid #2d8659;
        }
        
        .btn-outline:hover {
            background: #2d8659;
            color: white;
        }
        
        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            background: white;
            border-radius: 1.25rem;
            grid-column: 1 / -1;
            box-shadow: 0 4px 15px rgba(26, 95, 63, 0.1);
        }
        
        .empty-state i {
            font-size: 4rem;
            color: #d1fae5;
            margin-bottom: 1.5rem;
            display: block;
        }
        
        .empty-state h3 {
            font-size: 1.5rem;
            margin-bottom: 0.75rem;
            color: #1a5f3f;
        }
        
        .empty-state p {
            color: #78716c;
            font-size: 1rem;
        }
        
        /* Footer */
        .footer {
            background: linear-gradient(135deg, #1a5f3f 0%, #2d8659 100%);
            color: white;
            text-align: center;
            padding: 3rem 2rem;
            margin-top: 4rem;
            border-top: 4px solid #ff6b35;
        }
        
        .footer h3 {
            font-size: 1.5rem;
            margin-bottom: 0.75rem;
            color: white;
            font-family: 'Poppins', sans-serif;
        }
        
        .footer p {
            color: #d1fae5;
            margin-top: 0.5rem;
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .page-header {
                padding: 2rem 1rem;
            }
            
            .page-header h1 {
                font-size: 1.75rem;
            }
            
            .page-header p {
                font-size: 1rem;
            }
            
            .container {
                padding: 1.5rem 1rem;
            }
            
            .filter-bar {
                flex-direction: column;
                padding: 1rem;
            }
            
            .filter-bar input,
            .filter-bar select,
            .filter-bar .btn {
                width: 100%;
            }
            
            .artisan-grid {
                grid-template-columns: 1fr;
                gap: 1.25rem;
            }
            
            .artisan-card {
                max-width: 400px;
                margin: 0 auto;
                width: 100%;
            }
            
            .artisan-actions {
                flex-direction: column;
            }
            
            .artisan-actions .btn {
                width: 100%;
            }
        }
        
        @media (max-width: 480px) {
            .page-header h1 {
                font-size: 1.5rem;
                flex-direction: column;
                gap: 0.5rem;
            }
            
            .artisan-stats {
                gap: 1rem;
                padding: 0.75rem;
            }
            
            .stat-value {
                font-size: 1.1rem;
            }
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="logo">
                <img src="/uploads/logo.jpg" alt="HeritageLink"> HeritageLink
            </a>
            <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
                <i class="fas fa-bars"></i>
            </button>
            <div class="nav-overlay" id="navOverlay"></div>
            <div class="nav-links" id="navLinks">
                <button class="nav-close" id="navClose" aria-label="Close menu">
                    <i class="fas fa-times"></i>
                </button>
                <a href="/" class="nav-link"><i class="fas fa-home"></i> <span>Home</span></a>
                <a href="/destinations" class="nav-link"><i class="fas fa-map-marked-alt"></i> <span>Discover Sites</span></a>
                <a href="/events" class="nav-link"><i class="fas fa-calendar-alt"></i> <span>Events</span></a>
                <a href="/heritage-gallery" class="nav-link"><i class="fas fa-landmark"></i> <span>Heritage Gallery</span></a>
                <a href="/showcase" class="nav-link"><i class="fas fa-palette"></i> <span>Artisans</span></a>
                <a href="/showcase/products" class="nav-link"><i class="fas fa-shopping-bag"></i> <span>Products</span></a>
                <a href="/workshops" class="nav-link"><i class="fas fa-chalkboard-teacher"></i> <span>Workshops</span></a>
                <% if (user) { %>
                    <a href="/dashboard" class="btn btn-primary">Dashboard</a>
                <% } else { %>
                    <a href="/login" class="btn btn-secondary">Login</a>
                <% } %>
            </div>
        </div>
    </nav>

    <section class="page-header">
        <div class="page-header-content">
            <h1><i class="fas fa-users"></i> Local Artisans</h1>
            <p>Meet the skilled craftspeople preserving Gloria's cultural heritage</p>
        </div>
    </section>

    <div class="container">
        <form class="filter-bar" method="GET">
            <input type="text" name="search" placeholder="Search artisans by name or specialty..." value="<%= filters.search || '' %>">
            <select name="specialty">
                <option value="">All Specialties</option>
                <% specialties.forEach(s => { %>
                    <option value="<%= s %>" <%= filters.specialty === s ? 'selected' : '' %>><%= s %></option>
                <% }); %>
            </select>
            <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Search</button>
        </form>

        <div class="artisan-grid">
            <% if (artisans && artisans.length > 0) { %>
                <% artisans.forEach(artisan => { %>
                    <div class="artisan-card">
                        <div class="artisan-banner"></div>
                        <div class="artisan-avatar">
                            <% if (artisan.profile_photo) { %>
                                <img src="/<%= artisan.profile_photo %>" alt="<%= artisan.name %>">
                            <% } else { %>
                                <%= (artisan.name || 'A').charAt(0).toUpperCase() %>
                            <% } %>
                        </div>
                        <div class="artisan-body">
                            <h3 class="artisan-name"><%= artisan.name %></h3>
                            <div class="artisan-specialty">
                                <i class="fas fa-star"></i> <%= artisan.specialty || artisan.specialization || 'Craftsman' %>
                            </div>
                            <div class="artisan-location">
                                <i class="fas fa-map-marker-alt"></i> <%= artisan.location || 'Gloria, Oriental Mindoro' %>
                            </div>
                            <p class="artisan-bio"><%= artisan.bio || 'Skilled artisan dedicated to preserving traditional crafts and cultural heritage.' %></p>
                            <div class="artisan-stats">
                                <div class="stat">
                                    <span class="stat-value"><%= artisan.product_count || 0 %></span>
                                    <span class="stat-label">Products</span>
                                </div>
                                <div class="stat">
                                    <span class="stat-value"><%= artisan.experience_years || '10+' %></span>
                                    <span class="stat-label">Years</span>
                                </div>
                                <% if (artisan.rating) { %>
                                    <div class="stat">
                                        <span class="stat-value"><i class="fas fa-star" style="color:#f59e0b;font-size:0.9rem;"></i> <%= artisan.rating %></span>
                                        <span class="stat-label">Rating</span>
                                    </div>
                                <% } %>
                            </div>
                            <div class="artisan-actions">
                                <a href="/showcase/artisans/<%= artisan.id || artisan.user_id %>" class="btn btn-primary">
                                    <i class="fas fa-user"></i> View Profile
                                </a>
                                <a href="/showcase/products?artisan_id=<%= artisan.id || artisan.user_id %>" class="btn btn-outline">
                                    <i class="fas fa-shopping-bag"></i> Products
                                </a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-users"></i>
                    <h3>No artisans found</h3>
                    <p>Try adjusting your search criteria or check back later.</p>
                </div>
            <% } %>
        </div>
    </div>

    <footer class="footer">
        <div class="footer-content">
            <h3><img src="/uploads/logo.jpg" alt="HeritageLink" style="width: 30px; height: 30px; object-fit: contain; vertical-align: middle;"> HeritageLink</h3>
            <p>Preserving and Promoting Cultural Heritage in Gloria, Oriental Mindoro</p>
            <p style="margin-top: 1rem; opacity: 0.8;">&copy; 2024 HeritageLink. All rights reserved.</p>
        </div>
    </footer>

    <script>
    (function(){
        const toggle = document.getElementById('navToggle');
        const links = document.getElementById('navLinks');
        const overlay = document.getElementById('navOverlay');
        const close = document.getElementById('navClose');
        
        function openMenu() {
            links.classList.add('active');
            overlay.classList.add('active');
            document.body.style.overflow = 'hidden';
        }
        
        function closeMenu() {
            links.classList.remove('active');
            overlay.classList.remove('active');
            document.body.style.overflow = '';
        }
        
        if(toggle) toggle.addEventListener('click', openMenu);
        if(close) close.addEventListener('click', closeMenu);
        if(overlay) overlay.addEventListener('click', closeMenu);
    })();
    </script>
</body>
</html>
