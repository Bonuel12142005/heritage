<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/heritagelink-unified.css">
    <script src="/js/smooth-transitions.js" defer></script>
    <style>
        
        .hero {
            background-image: url('/love.webp');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            position: relative;
            color: white;
            padding: 5rem 2rem;
            text-align: center;
            overflow: hidden;
            min-height: 70vh;
            display: flex;
            align-items: center;
        }
        
        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(26, 95, 63, 0.15) 0%, rgba(45, 134, 89, 0.15) 50%, rgba(63, 168, 114, 0.15) 100%);
            z-index: 1;
        }
        
        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #ff6b35, #f59e0b, #ff6b35);
            z-index: 2;
        }
        
        .hero::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                radial-gradient(circle at 30% 70%, rgba(255, 107, 53, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 70% 30%, rgba(26, 95, 63, 0.1) 0%, transparent 50%),
                linear-gradient(45deg, transparent 30%, rgba(255, 255, 255, 0.02) 50%, transparent 70%);
            z-index: 1;
        }
        
        .hero-content {
            max-width: 900px;
            margin: 0 auto;
            position: relative;
            z-index: 2;
        }
        
        .hero-title {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 1.25rem;
            line-height: 1.1;
            font-family: 'Poppins', sans-serif;
            text-shadow: 
                3px 3px 6px rgba(0, 0, 0, 0.9),
                2px 2px 4px rgba(0, 0, 0, 0.95),
                1px 1px 2px rgba(0, 0, 0, 1),
                0 0 15px rgba(0, 0, 0, 0.8);
            color: #ffffff;
        }
        
        .hero-subtitle {
            font-size: 1.5rem;
            margin-bottom: 2.5rem;
            opacity: 0.95;
            color: #f0fdf4;
            font-weight: 400;
            text-shadow: 
                3px 3px 6px rgba(0, 0, 0, 0.85),
                2px 2px 4px rgba(0, 0, 0, 0.9),
                1px 1px 2px rgba(0, 0, 0, 0.95),
                0 0 12px rgba(0, 0, 0, 0.7);
        }
        
        .hero-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }
        
        .hero-buttons .btn {
            padding: 1rem 2rem;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 12px;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(10px);
            border: 2px solid transparent;
        }
        
        .hero-buttons .btn-primary {
            background: linear-gradient(135deg, #ff6b35, #f59e0b);
            color: white;
        }
        
        .hero-buttons .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(255, 107, 53, 0.4);
            background: linear-gradient(135deg, #f59e0b, #ff6b35);
        }
        
        .hero-buttons .btn-secondary {
            background: rgba(255, 255, 255, 0.15);
            color: white;
            border: 2px solid rgba(255, 255, 255, 0.3);
        }
        
        .hero-buttons .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.25);
            border-color: rgba(255, 255, 255, 0.5);
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(255, 255, 255, 0.2);
        }
        
        .features {
            max-width: 1400px;
            margin: 0 auto;
            padding: 4rem 2rem;
        }
        
        .section-title {
            text-align: center;
            font-size: 2.75rem;
            font-weight: 800;
            margin-bottom: 3.5rem;
            background: linear-gradient(135deg, #1a5f3f, #2d8659);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-family: 'Poppins', sans-serif;
        }
        
        .quick-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }
        
        .action-card {
            background: white;
            padding: 2.5rem;
            border-radius: 1.25rem;
            box-shadow: 0 4px 15px rgba(26, 95, 63, 0.12);
            text-align: center;
            border-left: 5px solid #2d8659;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }
        
        .action-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(45, 134, 89, 0.08) 0%, transparent 70%);
            border-radius: 50%;
        }
        
        .action-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 30px rgba(26, 95, 63, 0.18);
            border-left-color: #ff6b35;
        }
        
        .action-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 1.5rem;
            background: linear-gradient(135deg, #2d8659, #3fa872);
            border-radius: 1.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: white;
            position: relative;
            z-index: 1;
        }
        
        .action-card:hover .action-icon {
            background: linear-gradient(135deg, #ff6b35, #f59e0b);
        }
        
        .action-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1a5f3f;
            margin-bottom: 0.75rem;
            font-family: 'Poppins', sans-serif;
        }
        
        .action-description {
            color: #78716c;
            font-weight: 500;
            font-size: 1rem;
            line-height: 1.6;
        }
        
        .footer {
            background: linear-gradient(135deg, #1a5f3f 0%, #2d8659 100%);
            color: white;
            text-align: center;
            padding: 3rem 2rem;
            margin-top: 4rem;
            border-top: 4px solid #ff6b35;
        }
        
        .footer h3 {
            font-size: 1.5rem;
            margin-bottom: 0.75rem;
            color: white;
            font-family: 'Poppins', sans-serif;
        }
        
        .footer p {
            color: #d1fae5;
            margin-top: 0.5rem;
        }
        
        @media (max-width: 768px) {
            .hero {
                padding: 3rem 1rem;
                min-height: 60vh;
            }
            
            .hero-title {
                font-size: 2.25rem;
            }
            
            .hero-subtitle {
                font-size: 1.125rem;
            }
            
            .hero-buttons {
                flex-direction: column;
                align-items: center;
            }
            
            .hero-buttons .btn {
                width: 100%;
                max-width: 280px;
                padding: 0.875rem 1.5rem;
                font-size: 1rem;
            }
            
            .quick-actions {
                grid-template-columns: 1fr;
            }
            
            .features {
                padding: 3rem 1rem;
            }
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="logo">
                <img src="/uploads/logo.jpg" alt="HeritageLink"> HeritageLink
            </a>
            <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
                <i class="fas fa-bars"></i>
            </button>
            <div class="nav-overlay" id="navOverlay"></div>
            <div class="nav-links" id="navLinks">
                <button class="nav-close" id="navClose" aria-label="Close menu">
                    <i class="fas fa-times"></i>
                </button>
                <a href="/" class="nav-link"><i class="fas fa-home"></i> <span>Home</span></a>
                <a href="/destinations" class="nav-link"><i class="fas fa-map-marked-alt"></i> <span>Discover Sites</span></a>
                <a href="/events" class="nav-link"><i class="fas fa-calendar-alt"></i> <span>Events</span></a>
                <a href="/heritage-gallery" class="nav-link"><i class="fas fa-landmark"></i> <span>Heritage Gallery</span></a>
                <a href="/map" class="nav-link"><i class="fas fa-map"></i> <span>Map</span></a>
                <a href="/showcase" class="nav-link"><i class="fas fa-palette"></i> <span>Artisans</span></a>
                <a href="/workshops" class="nav-link"><i class="fas fa-chalkboard-teacher"></i> <span>Workshops</span></a>
                <a href="/feedback" class="nav-link"><i class="fas fa-comment-dots"></i> <span>Feedback</span></a>
                <% if (user) { %>
                    <a href="/dashboard" class="btn btn-primary">Dashboard</a>
                <% } else { %>
                    <a href="/login" class="btn btn-secondary">Login</a>
                <% } %>
            </div>
        </div>
    </nav>
    <script>
    (function(){
        const toggle = document.getElementById('navToggle');
        const links = document.getElementById('navLinks');
        const overlay = document.getElementById('navOverlay');
        const close = document.getElementById('navClose');
        
        function openMenu() {
            links.classList.add('active');
            overlay.classList.add('active');
            document.body.style.overflow = 'hidden';
        }
        
        function closeMenu() {
            links.classList.remove('active');
            overlay.classList.remove('active');
            document.body.style.overflow = '';
        }
        
        if(toggle) toggle.addEventListener('click', openMenu);
        if(close) close.addEventListener('click', closeMenu);
        if(overlay) overlay.addEventListener('click', closeMenu);
    })();
    </script>

    <section class="hero">
        <div class="hero-content">
            <h1 class="hero-title">Welcome to HeritageLink</h1>
            <p class="hero-subtitle">Discover Cultural Tourism in Gloria, Oriental Mindoro</p>
            <div class="hero-buttons">
                <% if (!user) { %>
                    <a href="/register" class="btn btn-primary">Get Started</a>
                    <a href="/login" class="btn btn-secondary">Login</a>
                <% } else { %>
                    <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
                <% } %>
            </div>
        </div>
    </section>

    <div class="features">
        <h2 class="section-title">Plan Your Cultural Journey</h2>
        <div class="quick-actions">
            <a href="/destinations" class="action-card">
                <div class="action-icon">
                    <i class="fas fa-map-marked-alt"></i>
                </div>
                <div class="action-title">Discover Sites</div>
                <div class="action-description">Explore heritage sites, natural wonders, and cultural landmarks on interactive maps</div>
            </a>
            <a href="/events" class="action-card">
                <div class="action-icon">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <div class="action-title">Events</div>
                <div class="action-description">Join cultural festivals, workshops, and community celebrations</div>
            </a>
            <a href="/artisans" class="action-card">
                <div class="action-icon">
                    <i class="fas fa-palette"></i>
                </div>
                <div class="action-title">Meet Artisans</div>
                <div class="action-description">Connect with local craftspeople and discover traditional textiles and art</div>
            </a>
            <a href="/workshops" class="action-card">
                <div class="action-icon">
                    <i class="fas fa-chalkboard-teacher"></i>
                </div>
                <div class="action-title">Workshops</div>
                <div class="action-description">Learn traditional crafts from local artisans in hands-on workshop sessions</div>
            </a>
        </div>
    </div>

    <footer class="footer">
        <div class="footer-content">
            <h3><img src="/uploads/logo.jpg" alt="HeritageLink" style="width: 30px; height: 30px; object-fit: contain; vertical-align: middle;"> HeritageLink</h3>
            <p>Preserving and Promoting Cultural Heritage in Gloria, Oriental Mindoro</p>
            <p style="margin-top: 1rem; opacity: 0.8;">&copy; 2024 HeritageLink. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>
