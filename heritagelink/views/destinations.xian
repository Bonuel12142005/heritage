<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - HeritageLink</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/heritagelink-unified.css">
  <style>
    html,body{overflow-x:hidden;max-width:100vw}
    
    /* Page Hero */
    .page-hero{background:var(--gradient-nature);padding:2.5rem 1.5rem 2rem;text-align:center;position:relative}
    .page-hero::after{content:'';position:absolute;bottom:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#ff6b35,#f59e0b,#ff6b35)}
    .page-hero h1{color:#fff;font-size:2rem;font-weight:800;margin:0 0 0.5rem;font-family:'Poppins',sans-serif}
    .page-hero p{color:var(--leaf-green);font-size:1rem;margin:0}
    
    /* Container */
    .container{max-width:1300px;margin:0 auto;padding:1.5rem}
    
    /* Search & Filter Bar */
    .filter-bar{background:#fff;border-radius:var(--radius-lg);padding:1rem 1.25rem;box-shadow:var(--shadow-md);margin:-1.5rem auto 1.5rem;max-width:900px;position:relative;z-index:10;display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center}
    .search-box{flex:1;min-width:200px;position:relative}
    .search-box i{position:absolute;left:1rem;top:50%;transform:translateY(-50%);color:var(--slate-gray)}
    .search-input{width:100%;padding:0.7rem 1rem 0.7rem 2.5rem;border:2px solid var(--rock-gray);border-radius:var(--radius-md);font-size:0.9rem;transition:var(--transition)}
    .search-input:focus{outline:none;border-color:var(--sage-green);box-shadow:0 0 0 3px rgba(45,134,89,0.1)}
    .filter-select{padding:0.7rem 1rem;border:2px solid var(--rock-gray);border-radius:var(--radius-md);font-size:0.9rem;background:#fff;min-width:140px;cursor:pointer;transition:var(--transition)}
    .filter-select:focus{outline:none;border-color:var(--sage-green)}
    .clear-btn{padding:0.7rem 1.25rem;border:2px solid var(--rock-gray);border-radius:var(--radius-md);background:var(--pebble-gray);font-size:0.9rem;font-weight:600;cursor:pointer;transition:var(--transition);color:var(--slate-gray)}
    .clear-btn:hover{background:var(--rock-gray);color:var(--charcoal)}
    
    /* Results Info */
    .results-info{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:0.5rem}
    .results-count{font-size:0.9rem;color:var(--slate-gray)}
    .results-count strong{color:var(--forest-green)}
    .view-toggle{display:flex;gap:0.25rem}
    .view-btn{padding:0.5rem;border:1px solid var(--rock-gray);background:#fff;border-radius:var(--radius-sm);cursor:pointer;color:var(--slate-gray);transition:var(--transition)}
    .view-btn.active,.view-btn:hover{background:var(--sage-green);color:#fff;border-color:var(--sage-green)}
    
    /* Destinations Grid */
    .dest-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.25rem}
    
    /* Destination Card */
    .dest-card{background:#fff;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm);border:1px solid var(--rock-gray);transition:var(--transition);display:flex;flex-direction:column}
    .dest-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg);border-color:var(--sage-green)}
    .dest-img{height:160px;background:linear-gradient(135deg,var(--leaf-green),var(--pebble-gray));position:relative;overflow:hidden}
    .dest-img img{width:100%;height:100%;object-fit:cover;transition:transform 0.4s ease}
    .dest-card:hover .dest-img img{transform:scale(1.08)}
    .dest-img .no-img{display:flex;align-items:center;justify-content:center;height:100%;color:var(--slate-gray);font-weight:600}
    .dest-img .no-img i{font-size:2.5rem;opacity:0.5}
    .featured-tag{position:absolute;top:0.75rem;right:0.75rem;background:var(--gradient-sunset);color:#fff;padding:0.3rem 0.7rem;border-radius:var(--radius-full);font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.03em}
    .dest-body{padding:1rem;display:flex;flex-direction:column;flex:1}
    .dest-title{font-size:1.05rem;font-weight:700;color:var(--forest-green);margin:0 0 0.4rem;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .dest-desc{font-size:0.85rem;color:var(--slate-gray);line-height:1.5;flex:1;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:0.75rem}
    .dest-meta{display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.75rem}
    .meta-tag{background:var(--leaf-green);color:var(--forest-green);padding:0.25rem 0.6rem;border-radius:var(--radius-full);font-size:0.75rem;font-weight:600;display:inline-flex;align-items:center;gap:0.25rem}
    .meta-tag i{font-size:0.7rem}
    .dest-footer{display:flex;justify-content:space-between;align-items:center;padding-top:0.75rem;border-top:1px solid var(--rock-gray)}
    .dest-location{font-size:0.8rem;color:var(--slate-gray);display:flex;align-items:center;gap:0.3rem;max-width:60%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .view-btn-card{background:var(--gradient-nature);color:#fff;padding:0.5rem 1rem;border-radius:var(--radius-md);text-decoration:none;font-size:0.8rem;font-weight:600;transition:var(--transition);display:inline-flex;align-items:center;gap:0.3rem}
    .view-btn-card:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(45,134,89,0.3)}
    
    /* Empty State */
    .empty-state{text-align:center;padding:4rem 2rem;background:#fff;border-radius:var(--radius-lg);box-shadow:var(--shadow-sm)}
    .empty-state i{font-size:4rem;color:var(--rock-gray);margin-bottom:1rem}
    .empty-state h3{color:var(--forest-green);margin:0 0 0.5rem}
    .empty-state p{color:var(--slate-gray);margin:0}
    
    /* Loading */
    .loading{text-align:center;padding:3rem}
    .loading i{font-size:2rem;color:var(--sage-green)}
    

    
    /* Responsive */
    @media(max-width:900px){
      .page-hero{padding:2rem 1rem 1.5rem}
      .page-hero h1{font-size:1.65rem}
      .filter-bar{margin:-1rem 1rem 1.25rem;padding:0.85rem 1rem}
      .container{padding:1rem}
    }
    @media(max-width:640px){
      .page-hero h1{font-size:1.4rem}
      .page-hero p{font-size:0.9rem}
      .filter-bar{flex-direction:column;margin:-1rem 0.75rem 1rem}
      .search-box{width:100%}
      .filter-select,.clear-btn{width:100%}
      .dest-grid{grid-template-columns:1fr}
      .dest-img{height:180px}
      .results-info{flex-direction:column;align-items:flex-start}
    }
    @media(max-width:400px){
      .container{padding:0.75rem}
      .dest-card{border-radius:var(--radius-md)}
      .float-back{width:42px;height:42px;left:0.75rem;bottom:0.75rem}
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="logo">
        <img src="/uploads/logo.jpg" alt="HeritageLink"> HeritageLink
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
        <i class="fas fa-bars"></i>
      </button>
      <div class="nav-overlay" id="navOverlay"></div>
      <div class="nav-links" id="navLinks">
        <button class="nav-close" id="navClose" aria-label="Close menu">
          <i class="fas fa-times"></i>
        </button>
        <a href="/" class="nav-link"><i class="fas fa-home"></i> <span>Home</span></a>
        <a href="/destinations" class="nav-link" style="background:rgba(255,255,255,0.15);color:#fff"><i class="fas fa-map-marked-alt"></i> <span>Discover Sites</span></a>
        <a href="/events" class="nav-link"><i class="fas fa-calendar-alt"></i> <span>Events</span></a>
        <a href="/heritage-gallery" class="nav-link"><i class="fas fa-landmark"></i> <span>Heritage Gallery</span></a>
        <a href="/map" class="nav-link"><i class="fas fa-map"></i> <span>Map</span></a>
        <a href="/showcase" class="nav-link"><i class="fas fa-palette"></i> <span>Artisans</span></a>
        <a href="/feedback" class="nav-link"><i class="fas fa-comment-dots"></i> <span>Feedback</span></a>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard" class="btn btn-primary">Dashboard</a>
        <% } else { %>
          <a href="/login" class="btn btn-secondary">Login</a>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- Page Hero -->
  <section class="page-hero">
    <h1><i class="fas fa-compass"></i> Discover Destinations</h1>
    <p>Explore heritage sites, natural wonders & cultural landmarks in Gloria, Oriental Mindoro</p>
  </section>

  <!-- Filter Bar -->
  <div class="container">
    <div class="filter-bar">
      <div class="search-box">
        <i class="fas fa-search"></i>
        <input type="text" id="searchInput" class="search-input" placeholder="Search destinations...">
      </div>
      <select id="typeFilter" class="filter-select">
        <option value="">All Types</option>
        <option value="heritage">Heritage Site</option>
        <option value="museum">Museum</option>
        <option value="natural">Natural</option>
        <option value="cultural">Cultural</option>
        <option value="festival">Festival</option>
      </select>
      <button id="clearBtn" class="clear-btn"><i class="fas fa-times"></i> Clear</button>
    </div>

    <!-- Results Info -->
    <div class="results-info">
      <div class="results-count" id="resultsCount">Loading destinations...</div>
    </div>

    <!-- Destinations Grid -->
    <div id="destGrid" class="dest-grid">
      <div class="loading"><i class="fas fa-spinner fa-spin"></i></div>
    </div>
  </div>



  <script>
    // Mobile nav toggle
    (function(){
      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navLinks');
      const overlay = document.getElementById('navOverlay');
      const close = document.getElementById('navClose');
      
      function openMenu() {
        links.classList.add('active');
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
      
      function closeMenu() {
        links.classList.remove('active');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      }
      
      if(toggle) toggle.addEventListener('click', openMenu);
      if(close) close.addEventListener('click', closeMenu);
      if(overlay) overlay.addEventListener('click', closeMenu);
    })();



    // Escape HTML
    function escapeHtml(str) {
      if (!str && str !== 0) return '';
      return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // Load destinations
    async function loadDestinations() {
      try {
        const res = await fetch('/api/destinations');
        const destinations = await res.json();
        const grid = document.getElementById('destGrid');
        const countEl = document.getElementById('resultsCount');

        if (!Array.isArray(destinations) || destinations.length === 0) {
          grid.innerHTML = `
            <div class="empty-state" style="grid-column:1/-1">
              <i class="fas fa-map-marked-alt"></i>
              <h3>No Destinations Yet</h3>
              <p>Check back soon for exciting places to explore!</p>
            </div>`;
          countEl.innerHTML = '<strong>0</strong> destinations found';
          return;
        }

        window._destinations = destinations.map(d => ({
          id: d.id,
          name: d.name || 'Untitled',
          description: d.description || '',
          type: (d.site_type || d.category || '').toLowerCase(),
          address: d.address || d.location || '',
          fee: (d.entrance_fee && Number(d.entrance_fee) > 0) ? '₱' + Number(d.entrance_fee).toFixed(2) : 'Free',
          featured: !!d.featured,
          image: d.image_url || d.photo || '',
          rating: d.average_rating || null
        }));

        renderGrid(window._destinations);
        attachControls();
      } catch (err) {
        console.error('Error:', err);
        document.getElementById('destGrid').innerHTML = `
          <div class="empty-state" style="grid-column:1/-1">
            <i class="fas fa-exclamation-triangle"></i>
            <h3>Error Loading</h3>
            <p>Please try again later.</p>
          </div>`;
      }
    }

    function renderGrid(list) {
      const grid = document.getElementById('destGrid');
      const countEl = document.getElementById('resultsCount');
      
      countEl.innerHTML = `<strong>${list.length}</strong> destination${list.length !== 1 ? 's' : ''} found`;

      if (!list || list.length === 0) {
        grid.innerHTML = `
          <div class="empty-state" style="grid-column:1/-1">
            <i class="fas fa-search"></i>
            <h3>No Results</h3>
            <p>Try adjusting your search or filters.</p>
          </div>`;
        return;
      }

      grid.innerHTML = list.map(d => `
        <div class="dest-card">
          <div class="dest-img">
            ${d.image ? `<img src="${escapeHtml(d.image)}" alt="${escapeHtml(d.name)}" loading="lazy">` : '<div class="no-img"><i class="fas fa-image"></i></div>'}
            ${d.featured ? '<span class="featured-tag"><i class="fas fa-star"></i> Featured</span>' : ''}
          </div>
          <div class="dest-body">
            <h3 class="dest-title">${escapeHtml(d.name)}</h3>
            <p class="dest-desc">${escapeHtml(d.description.slice(0, 120))}${d.description.length > 120 ? '...' : ''}</p>
            <div class="dest-meta">
              <span class="meta-tag"><i class="fas fa-tag"></i> ${escapeHtml(d.type || 'Site')}</span>
              <span class="meta-tag"><i class="fas fa-ticket-alt"></i> ${escapeHtml(d.fee)}</span>
              ${d.rating ? `<span class="meta-tag"><i class="fas fa-star"></i> ${d.rating}</span>` : ''}
            </div>
            <div class="dest-footer">
              <span class="dest-location"><i class="fas fa-map-marker-alt"></i> ${escapeHtml(d.address || 'Gloria, Oriental Mindoro')}</span>
              <a href="/destinations/${d.id}" class="view-btn-card">View <i class="fas fa-arrow-right"></i></a>
            </div>
          </div>
        </div>
      `).join('');
    }

    function attachControls() {
      const search = document.getElementById('searchInput');
      const filter = document.getElementById('typeFilter');
      const clear = document.getElementById('clearBtn');

      function apply() {
        const q = (search.value || '').toLowerCase().trim();
        const t = (filter.value || '').toLowerCase().trim();
        const filtered = window._destinations.filter(d => {
          if (t && d.type.indexOf(t) === -1) return false;
          if (!q) return true;
          return (d.name + ' ' + d.description + ' ' + d.address).toLowerCase().indexOf(q) !== -1;
        });
        renderGrid(filtered);
      }

      search.addEventListener('input', debounce(apply, 200));
      filter.addEventListener('change', apply);
      clear.addEventListener('click', () => { search.value = ''; filter.value = ''; apply(); });
    }

    function debounce(fn, wait) {
      let t;
      return function(...a) { clearTimeout(t); t = setTimeout(() => fn.apply(this, a), wait); };
    }

    loadDestinations();
  </script>
</body>
</html>
