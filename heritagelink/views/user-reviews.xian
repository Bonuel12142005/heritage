<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <title><%= title %></title>
    <%- include('partials/user-dashboard-styles.xian') %>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-logo">
            <h2>
                <img src="/uploads/logo.jpg" alt="HeritageLink">
                HeritageLink
                <span class="badge badge-info">Explorer</span>
            </h2>
        </div>
        <ul class="sidebar-menu">
            <li class="menu-item">
                <a href="/user/dashboard" class="menu-link">
                    <i class="fas fa-th-large"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/destinations" class="menu-link">
                    <i class="fas fa-map-marked-alt"></i>
                    <span>Discover Sites</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/events" class="menu-link">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Events</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/artisans" class="menu-link">
                    <i class="fas fa-palette"></i>
                    <span>Artisans</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/workshops" class="menu-link">
                    <i class="fas fa-chalkboard-teacher"></i>
                    <span>Workshops</span>
                </a>
            </li>
            <div class="menu-section">My Activity</div>
            <li class="menu-item">
                <a href="/user/reviews" class="menu-link active">
                    <i class="fas fa-star"></i>
                    <span>My Reviews</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/user/favorites" class="menu-link">
                    <i class="fas fa-heart"></i>
                    <span>Favorites</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/user/workshops" class="menu-link">
                    <i class="fas fa-chalkboard-teacher"></i>
                    <span>My Workshops</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/user/gallery" class="menu-link">
                    <i class="fas fa-images"></i>
                    <span>My Gallery</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/user/messages" class="menu-link">
                    <i class="fas fa-envelope"></i>
                    <span>Messages</span>
                </a>
            </li>
            <div class="menu-section">Account</div>
            <li class="menu-item">
                <a href="/user/profile" class="menu-link">
                    <i class="fas fa-user-circle"></i>
                    <span>My Profile</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/" class="menu-link">
                    <i class="fas fa-home"></i>
                    <span>Home</span>
                </a>
            </li>
            <li class="menu-item">
                <a href="/logout" class="menu-link">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </li>
        </ul>
    </aside>

    <main class="main-content">
        <div class="topbar">
            <div class="topbar-left">
                <h1><i class="fas fa-star"></i> My Reviews</h1>
                <p>Share your experiences and help others discover cultural treasures</p>
            </div>
        </div>

        <div class="dashboard-content">
            <% if (reviews.length === 0) { %>
                <div class="card text-center" style="padding: 3rem;">
                    <div style="font-size: 4rem; margin-bottom: 1rem;">⭐</div>
                    <h2 style="margin-bottom: 1rem;">No Reviews Yet</h2>
                    <p style="color: var(--slate-gray); margin-bottom: 2rem;">
                        Start exploring destinations and share your experiences!
                    </p>
                    <a href="/destinations" class="btn btn-primary">
                        <i class="fas fa-map-marked-alt"></i> Discover Sites
                    </a>
                </div>
            <% } else { %>
                <div style="display: grid; gap: 1.5rem;">
                    <% reviews.forEach(review => { %>
                        <div class="card">
                            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 1rem;">
                                <div>
                                    <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">
                                        <%= review.destination_name || 'Destination' %>
                                    </h3>
                                    <div style="color: var(--textile-gold); font-size: 1.125rem;">
                                        <% for(let i = 0; i < review.rating; i++) { %>
                                            <i class="fas fa-star"></i>
                                        <% } %>
                                        <% for(let i = review.rating; i < 5; i++) { %>
                                            <i class="far fa-star"></i>
                                        <% } %>
                                    </div>
                                </div>
                                <span class="badge badge-success">
                                    <%= review.status || 'Published' %>
                                </span>
                            </div>
                            <p style="color: var(--slate-gray); line-height: 1.6; margin-bottom: 1rem;">
                                <%= review.comment || review.review_text %>
                            </p>
                            <div style="font-size: 0.875rem; color: var(--slate-gray);">
                                <i class="fas fa-calendar"></i>
                                <%= new Date(review.created_at).toLocaleDateString() %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
